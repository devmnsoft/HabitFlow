{
  "name": "habitflow",
  "version": "2.4.2-IIS-Publisher-Pro",
  "description": "HabitFlow v2.4-PRD-IIS-Production-Stabilization - SaaS de hábitos com PRD, IIS, Firebase Hosting e dados controlados",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "vite --host 0.0.0.0 --port 5177",
    "build": "vite build && node scripts/postbuild-obfuscate.js && npm run security:dist",
    "preview": "vite preview --host 0.0.0.0 --port 5177",
    "security:scan": "node scripts/security-scan.js",
    "deploy": "npm run build && firebase deploy",
    "security:dist": "node scripts/security-dist-scan.js",
    "security:rules": "node scripts/validate-firestore-rules.js",
    "security:firebase": "node scripts/validate-firebase-config.js",
    "test": "node tests/security/run-security-tests.js",
    "verify:functions": "node scripts/verify-functions-shape.js",
    "publish:iis": "node scripts/publisher/publish-iis.js",
    "publish:iis:nozip": "node scripts/publisher/publish-iis.js --no-zip",
    "publish:iis:zip": "node scripts/publisher/publish-iis.js --zip",
    "publish:iis:check": "node scripts/publisher/publish-iis.js --check",
    "publish:iis:copy": "node scripts/publisher/publish-iis.js --copy-to-iis"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "latest",
    "vite": "latest",
    "terser": "latest",
    "javascript-obfuscator": "latest"
  }
}
