rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /systemAuditLogs/{document=**} {
      allow read, write: if false;
    }

    match /billingEvents/{document=**} {
      allow read, write: if false;
    }

    match /adminAuditLogs/{document=**} {
      allow read, write: if false;
    }

    match /appMetrics/{document=**} {
      allow read, write: if false;
    }

    match /supportTickets/{document=**} {
      allow read, write: if false;
    }

    match /systemSettings/{document=**} {
      // v1.9.1: leitura/escrita direta bloqueada; use getPublicSystemSettings/updateSystemSettings via Functions.
      allow read, write: if false;
    }
  }
}
