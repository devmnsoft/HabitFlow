  "BillingCommunicationJob": {
    "Enabled": false,
    "IntervalMinutes": 360
  },
  "ReminderDispatch": {
    "Enabled": true,
    "IntervalSeconds": 15,
    "BatchSize": 50,
    "LeaseSeconds": 60,
    "MaxAttempts": 5
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "AdminChatId": "",
