{
  "Security": {
    "Sessions": {
      "LifetimeDays": 30,
      "TouchIntervalMinutes": 5
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=123456;Pooling=true;Maximum Pool Size=50;Minimum Pool Size=0;Timeout=30;Command Timeout=60;Search Path=habitflow,public;Application Name=HabitFlow.web"
