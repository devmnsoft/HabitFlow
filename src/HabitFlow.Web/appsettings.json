    "ReplyToAddress": "comercial@mnsoft.com.br",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "comercial@mnsoft.com.br",
      "TimeoutSeconds": 30
    },
    "PasswordReset": {
      "TokenLifetimeMinutes": 30,
      "PublicBaseUrl": "http://localhost:5097",
      "AllowedBaseUrls": [ "http://localhost:5097" ],
      "MaxRequestsPerHourPerEmail": 3,
      "MaxRequestsPerHourPerIp": 10
    }
  },
  "Progress": {
    "DefaultTimeZone": "America/Sao_Paulo"
  },
  "BillingJobs": {
    "Enabled": false,
    "IntervalMinutes": 360,
    "GracePeriodDays": 3
