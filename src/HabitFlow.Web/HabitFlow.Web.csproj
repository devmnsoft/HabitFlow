<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>6.17.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HabitFlow.Application/HabitFlow.Application.csproj" />
    <ProjectReference Include="../HabitFlow.Infrastructure/HabitFlow.Infrastructure.csproj" />
    <ProjectReference Include="../HabitFlow.Domain/HabitFlow.Domain.csproj" />
    <ProjectReference Include="../HabitFlow.Shared/HabitFlow.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../database/migrations/*.sql" Link="database/migrations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
