@using HabitFlow.Application
@{ViewData["Title"]="Coach IA HabitFlow";var contact=(SupportContact)ViewBag.Contact;var enabled=(bool)ViewBag.AssistantEnabled;var max=(int)ViewBag.MaxInputChars;}
<section class="assistant-layout"><div class="assistant-main"><header class="assist-heading"><div><span class="assist-kicker">IA assistiva • contexto privado</span><h1>Coach IA HabitFlow</h1><p>Orientação curta sobre hábitos, metas, rotina, produtividade e uso do sistema.</p></div><span class="assist-secure">🔒 Só usa dados autorizados</span></header>
@if(!enabled){<div class="assistant-bubble bot assistant-disabled" role="status"><strong>O Coach IA está desabilitado.</strong><br />Você ainda pode consultar a Central de Ajuda ou falar com o suporte da MNSOFT.<a class="btn btn-primary d-block mt-3" href="/support/tickets/new">Falar com a MNSOFT</a></div>}
else {<div id="assistant-messages" class="assistant-messages" role="log" aria-live="polite" aria-busy="false"><div class="assistant-bubble bot">Olá! Posso analisar agregados autorizados da sua conta e explicar o HabitFlow. Não substituo orientação médica, psicológica, jurídica ou financeira.</div></div><form id="assistant-form" action="/assistant/ask" method="post" class="assistant-composer">@Html.AntiForgeryToken()<label for="assistant-input" class="visually-hidden">Sua pergunta</label><textarea id="assistant-input" name="message" maxlength="@max" required placeholder="Pergunte sobre sua rotina ou o HabitFlow"></textarea><button class="btn btn-primary" type="submit"><span class="assistant-send-label">Enviar</span><span class="assistant-loading" hidden>Respondendo…</span></button></form><div class="assistant-suggestions" aria-label="Sugestões rápidas"><button type="button" data-question="Como melhorar minha rotina?">Como melhorar minha rotina?</button><button type="button" data-question="Quais hábitos estão atrasados?">Hábitos atrasados</button><button type="button" data-question="Como configurar lembretes?">Configurar lembretes</button><button type="button" data-question="Meu plano permite mais hábitos?">Limites do meu plano</button><button type="button" data-question="Sugira uma meta para esta semana.">Meta da semana</button><button type="button" data-question="Como exportar meu progresso?">Exportar progresso</button></div><form method="post" action="/assistant/history/delete" class="mt-3">@Html.AntiForgeryToken()<button class="btn btn-link text-danger" type="submit">Limpar conversa</button></form><p class="small text-muted">As respostas são assistivas e podem conter imprecisões. Não envie dados sensíveis.</p>}
</div><aside class="assistant-aside"><h2>Atalhos seguros</h2><a href="/habits/create">Criar hábito</a><a href="/goals">Abrir metas</a><a href="/reminders">Configurar lembrete</a><a href="/reports">Acompanhar progresso</a><a href="/plans">Ver planos</a><a href="/support/tickets/new">Falar com suporte</a><small>Alterações sensíveis sempre usam fluxos próprios.</small></aside></section><partial name="~/Views/Shared/Partials/_SupportContact.cshtml" model="contact" />


@section Styles {
    <link rel="stylesheet" href="~/css/assistance-v6169.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/assistant-v6169.js" asp-append-version="true"></script>
}
