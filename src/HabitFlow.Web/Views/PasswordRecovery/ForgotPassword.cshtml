@model HabitFlow.Web.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Recuperar senha"; }
<section class="hf-auth-grid"><div class="hf-auth-card">
  <p class="hf-eyebrow">Recuperação de acesso</p><h1>Vamos ajudar você a voltar para o HabitFlow</h1>
  <p class="lead">Informe o e-mail usado na sua conta. Se encontrarmos um acesso associado, enviaremos um link para você criar uma nova senha.</p>
  <form method="post" action="/forgot-password">@Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Email" class="form-label">Seu e-mail</label><input asp-for="Email" class="form-control" autocomplete="email" maxlength="254" autofocus><span asp-validation-for="Email" class="text-danger"></span></div>
    <button class="btn btn-success btn-lg w-100" type="submit">Enviar link de recuperação</button>
  </form><p class="mt-3"><a href="/login">Voltar ao login</a></p>
</div></section>
