@model HabitFlow.Web.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Criar nova senha"; var invalid = ViewData["InvalidLink"] as string; }
<section class="hf-auth-grid"><div class="hf-auth-card"><p class="hf-eyebrow">Recuperação de acesso</p><h1>Crie uma nova senha</h1><p class="lead">Escolha uma senha segura e diferente da anterior.</p>
@if (invalid is not null) { <div class="alert alert-warning" role="alert">@invalid</div><a class="btn btn-success" href="/forgot-password">Solicitar nova recuperação</a> }
else { <form method="post" action="/reset-password">@Html.AntiForgeryToken()<input asp-for="Token" type="hidden"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="NewPassword" class="form-label">Nova senha</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus><span asp-validation-for="NewPassword" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Confirmar nova senha</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
<button class="btn btn-success btn-lg w-100" type="submit">Salvar nova senha</button></form> }</div></section>
