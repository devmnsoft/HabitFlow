@model IReadOnlyList<HabitFlow.Domain.Habit>
@using HabitFlow.Domain
@{ ViewData["Title"] = "Hábitos"; var habits = Model ?? Array.Empty<HabitFlow.Domain.Habit>(); }
<header class="hf-page-header"><div><p class="hf-eyebrow">Rotina intencional</p><h1>Meus hábitos</h1><p>Crie, filtre e acompanhe hábitos com recorrência, meta semanal e lembretes opcionais.</p></div><a class="btn btn-success" href="#novo-habito">Novo hábito</a></header>
<section class="hf-filter-panel"><form class="row g-2" method="get"><div class="col-md-5"><label class="form-label" for="q">Buscar</label><input id="q" name="q" class="form-control" placeholder="Nome ou categoria"></div><div class="col-md-3"><label class="form-label" for="categoryFilter">Categoria</label><select id="categoryFilter" class="form-select"><option>Todas</option><option>Saúde</option><option>Estudo</option><option>Trabalho</option></select></div><div class="col-md-2"><label class="form-label" for="statusFilter">Status</label><select id="statusFilter" class="form-select"><option>Ativos</option><option>Arquivados</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-success w-100">Filtrar</button></div></form></section>
<section id="novo-habito" class="hf-card mb-4"><h2>Novo hábito</h2><form method="post" asp-action="Create" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-4"><label class="form-label" for="name">Nome</label><input id="name" name="name" maxlength="120" required class="form-control" placeholder="Ex.: Ler 10 minutos" /></div><div class="col-6 col-md-2"><label class="form-label" for="color">Cor</label><input id="color" name="color" required value="#10B981" type="color" class="form-control form-control-color" /></div><div class="col-6 col-md-3"><label class="form-label" for="category">Categoria</label><input id="category" name="category" class="form-control" placeholder="Saúde" /></div><div class="col-md-3"><label class="form-label" for="frequencyType">Frequência</label><select id="frequencyType" name="frequencyType" class="form-select"><option value="Daily">Todos os dias</option><option value="Weekdays">Dias úteis</option><option value="Weekends">Finais de semana</option><option value="CustomWeekly">Dias personalizados</option></select></div><div class="col-md-3"><label class="form-label" for="targetPerWeek">Meta por semana</label><input id="targetPerWeek" name="targetPerWeek" min="1" max="7" type="number" class="form-control" /></div><div class="col-md-3"><label class="form-label" for="reminderTime">Lembrete</label><input id="reminderTime" name="reminderTime" type="time" class="form-control" /></div><div class="col-md-6"><span class="form-label d-block">Dias personalizados</span><div class="d-flex flex-wrap gap-2">@foreach(var d in new[]{("0","Dom"),("1","Seg"),("2","Ter"),("3","Qua"),("4","Qui"),("5","Sex"),("6","Sáb")}){<label class="btn btn-outline-success btn-sm hf-day-toggle"><input type="checkbox" name="selectedDays" value="@d.Item1" /> @d.Item2</label>}</div></div><div class="col-12"><label class="form-label" for="notes">Observações</label><textarea id="notes" name="notes" class="form-control" rows="2"></textarea></div><div class="col-12"><button class="btn btn-success btn-lg" data-loading-text="Criando...">Criar hábito</button></div></form></section>
<section class="row g-3">@foreach(var h in habits.Where(x=>!x.IsArchived)){<div class="col-md-6 col-lg-4"><article class="hf-card h-100" style="border-left:6px solid @h.Color"><span class="hf-badge">@(h.Category ?? "Rotina")</span><h2 class="h5 mt-2">@h.Name</h2><p class="text-muted">@h.FrequencyType · Meta @(h.TargetPerWeek?.ToString() ?? "livre")/semana</p><a class="btn btn-outline-success" href="/habits/@h.Id">Detalhes</a></article></div>}@if(!habits.Any()){<div class="col-12">@{ViewData["Title"]="Comece pequeno. Escolha um hábito simples para hoje.";ViewData["Message"]="Beber água, ler 10 minutos, caminhar, estudar ou dormir mais cedo são ótimos começos.";ViewData["ActionHref"]="#novo-habito";ViewData["ActionText"]="Criar hábito";}@await Html.PartialAsync("~/Views/Shared/Partials/_EmptyState.cshtml")</div>}</section>
