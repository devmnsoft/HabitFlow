@model IReadOnlyList<HabitFlow.Domain.Habit>
@using HabitFlow.Domain
@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<section class="hero-card"><h1>Meus hábitos</h1><p>Crie hábitos com recorrência, meta semanal e lembrete opcional.</p></section>
<div class="card p-3 mb-4"><form method="post" asp-action="Create" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-4"><label class="form-label">Nome</label><input name="name" maxlength="120" required class="form-control" /></div><div class="col-6 col-md-2"><label class="form-label">Cor</label><input name="color" required value="#198754" type="color" class="form-control form-control-color" /></div><div class="col-6 col-md-3"><label class="form-label">Categoria</label><input name="category" class="form-control" /></div><div class="col-md-3"><label class="form-label">Frequência</label><select name="frequencyType" class="form-select"><option value="Daily">Todos os dias</option><option value="Weekdays">Dias úteis</option><option value="Weekends">Finais de semana</option><option value="CustomWeekly">Dias personalizados</option></select></div><div class="col-md-3"><label class="form-label">Meta por semana</label><input name="targetPerWeek" min="1" max="7" type="number" class="form-control" /></div><div class="col-md-3"><label class="form-label">Lembrete</label><input name="reminderTime" type="time" class="form-control" /></div><div class="col-md-6"><label class="form-label">Dias personalizados</label><div class="d-flex flex-wrap gap-2">@foreach(var d in new[]{("0","Dom"),("1","Seg"),("2","Ter"),("3","Qua"),("4","Qui"),("5","Sex"),("6","Sáb")}){<label class="btn btn-outline-success btn-sm"><input type="checkbox" name="selectedDays" value="@d.Item1" /> @d.Item2</label>}</div></div><div class="col-12"><label class="form-label">Observações</label><textarea name="notes" class="form-control" rows="2"></textarea></div><div class="col-12"><button class="btn btn-success btn-lg">Criar hábito</button></div></form></div>
<div class="row g-3">@foreach(var h in Model){<div class="col-md-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><span class="badge" style="background:@h.Color">@h.Category</span><h2 class="h5 mt-2">@h.Name</h2><p class="text-muted">@h.FrequencyType · Meta @(h.TargetPerWeek?.ToString() ?? "livre")/semana</p><a class="btn btn-outline-success" href="/habits/@h.Id">Detalhes</a></div></div></div>}@if(!Model.Any()){<div class="col-12"><div class="alert alert-info">Comece com um hábito simples hoje: beber água, ler 10 minutos ou caminhar.</div></div>}</div>
