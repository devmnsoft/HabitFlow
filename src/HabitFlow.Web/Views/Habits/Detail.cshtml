@model HabitFlow.Application.HabitDetailsViewModel
@{ ViewData["Title"] = Model.Habit.Name; }
<header class="hf-habit-detail-hero" style="--habit-color:@Model.Habit.Color"><div><a asp-action="Index" class="hf-back-link">Voltar aos hábitos</a><div class="d-flex gap-2 mt-3"><partial name="Partials/_HabitStatusBadge" model="Model.Habit" /><span class="hf-category">@(Model.Habit.Category ?? "Rotina pessoal")</span></div><h1>@Model.Habit.Name</h1><p>@(string.IsNullOrWhiteSpace(Model.Habit.Notes) ? "Acompanhe sua prática e mantenha o ritmo possível." : Model.Habit.Notes)</p></div><a asp-action="Edit" asp-route-id="@Model.Habit.Id" class="btn btn-light">Editar hábito</a></header>
<partial name="Partials/_HabitMetricsPanel" model="Model" />
<div class="hf-detail-grid"><partial name="Partials/_HabitCalendarHeatmap" model="Model" /><partial name="Partials/_HabitTimeline" model="Model" /></div>
<partial name="Partials/_HabitLifecycleActions" model="Model.Habit" />
@section Styles { <link rel="stylesheet" href="~/css/habits-v4.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/habits-v4.js" asp-append-version="true"></script> }
