@model HabitFlow.Application.HabitListViewModel
@{ var sort = Model.Query.Sort ?? "newest"; }
<form method="get" class="hf-habit-filters" aria-label="Filtrar hábitos"><div><label for="Search">Buscar</label><input id="Search" name="Search" value="@Model.Query.Search" class="form-control" placeholder="Nome ou categoria" /></div><div><label for="Category">Categoria</label><select id="Category" name="Category" class="form-select"><option value="">Todas</option>@foreach(var category in Model.Categories){if(category == Model.Query.Category){<option value="@category" selected>@category</option>}else{<option value="@category">@category</option>}}</select></div><div><label for="Status">Status</label><select id="Status" name="Status" class="form-select">@foreach(var option in new[]{("active","Ativos"),("paused","Pausados"),("archived","Arquivados"),("all","Todos")}){if(Model.Query.Status == option.Item1){<option value="@option.Item1" selected>@option.Item2</option>}else{<option value="@option.Item1">@option.Item2</option>}}</select></div><div><label for="Sort">Ordenar</label><select id="Sort" name="Sort" class="form-select">@foreach(var option in new[]{("newest","Mais recentes"),("updated","Atualizados"),("name","Nome"),("oldest","Mais antigos")}){if(sort == option.Item1){<option value="@option.Item1" selected>@option.Item2</option>}else{<option value="@option.Item1">@option.Item2</option>}}</select></div><button class="btn btn-success" type="submit">Aplicar filtros</button></form>
