@model HabitFlow.Application.HabitListViewModel
<form method="get" class="hf-habit-filters" aria-label="Filtrar hábitos"><div><label for="Search">Buscar</label><input id="Search" name="Search" value="@Model.Query.Search" class="form-control" placeholder="Nome ou categoria" /></div><div><label for="Category">Categoria</label><select id="Category" name="Category" class="form-select"><option value="">Todas</option>@foreach(var category in Model.Categories){<option value="@category" selected="@(category == Model.Query.Category)">@category</option>}</select></div><div><label for="Status">Status</label><select id="Status" name="Status" class="form-select"><option value="active" selected="@(Model.Query.Status == "active")">Ativos</option><option value="paused" selected="@(Model.Query.Status == "paused")">Pausados</option><option value="archived" selected="@(Model.Query.Status == "archived")">Arquivados</option><option value="all" selected="@(Model.Query.Status == "all")">Todos</option></select></div><div><label for="Sort">Ordenar</label><select id="Sort" name="Sort" class="form-select"><option value="newest">Mais recentes</option><option value="updated">Atualizados</option><option value="name">Nome</option><option value="oldest">Mais antigos</option></select></div><button class="btn btn-success" type="submit">Aplicar filtros</button></form>
