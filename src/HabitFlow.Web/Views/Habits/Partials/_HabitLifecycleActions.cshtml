@model HabitFlow.Domain.Habit
<section class="hf-lifecycle"><h2>Gerenciar hábito</h2><div>@if(Model.IsArchived){<form method="post" asp-action="Lifecycle" asp-route-id="@Model.Id" asp-route-actionName="restore">@Html.AntiForgeryToken()<button class="btn btn-success">Restaurar</button></form>}else{<form method="post" asp-action="Lifecycle" asp-route-id="@Model.Id" asp-route-actionName="@(Model.IsPaused ? "resume" : "pause")">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary">@(Model.IsPaused ? "Retomar" : "Pausar")</button></form><button class="btn btn-outline-danger" type="button" data-modal-open="archive-modal">Arquivar</button>}</div><dialog id="archive-modal" aria-labelledby="archive-title"><form method="dialog"><button class="hf-modal-close" aria-label="Fechar">×</button></form><h2 id="archive-title">Arquivar este hábito?</h2><p>O histórico será preservado e você poderá restaurá-lo depois.</p><form method="post" asp-action="Lifecycle" asp-route-id="@Model.Id" asp-route-actionName="archive">@Html.AntiForgeryToken()<button class="btn btn-danger">Arquivar e preservar histórico</button></form></dialog></section>
