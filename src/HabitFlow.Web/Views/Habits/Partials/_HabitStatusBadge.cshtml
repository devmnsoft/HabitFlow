@model HabitFlow.Domain.Habit
@{
    var statusClass = "hf-habit-status-active";
    var statusText = "Ativo";

    if (Model is null)
    {
        statusClass = "hf-habit-status-unavailable";
        statusText = "Indisponível";
    }
    else if (Model.IsArchived)
    {
        statusClass = "hf-habit-status-archived";
        statusText = "Arquivado";
    }
    else if (Model.IsPaused)
    {
        statusClass = "hf-habit-status-paused";
        statusText = "Pausado";
    }
    else if (Model.StartDate is { } startDate && startDate > DateOnly.FromDateTime(DateTime.UtcNow))
    {
        statusClass = "hf-habit-status-scheduled";
        statusText = "Agendado";
    }
}
<span class="hf-habit-status @statusClass">@statusText</span>
