@model HabitFlow.Application.HabitListItem
<article class="hf-habit-card" style="--habit-color:@Model.Habit.Color"><div class="hf-card-top"><partial name="_HabitStatusBadge" model="Model.Habit" /><span>@(Model.Habit.Category ?? "Rotina pessoal")</span></div><h2><a asp-action="Detail" asp-route-id="@Model.Habit.Id">@Model.Habit.Name</a></h2><p>@(Model.Habit.FrequencyType switch { HabitFlow.Domain.HabitFrequencyType.Daily => "Todos os dias", HabitFlow.Domain.HabitFrequencyType.Weekdays => "Dias úteis", HabitFlow.Domain.HabitFrequencyType.Weekends => "Fins de semana", _ => "Dias escolhidos" })</p><div class="hf-consistency"><div><span>Consistência em 28 dias</span><strong>@Model.Consistency.ToString("0.#")%</strong></div><progress max="100" value="@Model.Consistency" aria-label="Consistência de @Model.Consistency.ToString("0.#") por cento"></progress><small>@Model.CompletedCount conclusões em @Model.ScheduledCount oportunidades</small></div><a asp-action="Detail" asp-route-id="@Model.Habit.Id" class="btn btn-outline-success">Ver progresso</a></article>
