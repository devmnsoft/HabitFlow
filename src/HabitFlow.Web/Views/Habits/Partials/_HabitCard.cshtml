@model HabitFlow.Application.HabitListItem
@{ var completionLabel = Model.CompletedCount == 1 ? "conclusão" : "conclusões"; var opportunityLabel = Model.ScheduledCount == 1 ? "oportunidade" : "oportunidades"; }
<article class="hf-habits-list-card" style="--habit-color:@Model.Habit.Color">
  <header class="hf-habits-list-card__header"><partial name="Partials/_HabitStatusBadge" model="Model.Habit" /><span class="hf-habits-list-card__category" title="@(Model.Habit.Category ?? "Rotina pessoal")">@(Model.Habit.Category ?? "Rotina pessoal")</span></header>
  <div class="hf-habits-list-card__content"><h2><a asp-action="Detail" asp-route-id="@Model.Habit.Id">@Model.Habit.Name</a></h2><p>@(Model.Habit.FrequencyType switch { HabitFlow.Domain.HabitFrequencyType.Daily => "Todos os dias", HabitFlow.Domain.HabitFrequencyType.Weekdays => "Dias úteis", HabitFlow.Domain.HabitFrequencyType.Weekends => "Fins de semana", _ => "Dias escolhidos" })</p></div>
  <section class="hf-habits-list-card__metrics" aria-label="Consistência"><div><span>Consistência em 28 dias</span><strong>@Model.Consistency.ToString("0.#")%</strong></div><progress class="@(Model.Consistency >= 100 ? "is-complete" : Model.Consistency > 0 ? "is-progress" : "is-empty")" max="100" value="@Model.Consistency" aria-label="Consistência de @Model.Consistency.ToString("0.#") por cento"></progress><small>@Model.CompletedCount @completionLabel em @Model.ScheduledCount @opportunityLabel</small></section>
  <footer class="hf-habits-list-card__footer"><a asp-action="Detail" asp-route-id="@Model.Habit.Id" class="btn btn-outline-success">Ver progresso</a><div class="hf-habits-list-card__secondary" aria-label="Ações secundárias"></div></footer>
</article>
