@model HabitFlow.Application.HabitDetailsViewModel
<section class="hf-panel"><h2>Calendário de 12 semanas</h2><p>Cada célula representa um dia: preenchida quando houve conclusão, contornada quando estava agendado.</p><div class="hf-heatmap" role="img" aria-label="Histórico de conclusões nas últimas doze semanas">@foreach(var day in Model.Calendar){<span class="@(day.Completed ? "done" : day.Scheduled ? "missed" : "off")" title="@day.Date.ToString("dd/MM/yyyy"): @(day.Completed ? "concluído" : day.Scheduled ? "não concluído" : "não agendado")"></span>}</div><div class="hf-legend"><span><i class="off"></i>Não agendado</span><span><i class="missed"></i>Agendado</span><span><i class="done"></i>Concluído</span></div></section>
