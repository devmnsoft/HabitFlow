@model HabitFlow.Application.HabitEditorViewModel
<section class="hf-form-card"><h2>Frequência</h2><label for="FrequencyType" class="form-label">Quando acontece?</label><select id="FrequencyType" name="FrequencyType" class="form-select" data-frequency aria-describedby="schedulePreview FrequencyTypeError"><option value="Daily" selected="@(Model.FrequencyType == HabitFlow.Domain.HabitFrequencyType.Daily)">Todos os dias</option><option value="Weekdays" selected="@(Model.FrequencyType == HabitFlow.Domain.HabitFrequencyType.Weekdays)">Dias úteis</option><option value="Weekends" selected="@(Model.FrequencyType == HabitFlow.Domain.HabitFrequencyType.Weekends)">Fins de semana</option><option value="CustomWeekly" selected="@(Model.FrequencyType == HabitFlow.Domain.HabitFrequencyType.CustomWeekly)">Escolher dias</option></select><span asp-validation-for="FrequencyType" id="FrequencyTypeError" class="text-danger"></span><p id="schedulePreview" class="hf-schedule-preview" data-schedule-preview aria-live="polite"></p><fieldset class="hf-weekdays" data-weekdays aria-describedby="SelectedDaysError"><legend>Dias da semana</legend>@foreach(var day in new[]{(0,"Dom","domingo"),(1,"Seg","segunda"),(2,"Ter","terça"),(3,"Qua","quarta"),(4,"Qui","quinta"),(5,"Sex","sexta"),(6,"Sáb","sábado")}){<label><input type="checkbox" name="SelectedDays" value="@day.Item1" data-day-name="@day.Item3" checked="@(Model.SelectedDays?.Contains(day.Item1) == true)" /><span>@day.Item2</span></label>}<span asp-validation-for="SelectedDays" id="SelectedDaysError" class="text-danger"></span></fieldset><label for="TargetPerWeek" class="form-label mt-3">Meta semanal</label><input id="TargetPerWeek" name="TargetPerWeek" value="@Model.TargetPerWeek" type="number" min="1" max="7" class="form-control" aria-describedby="TargetPerWeekError" /><span asp-validation-for="TargetPerWeek" id="TargetPerWeekError" class="text-danger"></span></section>
