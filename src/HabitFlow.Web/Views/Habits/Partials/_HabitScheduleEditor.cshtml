@model HabitFlow.Application.HabitEditorViewModel
<section class="hf-form-card"><h2>Frequência</h2><label for="FrequencyType" class="form-label">Quando acontece?</label><select id="FrequencyType" name="FrequencyType" class="form-select" data-frequency><option value="Daily" selected="@(Model.FrequencyType == HabitFlow.Domain.HabitFrequencyType.Daily)">Todos os dias</option><option value="Weekdays" selected="@(Model.FrequencyType == HabitFlow.Domain.HabitFrequencyType.Weekdays)">Dias úteis</option><option value="Weekends" selected="@(Model.FrequencyType == HabitFlow.Domain.HabitFrequencyType.Weekends)">Fins de semana</option><option value="CustomWeekly" selected="@(Model.FrequencyType == HabitFlow.Domain.HabitFrequencyType.CustomWeekly)">Escolher dias</option></select><div class="hf-weekdays" data-weekdays><span>Dias da semana</span>@foreach(var day in new[]{(0,"Dom"),(1,"Seg"),(2,"Ter"),(3,"Qua"),(4,"Qui"),(5,"Sex"),(6,"Sáb")}){<label><input type="checkbox" name="SelectedDays" value="@day.Item1" checked="@Model.SelectedDays.Contains(day.Item1)" /><span>@day.Item2</span></label>}</div><label for="TargetPerWeek" class="form-label mt-3">Meta semanal</label><input id="TargetPerWeek" name="TargetPerWeek" value="@Model.TargetPerWeek" type="number" min="1" max="7" class="form-control" /></section>
