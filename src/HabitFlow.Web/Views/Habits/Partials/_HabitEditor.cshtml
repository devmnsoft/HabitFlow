@model HabitFlow.Application.HabitEditorPageViewModel
@{ var editor = Model.Editor; }
<section class="hf-form-card hf-editor-step" data-editor-step><span class="hf-step-badge">1</span><h2>Identidade do hábito</h2>
<div class="mb-3"><label for="Name" class="form-label">O que você quer praticar?</label><input id="Name" name="Name" value="@editor.Name" maxlength="120" required class="form-control form-control-lg" aria-describedby="nameHelp" /><small id="nameHelp">Use uma ação concreta, como “Caminhar por 20 minutos”.</small><span asp-validation-for="Editor.Name" class="text-danger"></span></div>
<div class="hf-fields">
<div><label for="Category" class="form-label">Categoria</label><input id="Category" name="Category" value="@editor.Category" list="habitCategorySuggestions" maxlength="80" class="form-control" aria-describedby="categoryHelp" /><datalist id="habitCategorySuggestions">@foreach(var category in Model.CategorySuggestions){<option value="@category"></option>}</datalist><small id="categoryHelp">Escolha uma categoria existente ou digite uma nova.</small></div>
<div><label for="IconCode" class="form-label">Ícone</label><select id="IconCode" name="IconCode" class="form-select"><option value="check-circle" selected="@(editor.IconCode == "check-circle")">Concluir</option><option value="heart" selected="@(editor.IconCode == "heart")">Saúde</option><option value="book" selected="@(editor.IconCode == "book")">Estudo</option><option value="book-open" selected="@(editor.IconCode == "book-open")">Leitura</option><option value="activity" selected="@(editor.IconCode == "activity")">Movimento</option><option value="droplet" selected="@(editor.IconCode == "droplet")">Água</option><option value="moon" selected="@(editor.IconCode == "moon")">Sono</option><option value="calendar" selected="@(editor.IconCode == "calendar")">Planejamento</option></select></div>
<div><label for="Color" class="form-label">Cor</label><input id="Color" name="Color" value="@editor.Color" type="color" class="form-control form-control-color" required /></div>
<div><label for="EstimatedTimeMinutes" class="form-label">Duração estimada</label><div class="input-group"><input id="EstimatedTimeMinutes" name="EstimatedTimeMinutes" value="@editor.EstimatedTimeMinutes" type="number" min="1" max="1440" class="form-control" /><span class="input-group-text">min</span></div></div>
<div><label for="Difficulty" class="form-label">Dificuldade</label><select id="Difficulty" name="Difficulty" class="form-select"><option value="" selected="@(editor.Difficulty is null)">Não definida</option><option value="Easy" selected="@(editor.Difficulty == HabitFlow.Domain.HabitDifficulty.Easy)">Leve</option><option value="Medium" selected="@(editor.Difficulty == HabitFlow.Domain.HabitDifficulty.Medium)">Moderada</option><option value="Hard" selected="@(editor.Difficulty == HabitFlow.Domain.HabitDifficulty.Hard)">Desafiadora</option></select></div>
<div class="hf-goal-field"><label for="ObjectiveId" class="form-label">Objetivo vinculado</label><select id="ObjectiveId" name="ObjectiveId" class="form-select" aria-describedby="goalHelp"><option value="">Sem objetivo vinculado</option>@foreach(var goal in Model.GoalOptions){<option value="@goal.Id" selected="@(goal.Id == editor.ObjectiveId)">@goal.Title — @(goal.Status == "Active" ? "Ativo" : "Pausado") (@goal.ProgressPercentage%)</option>}</select><small id="goalHelp">Escolha um objetivo da sua conta; IDs nunca precisam ser digitados.</small><div class="hf-inline-actions"><a href="/goals/create">Criar objetivo</a><a href="/goals">Ver objetivos</a></div></div>
</div><div class="mt-3"><label for="Notes" class="form-label">Notas</label><textarea id="Notes" name="Notes" maxlength="2000" rows="4" class="form-control">@editor.Notes</textarea></div></section>
<section class="hf-form-card hf-editor-step" data-editor-step><span class="hf-step-badge">2</span><h2>Como acompanhar</h2><p class="hf-form-hint">Escolha uma conclusão simples ou uma meta mensurável. A versão mínima ajuda a manter o ciclo nos dias apertados.</p>
<div class="hf-choice-grid" role="radiogroup" aria-label="Forma de acompanhamento">
<label><input type="radio" name="TrackingMode" value="binary" data-tracking-mode checked="@(editor.TargetQuantity is null)" /><span><strong>Concluir sim/não</strong><small>Bom para ações sem contagem.</small></span></label>
<label><input type="radio" name="TrackingMode" value="quantity" data-tracking-mode checked="@(editor.TargetQuantity is not null)" /><span><strong>Registrar quantidade</strong><small>Minutos, páginas, passos ou outra unidade.</small></span></label>
</div>
<div class="hf-fields hf-adaptive-fields" data-quantity-fields>
<div><label for="TargetQuantity" class="form-label">Meta por ocorrência</label><input id="TargetQuantity" name="TargetQuantity" value="@editor.TargetQuantity" type="number" min="0.01" step="0.01" class="form-control" aria-describedby="TargetQuantityError" /><span asp-validation-for="Editor.TargetQuantity" id="TargetQuantityError" class="text-danger"></span></div>
<div><label for="TargetUnit" class="form-label">Unidade</label><select id="TargetUnit" name="TargetUnit" class="form-select" aria-describedby="TargetUnitError"><option value="">Selecione</option>@foreach(var unit in new[]{("min","minutos"),("pages","páginas"),("steps","passos"),("ml","ml"),("liters","litros"),("km","km"),("times","vezes"),("sessions","sessões")}){<option value="@unit.Item1" selected="@(editor.TargetUnit == unit.Item1)">@unit.Item2</option>}</select><span asp-validation-for="Editor.TargetUnit" id="TargetUnitError" class="text-danger"></span></div>
<div><label for="MinimumVersionName" class="form-label">Versão mínima</label><input id="MinimumVersionName" name="MinimumVersionName" value="@editor.MinimumVersionName" maxlength="120" class="form-control" placeholder="Ex.: abrir o livro" /></div>
<div><label for="MinimumVersionQuantity" class="form-label">Quantidade mínima</label><input id="MinimumVersionQuantity" name="MinimumVersionQuantity" value="@editor.MinimumVersionQuantity" type="number" min="0.01" step="0.01" class="form-control" aria-describedby="MinimumVersionQuantityError" /><span asp-validation-for="Editor.MinimumVersionQuantity" id="MinimumVersionQuantityError" class="text-danger"></span></div>
</div></section>
