@model HabitFlow.Application.HabitEditorViewModel
<section class="hf-form-card"><h2>Identidade do hábito</h2><div class="mb-3"><label for="Name" class="form-label">O que você quer praticar?</label><input id="Name" name="Name" value="@Model.Name" maxlength="120" required class="form-control form-control-lg" aria-describedby="nameHelp" /><small id="nameHelp">Use uma ação concreta, como “Caminhar por 20 minutos”.</small></div><div class="hf-fields"><div><label for="Category" class="form-label">Categoria</label><input id="Category" name="Category" value="@Model.Category" maxlength="80" class="form-control" /></div><div><label for="IconCode" class="form-label">Ícone</label><select id="IconCode" name="IconCode" class="form-select"><option value="check-circle">Concluir</option><option value="heart">Saúde</option><option value="book">Estudo</option><option value="activity">Movimento</option></select></div><div><label for="Color" class="form-label">Cor</label><input id="Color" name="Color" value="@Model.Color" type="color" class="form-control form-control-color" required /></div><div><label for="EstimatedTimeMinutes" class="form-label">Duração estimada</label><div class="input-group"><input id="EstimatedTimeMinutes" name="EstimatedTimeMinutes" value="@Model.EstimatedTimeMinutes" type="number" min="1" max="1440" class="form-control" /><span class="input-group-text">min</span></div></div><div><label for="Difficulty" class="form-label">Dificuldade</label><select id="Difficulty" name="Difficulty" class="form-select"><option value="">Não definida</option><option value="Easy">Leve</option><option value="Medium">Moderada</option><option value="Hard">Desafiadora</option></select></div><div><label for="ObjectiveId" class="form-label">Objetivo vinculado</label><input id="ObjectiveId" name="ObjectiveId" value="@Model.ObjectiveId" type="text" class="form-control" placeholder="ID do objetivo, se houver" /></div></div><div class="mt-3"><label for="Notes" class="form-label">Notas</label><textarea id="Notes" name="Notes" maxlength="2000" rows="4" class="form-control">@Model.Notes</textarea></div></section>
