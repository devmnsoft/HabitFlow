@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Criar conta"; }
<section class="row justify-content-center"><div class="col-md-8 col-lg-6"><div class="hf-card"><p class="hf-eyebrow">Comece hoje</p><h1>Crie uma conta e escolha seu primeiro hábito.</h1><p class="text-muted">Use um e-mail válido e uma senha segura para proteger sua rotina.</p><form method="post" action="/register">@Html.AntiForgeryToken()<div class="mb-3"><label class="form-label" for="Name">Nome</label><input id="Name" name="Name" required maxlength="120" autocomplete="name" class="form-control"></div><div class="mb-3"><label class="form-label" for="Email">E-mail</label><input id="Email" name="Email" type="email" required autocomplete="email" class="form-control"></div><div class="mb-3"><label class="form-label" for="Password">Senha</label><input id="Password" name="Password" type="password" required autocomplete="new-password" class="form-control"></div><button class="btn btn-success w-100" data-loading-text="Criando...">Criar conta</button></form><p class="mt-3 mb-0 text-muted">Já tem conta? <a href="/login">Entrar</a>. Ao continuar, você concorda com privacidade e termos.</p></div></div></section>
