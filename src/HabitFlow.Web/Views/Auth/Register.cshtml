@model HabitFlow.Web.Models.RegisterViewModel
@{ ViewData["Title"] = "Crie sua conta no HabitFlow"; }
<section class="hf-auth-grid hf-register-client" data-register-client>
  <div class="hf-auth-card">
    <p class="hf-eyebrow">Começar grátis</p>
    <h1>Crie sua conta no HabitFlow</h1>
    <p class="lead">Informe seus dados para criar o cliente e o primeiro usuário administrador da conta.</p>
    <form method="post" action="/register" data-register-form novalidate>@Html.AntiForgeryToken()
      <input asp-for="DocumentType" type="hidden" data-document-type />
      <div class="mb-3"><label class="form-label">Você está criando uma conta para:</label><div class="row g-2">
        <label class="col-md-6"><input asp-for="ClientPersonType" type="radio" value="NaturalPerson" class="btn-check" data-person-type><span class="btn btn-outline-success w-100 p-3">Pessoa Física<br><small>CPF</small></span></label>
        <label class="col-md-6"><input asp-for="ClientPersonType" type="radio" value="LegalPerson" class="btn-check" data-person-type><span class="btn btn-outline-success w-100 p-3">Pessoa Jurídica<br><small>CNPJ</small></span></label>
      </div><span asp-validation-for="ClientPersonType" class="text-danger"></span><p class="form-text" data-person-help>Use CPF quando a conta for para uso individual.</p></div>
      <div data-pf-fields><div class="mb-3"><label class="form-label" for="Name">Nome completo</label><input asp-for="Name" autocomplete="name" class="form-control" placeholder="Seu nome completo"><span asp-validation-for="Name" class="text-danger"></span></div></div>
      <div data-pj-fields>
        <div class="mb-3"><label class="form-label" for="LegalName">Razão social</label><input asp-for="LegalName" class="form-control" placeholder="Razão social"><span asp-validation-for="LegalName" class="text-danger"></span></div>
        <div class="mb-3"><label class="form-label" for="TradeName">Nome fantasia</label><input asp-for="TradeName" class="form-control" placeholder="Opcional"></div>
        <div class="mb-3"><label class="form-label" for="ResponsibleName">Nome do responsável</label><input asp-for="ResponsibleName" autocomplete="name" class="form-control" placeholder="Administrador da conta"><span asp-validation-for="ResponsibleName" class="text-danger"></span></div>
      </div>
      <div class="mb-3"><label class="form-label" for="Document" data-document-label>CPF</label><input asp-for="Document" required class="form-control" inputmode="numeric" autocomplete="off" placeholder="000.000.000-00" data-document-input><span asp-validation-for="Document" class="text-danger"></span><p class="form-text" data-document-feedback></p></div>
      <div class="mb-3"><label class="form-label" for="Email">E-mail</label><input asp-for="Email" type="email" required autocomplete="email" class="form-control" placeholder="voce@email.com"><span asp-validation-for="Email" class="text-danger"></span></div>
      <div class="mb-3"><label class="form-label" for="Phone">Telefone</label><input asp-for="Phone" class="form-control" placeholder="Opcional"></div>
      @await Html.PartialAsync("~/Views/Shared/Partials/_PasswordInput.cshtml", null, new ViewDataDictionary(ViewData){{"Id","Password"},{"Name","Password"},{"Label","Senha"},{"Autocomplete","new-password"},{"Placeholder","Mínimo de 8 caracteres"},{"HelpText","Use uma senha segura. Seus dados são tratados conforme a LGPD."}})
      @await Html.PartialAsync("~/Views/Shared/Partials/_PasswordInput.cshtml", null, new ViewDataDictionary(ViewData){{"Id","ConfirmPassword"},{"Name","ConfirmPassword"},{"Label","Confirmar senha"},{"Autocomplete","new-password"},{"Placeholder","Digite a mesma senha"},{"HelpText","Repita a senha para evitar erros no cadastro."}})
      <span asp-validation-for="Password" class="text-danger"></span><span asp-validation-for="ConfirmPassword" class="text-danger"></span><p class="hf-field-error d-none" data-password-match-error role="alert">As senhas ainda não conferem.</p>
      <label class="form-check mb-2"><input asp-for="AcceptedTerms" class="form-check-input" required> <span class="form-check-label">Aceito os Termos de Uso</span></label><span asp-validation-for="AcceptedTerms" class="text-danger"></span>
      <label class="form-check mb-3"><input asp-for="AcceptedPrivacy" class="form-check-input" required> <span class="form-check-label">Aceito a Política de Privacidade</span></label><span asp-validation-for="AcceptedPrivacy" class="text-danger"></span>
      <button class="btn btn-success btn-lg w-100" data-loading-text="Criando...">Criar conta grátis</button>
    </form>
    <p class="mt-3 mb-0 text-muted">Já tenho conta. <a href="/login">Entrar</a>.</p>
  </div>
  <aside class="hf-auth-aside"><h2>Seu espaço começa do jeito certo.</h2><ul><li>Sua conta começa no plano Gratuito.</li><li>Você pode cuidar das pessoas da sua conta.</li><li>Seus dados são validados e protegidos.</li><li>Um caminho acolhedor espera por você após entrar.</li></ul></aside>
</section>
@section Scripts { <script src="~/js/register-client.js" asp-append-version="true"></script> }
