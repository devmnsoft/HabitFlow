@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Entrar"; }
<section class="row justify-content-center"><div class="col-md-7 col-lg-5"><div class="hf-card"><p class="hf-eyebrow">Bem-vindo de volta</p><h1>Entre para manter sua sequência.</h1><p class="text-muted">Acesse seus hábitos, relatórios e notificações com segurança.</p><form method="post" action="/login">@Html.AntiForgeryToken()<div class="mb-3"><label class="form-label" for="Email">E-mail</label><input id="Email" name="Email" type="email" autocomplete="email" required class="form-control"></div><div class="mb-3"><label class="form-label" for="Password">Senha</label><input id="Password" name="Password" type="password" autocomplete="current-password" required class="form-control"></div><button class="btn btn-success w-100" data-loading-text="Entrando...">Entrar</button></form><p class="mt-3 mb-0 text-muted">Ainda não tem conta? <a href="/register">Criar conta</a>. Seus dados são tratados conforme LGPD.</p></div></div></section>
