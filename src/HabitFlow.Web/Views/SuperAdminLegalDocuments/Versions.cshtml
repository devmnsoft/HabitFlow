@model IReadOnlyList<HabitFlow.Domain.LegalDocumentVersion>
@{ ViewData["Title"] = "Versões jurídicas"; }
<main class="container py-4"><h1>Histórico de versões</h1><div class="row g-3 mt-2">@foreach(var item in Model){<div class="col-12"><section class="card border-0 shadow-sm"><div class="card-body d-flex flex-wrap justify-content-between gap-3"><div><h2 class="h5 mb-1">@item.Title · @item.Version</h2><span class="badge text-bg-secondary">@item.Status</span> <small class="text-body-secondary">SHA-256 @item.ContentHash[..12]…</small></div><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-secondary" asp-action="Preview" asp-route-id="@item.DocumentId" asp-route-versionId="@item.Id">Visualizar</a>@if(item.Status == HabitFlow.Domain.LegalDocumentStatus.Draft){<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.DocumentId" asp-route-versionId="@item.Id">Editar</a><form asp-action="Publish" asp-route-id="@item.DocumentId" asp-route-versionId="@item.Id" method="post"><button class="btn btn-sm btn-primary">Publicar</button></form>}</div></div></section></div>}</div></main>
