@model HabitFlow.Web.Models.LegalDocumentEditViewModel
<main class="container py-4"><div class="card border-0 shadow-sm mx-auto" style="max-width:920px"><div class="card-body p-4"><h1 class="h2">@ViewData["Title"]</h1><p class="text-body-secondary">Somente elementos HTML seguros da allowlist serão preservados.</p>
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger" aria-live="polite"></div><input asp-for="DocumentId" type="hidden"/><input asp-for="VersionId" type="hidden"/>
<div class="row g-3"><div class="col-md-6"><label asp-for="DocumentType" class="form-label">Tipo</label><select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<HabitFlow.Domain.LegalDocumentType>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="Version" class="form-label">Versão</label><input asp-for="Version" class="form-control"/></div><div class="col-md-3"><label asp-for="Locale" class="form-label">Idioma</label><input asp-for="Locale" class="form-control"/></div>
<div class="col-12"><label asp-for="Title" class="form-label">Título</label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-12"><label asp-for="Summary" class="form-label">Resumo</label><textarea asp-for="Summary" class="form-control" rows="2"></textarea></div><div class="col-12"><label asp-for="Content" class="form-label">Conteúdo</label><textarea asp-for="Content" class="form-control font-monospace" rows="16"></textarea></div><div class="col-md-6"><label asp-for="EffectiveAt" class="form-label">Vigência (UTC)</label><input asp-for="EffectiveAt" class="form-control"/></div><div class="col-md-6 d-flex align-items-end"><div class="form-check"><input asp-for="RequiresReacceptance" class="form-check-input"/><label asp-for="RequiresReacceptance" class="form-check-label">Exigir novo aceite</label></div></div></div>
<div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar rascunho</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div></form></div></div></main>
