@model HabitFlow.Application.DashboardDto?
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Dashboard"; var habits = Model?.Habits ?? Array.Empty<HabitFlow.Application.HabitDto>(); var pending = habits.FirstOrDefault(x => !x.DoneToday && !x.IsArchived); var today = DateTime.UtcNow.ToString("dd/MM/yyyy"); }
<header class="hf-page-header"><div><p class="hf-section-kicker">@today</p><h1>Olá, @(Model?.Name ?? "vamos começar") 👋</h1><p>O HabitFlow mostra seus hábitos do dia, registra o que você concluiu e acompanha sua evolução.</p></div><a class="btn btn-success btn-lg" href="/habit-library">Ver biblioteca de hábitos</a></header>
@if (!habits.Any()) {<section class="hf-empty-state mb-4"><div class="hf-empty-icon">+</div><h2>Comece escolhendo um hábito pronto.</h2><p>Você ainda não tem hábitos. Comece com um hábito simples hoje.</p><a class="btn btn-success btn-lg" href="/habit-library">Ver biblioteca de hábitos</a></section>} else if (pending is not null) {<section class="hf-guided-card mb-4"><p class="hf-section-kicker">Seu próximo passo</p><h2>@pending.Name</h2><p class="text-muted">Marque este hábito quando concluir. Pequenas ações diárias criam consistência.</p></section>} else {<section class="hf-guided-card mb-4"><p class="hf-section-kicker">Tudo concluído</p><h2>Você concluiu tudo por hoje.</h2><p>Veja seu progresso ou planeje um novo hábito para continuar evoluindo.</p><a class="btn btn-outline-success" href="/progress">Ver progresso</a></section>}
@if ((Model?.ActiveHabits ?? 0) >= HabitFlow.Shared.AppConstants.FreePlanHabitLimit) {<div class="alert alert-info">Você chegou ao limite do plano gratuito. Pode arquivar um hábito ou conhecer o Premium.</div>}
<section class="hf-grid mb-4"><div class="hf-col-3 hf-metric-card"><span>Hábitos de hoje</span><strong>@(Model?.ActiveHabits ?? 0)</strong><small>ativos na rotina</small></div><div class="hf-col-3 hf-metric-card"><span>Concluídos</span><strong>@(Model?.DoneToday ?? 0)</strong><small>marcados hoje</small></div><div class="hf-col-3 hf-metric-card"><span>Percentual do dia</span><strong>@(Model?.DayPercent ?? 0)%</strong><small>avance um passo</small></div><div class="hf-col-3 hf-metric-card"><span>Melhor sequência</span><strong>@(Model?.BestStreak ?? 0)</strong><small>dias</small></div></section>
<div class="row g-4"><section class="col-lg-8"><h2 class="h4 mb-3">Hábitos devidos hoje</h2><div class="d-grid gap-3">@foreach(var h in habits){@await Html.PartialAsync("~/Views/Shared/Partials/_HabitCard.cshtml", h)}</div></section><aside class="col-lg-4"><div class="hf-card"><h2 class="h5">Progresso do dia</h2><div class="progress my-3"><div class="progress-bar" style="width:@(Model?.DayPercent ?? 0)%"></div></div><p class="text-muted mb-0">Você cadastra seus hábitos, marca o que concluiu e acompanha sua evolução com relatórios fáceis de entender.</p></div></aside></div>
