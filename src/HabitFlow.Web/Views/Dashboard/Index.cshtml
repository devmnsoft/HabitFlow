@model DashboardViewModel?
@{ ViewData["Title"] = "Dashboard"; }
@section Styles { <link rel="stylesheet" href="~/css/dashboard-v4.css" asp-append-version="true" /> }
<main class="dashboard-v4" data-dashboard>
  @if (Model is null) { <partial name="Partials/_DashboardEmptyState" /> }
  else {
    <partial name="Partials/_DashboardHero" model="Model" />
    <partial name="Partials/_ExecutiveSummary" model="Model" />
    <div class="dashboard-v4__grid">
      <partial name="Partials/_TodayFocusCard" model="Model" />
      <partial name="Partials/_DailyProgressRing" model="Model.Today" />
      <partial name="Partials/_TodayHabitsPreview" model="Model.Today" />
      <partial name="Partials/_WeeklyMomentumCard" model="Model" />
      <partial name="Partials/_PrimaryGoalCard" model="Model.PrimaryGoal" />
      <partial name="Partials/_PlanUsageMiniCard" model="Model.Plan" />
      @if (Model.Security.IsVisible) { <partial name="Partials/_SecurityPrivacyAlertCard" model="Model.Security" /> }
    </div>
    <div class="visually-hidden" aria-live="polite" data-dashboard-status></div>
  }
</main>
@section Scripts { <script src="~/js/dashboard-v4.js" asp-append-version="true"></script> }
