@model HabitFlow.Application.DashboardDto?
@{ ViewData["Title"] = "Dashboard"; var habits = Model?.Habits ?? Array.Empty<HabitFlow.Application.HabitDto>(); var pending = habits.FirstOrDefault(x => !x.DoneToday && !x.IsArchived); var today = DateTime.UtcNow.ToString("dd/MM/yyyy"); var doneToday = Model?.DoneToday ?? 0; }
<header class="hf-page-header" data-tour="today"><div><p class="hf-section-kicker">@today</p><h1>Seu dia no HabitFlow</h1><p>Veja seus hábitos de hoje e mantenha sua sequência.</p></div><a class="btn btn-success btn-lg" href="/habit-library" data-tour="library">Ver biblioteca de hábitos</a></header>
@await Html.PartialAsync("~/Views/Shared/Partials/_QuickHelpCard.cshtml", null, new ViewDataDictionary(ViewData){{"Text","Este é seu painel do dia. Aqui você vê o que precisa fazer hoje e marca os hábitos concluídos."}})
@if (!habits.Any()) {<section class="hf-empty-state mb-4"><div class="hf-empty-icon">+</div><h2>Você ainda não tem hábitos. Comece com uma sugestão pronta.</h2><p>A biblioteca ajuda você a adicionar o primeiro hábito sem esforço.</p><a class="btn btn-success btn-lg" href="/habit-library">Ver biblioteca de hábitos</a></section>} else if (pending is not null) {<section class="hf-guided-card mb-4"><p class="hf-section-kicker">Próximo passo</p><h2>@pending.Name</h2><p class="text-muted">Você tem @(Math.Max((Model?.ActiveHabits ?? 0) - doneToday, 0)) hábitos para concluir hoje.</p></section>} else {<section class="hf-guided-card mb-4"><p class="hf-section-kicker">Tudo concluído</p><h2>Excelente. Você completou todos os hábitos de hoje.</h2><p>Veja seu progresso ou planeje um novo hábito para continuar evoluindo.</p><a class="btn btn-outline-success" href="/progress">Ver progresso</a></section>}
<section class="hf-grid mb-4"><div class="hf-col-3 hf-metric-card"><span>Hábitos de hoje</span><strong>@(Model?.ActiveHabits ?? 0)</strong><small>ativos na rotina</small></div><div class="hf-col-3 hf-metric-card"><span>Concluídos</span><strong>@doneToday</strong><small>marcados hoje</small></div><div class="hf-col-3 hf-metric-card"><span>Progresso do dia</span><strong>@(Model?.DayPercent ?? 0)%</strong><small>avance um passo</small></div><div class="hf-col-3 hf-metric-card" data-tour="streak"><span>Sequência</span><strong>@(Model?.BestStreak ?? 0)</strong><small>dias</small></div></section>
<div class="row g-4"><section class="col-lg-8" data-tour="habit-list"><h2 class="h4 mb-3">Hábitos de hoje</h2><div class="d-grid gap-3">@foreach(var h in habits){@await Html.PartialAsync("~/Views/Shared/Partials/_HabitCard.cshtml", h)}</div></section><aside class="col-lg-4"><div data-tour="reports" class="mb-3">@await Html.PartialAsync("~/Views/Shared/Partials/_FirstStepsChecklist.cshtml", null, new ViewDataDictionary(ViewData){{"HasHabits",habits.Any()},{"HasDone",doneToday > 0}})</div><div class="hf-card"><h2 class="h5">Progresso do dia</h2><div class="progress my-3"><div class="progress-bar" style="width:@(Model?.DayPercent ?? 0)%"></div></div><p class="text-muted mb-0">Acompanhe a evolução ao longo dos dias em relatórios simples.</p></div></aside></div>
@await Html.PartialAsync("~/Views/Shared/Partials/_GuidedTour.cshtml")
