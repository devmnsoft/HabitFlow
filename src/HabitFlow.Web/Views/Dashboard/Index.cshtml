@model HabitFlow.Application.DashboardDto?
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Dashboard"; var habits = Model?.Habits ?? Array.Empty<HabitFlow.Application.HabitDto>(); var today = DateTime.UtcNow.ToString("dd/MM/yyyy"); }
<header class="hf-page-header"><div><p class="hf-eyebrow">@today</p><h1>Olá, @(Model?.Name ?? "vamos começar") 👋</h1><p>Seu painel de consistência diária com próximos passos e hábitos devidos hoje.</p></div><a class="btn btn-success btn-lg" href="/habits">Novo hábito</a></header>
<section class="hf-grid mb-4"><div class="hf-col-3 hf-metric-card"><span>Hábitos de hoje</span><strong>@(Model?.ActiveHabits ?? 0)</strong><small>ativos na rotina</small></div><div class="hf-col-3 hf-metric-card"><span>Concluídos</span><strong>@(Model?.DoneToday ?? 0)</strong><small>marcados hoje</small></div><div class="hf-col-3 hf-metric-card"><span>Percentual do dia</span><strong>@(Model?.DayPercent ?? 0)%</strong><small>avance um passo</small></div><div class="hf-col-3 hf-metric-card"><span>Melhor sequência</span><strong>@(Model?.BestStreak ?? 0)</strong><small>dias</small></div></section>
<div class="row g-4"><section class="col-lg-8"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Hábitos devidos hoje</h2><span class="hf-badge">Próximo sugerido: @(habits.FirstOrDefault(x=>!x.DoneToday)?.Name ?? "Beber água")</span></div><div class="d-grid gap-3">@foreach(var h in habits){@await Html.PartialAsync("~/Views/Shared/Partials/_HabitCard.cshtml", h)}@if(!habits.Any()){ViewData["Title"]="Comece pequeno. Escolha um hábito simples para hoje.";ViewData["Message"]="Sugestões: Beber água, ler 10 minutos, caminhar, estudar ou dormir mais cedo.";ViewData["ActionHref"]="/habits";ViewData["ActionText"]="Criar primeiro hábito";@await Html.PartialAsync("~/Views/Shared/Partials/_EmptyState.cshtml")}</div></section><aside class="col-lg-4"><div class="hf-card mb-3"><h2 class="h5">Progresso do dia</h2><div class="progress my-3"><div class="progress-bar" style="width:@(Model?.DayPercent ?? 0)%"></div></div><p class="text-muted mb-0">Marque o próximo hábito para manter o fluxo.</p></div><div class="hf-card"><h2 class="h5">Notificações recentes</h2><ul class="list-unstyled mb-0"><li>✓ Seus lembretes aparecerão aqui.</li><li>✓ Relatórios semanais ajudam a ajustar a rota.</li></ul></div></aside></div>
