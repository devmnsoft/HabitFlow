@model HabitFlow.Domain.LegalDocumentVersion
@{ ViewData["Title"] = Model.Title; }
@section Styles { <link rel="stylesheet" href="~/css/legal-pages.css" asp-append-version="true" /> }
<div class="legal-page"><header class="legal-hero"><div><span class="legal-eyebrow">Documento oficial publicado</span><h1>@Model.Title</h1><p>@Model.Summary</p><div class="legal-actions"><button class="btn btn-outline-success" data-legal-print>Imprimir</button>@if(User.Identity?.IsAuthenticated==true&&Model.Title.Contains("Privacidade",StringComparison.OrdinalIgnoreCase)){<a class="btn btn-success" href="/account/privacy">Gerenciar meus dados</a>}</div></div><div class="legal-version"><span>Versão @Model.Version</span><strong>Vigente desde @Model.EffectiveAt.ToString("dd/MM/yyyy")</strong><small>Leitura aproximada: @Math.Max(1, Model.SanitizedContent.Split(' ').Length / 200) min</small></div></header><article class="legal-article legal-published">@Html.Raw(Model.SanitizedContent)<footer class="legal-contact"><a href="/terms">Termos</a> · <a href="/legal/cookies">Cookies</a>@if(!string.IsNullOrWhiteSpace((string?)ViewBag.PrivacyContactEmail)){<span> · <a href="mailto:@ViewBag.PrivacyContactEmail">Contato de privacidade</a></span>}</footer></article></div>
@section Scripts { <script src="~/js/legal-pages.js" asp-append-version="true"></script> }
