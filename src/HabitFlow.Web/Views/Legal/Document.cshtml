@model HabitFlow.Domain.LegalDocumentVersion
@{ ViewData["Title"] = Model.Title; var isPrivacy = ViewBag.LegalDocumentType == HabitFlow.Domain.LegalDocumentType.PrivacyNotice; }
@section Styles { <link rel="stylesheet" href="~/css/legal-pages.css" asp-append-version="true" /> }
<div class="legal-page"><header class="legal-hero"><div><span class="legal-eyebrow">Documento oficial publicado</span><h1>@Model.Title</h1><p>@Model.Summary</p><div class="legal-actions"><button class="btn btn-outline-success" data-legal-print>Imprimir</button>@if(User.Identity?.IsAuthenticated==true&&isPrivacy){<a class="btn btn-success" href="/account/privacy">Gerenciar meus dados</a>}else if(isPrivacy){<a class="btn btn-success" href="/register">Criar conta com confiança</a>}</div></div><div class="legal-version"><span>Versão @Model.Version</span><strong>Vigente desde @Model.EffectiveAt.ToString("dd/MM/yyyy")</strong><small>Leitura aproximada: @Math.Max(1, Model.SanitizedContent.Split(' ').Length / 200) min</small></div></header>
@if(isPrivacy){<nav class="legal-published-summary" aria-label="Sumário da política"><a href="#quem-somos">Quem somos</a><a href="#dados-tratados">Dados tratados</a><a href="#finalidades">Finalidades</a><a href="#direitos">Seus direitos</a><a href="#como-solicitar">Como solicitar</a><a href="#contato">Contato</a></nav>}
<article class="legal-article legal-published">@Html.Raw(Model.SanitizedContent)@if(isPrivacy){<aside class="legal-actions" aria-label="Ajuda sobre privacidade"><button class="legal-info-button" type="button" data-info-title="O que são dados de uso?" data-info-text="São registros técnicos de acesso e interação usados para segurança, diagnóstico de falhas e melhoria do serviço.">O que são dados de uso?</button><button class="legal-info-button" type="button" data-info-title="Como solicitar meus dados?" data-info-text="Use a Central de Privacidade da sua conta ou o canal de suporte configurado. Confirmaremos sua identidade antes do atendimento.">Como solicitar meus dados?</button><button class="legal-info-button" type="button" data-info-title="Como pedir exclusão?" data-info-text="Abra uma solicitação na Central de Privacidade. Antes de concluir, informaremos se algum dado precisa ser mantido por obrigação legal.">Como pedir exclusão?</button></aside>}<footer class="legal-contact"><a href="/terms">Termos</a> · <a href="/legal/cookies">Cookies</a>@if(!string.IsNullOrWhiteSpace((string?)ViewBag.PrivacyContactEmail)){<span> · <a href="mailto:@ViewBag.PrivacyContactEmail">Contato de privacidade</a></span>}else if(!string.IsNullOrWhiteSpace((string?)ViewBag.SupportEmail)){<span> · <a href="mailto:@ViewBag.SupportEmail">Suporte</a></span>}</footer></article></div>
@section Scripts { <script src="~/js/legal-pages.js" asp-append-version="true"></script> }
