@model HabitFlow.Domain.LegalDocumentVersion
@{ ViewData["Title"] = Model.Title; }
<main class="container py-5 legal-document">
  <article class="card border-0 shadow-sm mx-auto" style="max-width: 920px">
    <header class="card-body p-4 p-lg-5 border-bottom">
      <span class="badge text-bg-primary mb-3">Versão @Model.Version</span>
      <h1 class="display-6 fw-bold">@Model.Title</h1>
      <p class="lead text-body-secondary mb-2">@Model.Summary</p>
      <small class="text-body-secondary">Vigente desde @Model.EffectiveAt.ToString("dd/MM/yyyy") · leitura aproximada de @Math.Max(1, Model.SanitizedContent.Split(' ').Length / 200) min</small>
    </header>
    <div class="card-body p-4 p-lg-5 legal-content">@Html.Raw(Model.SanitizedContent)</div>
    <footer class="card-body p-4 border-top d-flex flex-wrap gap-2">
      <button class="btn btn-outline-primary" type="button" onclick="window.print()">Imprimir</button>
      <a class="btn btn-link" href="mailto:@(ViewBag.PrivacyContactEmail)">Contato de privacidade</a>
    </footer>
  </article>
</main>
