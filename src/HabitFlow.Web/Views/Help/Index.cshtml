@{ ViewData["Title"] = "Como usar o HabitFlow"; var cards = new[]{("Primeiros passos","/help/getting-started","guide"),("Criar hábitos","/help/habits","habit"),("Acompanhar progresso","/help/progress","progress"),("Entender relatórios","/help/reports","report"),("Plano gratuito e Premium","/help/premium","premium"),("Privacidade e LGPD","/help/privacy","lgpd"),("Falar com suporte","/help/support","support")}; }
<section class="hf-page-header"><div><p class="hf-section-kicker">Central de Ajuda</p><h1>Como usar o HabitFlow</h1><p>Aprenda o básico em poucos minutos.</p></div>@await Html.PartialAsync("~/Views/Shared/Partials/Illustrations/_SupportIllustration.cshtml")</section>
<div class="row g-3">@foreach (var c in cards){<div class="col-md-6 col-xl-4"><a class="hf-help-card h-100" href="@c.Item2">@await Html.PartialAsync("~/Views/Shared/Partials/Icons/_Icon.cshtml", null, new ViewDataDictionary(ViewData){{"Name",c.Item3},{"Class","hf-icon-lg"}})<span>@c.Item1</span><small>Ler guia rápido</small></a></div>}</div>
@if (User.Identity?.IsAuthenticated == true)
{
  <form method="post" action="/product-tips/reopen" class="mt-4">
    @Html.AntiForgeryToken()
    <button class="btn btn-outline-primary" type="submit">Reabrir guia de primeiro uso</button>
  </form>
}
