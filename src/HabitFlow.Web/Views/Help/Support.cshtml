@{ ViewData["Title"] = "Ajuda HabitFlow"; }
<section class="hf-help-article">
  <p class="hf-section-kicker">Manual do usuário</p>
  <h1>Falar com suporte</h1>
  <p class="lead">Use esta página como um guia simples para avançar no HabitFlow sem linguagem técnica.</p>
  <ol class="hf-readable-list">
    <li>Entre na sua conta ou crie uma conta gratuita.</li>
    <li>Escolha um objetivo e adicione hábitos prontos quando quiser começar rápido.</li>
    <li>Abra seu painel diário, marque o que concluiu e acompanhe sua sequência.</li>
    <li>Use relatórios, planos e suporte quando precisar evoluir sua rotina com mais segurança.</li>
  </ol>
  <a class="btn btn-success" href="/dashboard">Ir para meu painel</a> <a class="btn btn-outline-success" href="/help">Voltar para a Central de Ajuda</a>
</section>
