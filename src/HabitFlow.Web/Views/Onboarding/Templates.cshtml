@model (HabitFlow.Domain.HabitObjective Objective, IReadOnlyList<HabitFlow.Domain.HabitTemplate> Templates)
@{ ViewData["Title"] = "Sugestões para começar"; }
<main class="hf-onboarding"><header class="hf-onboarding-hero"><div><p class="hf-section-kicker">@Model.Objective.Name</p><h1>Escolha uma sugestão para personalizar</h1><p>Nada será criado ainda. Na próxima tela você revisa nome, frequência, dias, horário e objetivo.</p></div><span class="hf-step-count">Etapa 2 de 6</span></header><div class="hf-progress-track" role="progressbar" aria-valuenow="2" aria-valuemin="1" aria-valuemax="6"><span style="width:33.33%"></span></div>
<section class="hf-template-grid">@foreach (var template in Model.Templates) {<article class="hf-template-card"><div class="hf-template-card__top"><span class="hf-chip">@template.Difficulty</span>@if(template.EstimatedTimeMinutes is not null){<span class="hf-chip">@template.EstimatedTimeMinutes min</span>}</div><h2>@template.Name</h2><p>@template.Description</p><dl><div><dt>Por que ajuda</dt><dd>@(template.WhyItHelps ?? template.BenefitText)</dd></div><div><dt>Primeiro passo</dt><dd>@(template.FirstAction ?? template.HowToStart)</dd></div></dl><footer><a class="btn btn-success" href="/habit-library/templates/@template.Id/customize?onboarding=true">Personalizar antes de criar</a></footer></article>}</section>
<footer class="hf-onboarding-footer"><a class="btn btn-outline-success" href="/onboarding">← Voltar</a><form method="post" action="/onboarding/skip">@Html.AntiForgeryToken()<button class="btn btn-link">Pular por agora</button></form></footer></main>
