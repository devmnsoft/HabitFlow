@model IReadOnlyList<HabitFlow.Web.Models.PlanFaqItemViewModel>
<section class="plans-section faq-section" aria-labelledby="faq-title"><div class="plans-heading"><span>Antes de decidir</span><h2 id="faq-title">Perguntas frequentes</h2></div><div class="accordion" id="plansFaq">@for(var i=0;i<Model.Count;i++){var item=Model[i];<div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-@i" aria-expanded="false" aria-controls="faq-@i">@item.Question</button></h3><div id="faq-@i" class="accordion-collapse collapse" data-bs-parent="#plansFaq"><div class="accordion-body">@item.Answer</div></div></div>}</div></section>
