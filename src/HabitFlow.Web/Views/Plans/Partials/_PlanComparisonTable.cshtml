@model IReadOnlyList<HabitFlow.Web.Models.PlanComparisonRowViewModel>
<section class="plans-section" id="comparacao" aria-labelledby="comparison-title"><div class="plans-heading"><span>Sem letras miúdas</span><h2 id="comparison-title">Compare todos os recursos</h2><p>Mensal e anual liberam os mesmos recursos Premium; muda apenas o ciclo e o valor do catálogo.</p></div><div class="comparison-wrap"><table><thead><tr><th>Recurso</th><th>Free</th><th>Premium mensal</th><th>Premium anual</th></tr></thead><tbody>@foreach(var row in Model){<tr><th>@row.Benefit @if(row.HelpText is not null){<button type="button" class="info-dot" aria-label="Saiba mais sobre @row.Benefit" data-info-title="@row.Benefit" data-info-text="@row.HelpText">i</button>}</th><td data-label="Free">@row.Free</td><td data-label="Premium mensal"><strong>@row.Ritmo</strong></td><td data-label="Premium anual"><strong>@row.Ritmo</strong></td></tr>}</tbody></table></div></section>
