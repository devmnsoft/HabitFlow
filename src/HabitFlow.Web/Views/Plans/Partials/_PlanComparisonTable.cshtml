@model IReadOnlyList<HabitFlow.Web.Models.PlanComparisonRowViewModel>
<section class="plans-section" id="comparacao" aria-labelledby="comparison-title"><div class="plans-heading"><span>Sem letras miúdas</span><h2 id="comparison-title">O que muda quando você assina</h2></div><div class="comparison-wrap"><table><thead><tr><th>Benefício</th><th>Gratuito</th><th>Ritmo</th></tr></thead><tbody>@foreach(var row in Model){<tr><th>@row.Benefit @if(row.HelpText is not null){<button class="info-dot" aria-label="O que significa @row.Benefit?" data-info-title="O que significa @row.Benefit?" data-info-text="@row.HelpText">i</button>}</th><td>@row.Free</td><td><strong>@row.Ritmo</strong></td></tr>}</tbody></table></div></section>
