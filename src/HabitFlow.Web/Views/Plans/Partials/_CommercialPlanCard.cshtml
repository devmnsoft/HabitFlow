@model HabitFlow.Web.Models.CommercialPlanCardViewModel
@{ var viewer=(HabitFlow.Web.Models.PlanViewerViewModel?)ViewData["PlanViewer"] ?? HabitFlow.Web.Models.PlanViewerViewModel.Visitor; var free=Model.Code==HabitFlow.Domain.PlanCodes.Free; var cycles=free ? new[]{("Free", "Grátis", "para sempre")} : new[]{("Monthly", Model.MonthlyPrice, "cobrado mensalmente"),("Yearly", Model.YearlyPrice, "cobrado anualmente")}.Where(x=>x.Item2 is not null).ToArray(); }
@foreach(var cycle in cycles){var current=viewer.IsCurrent(Model.Code, free?null:cycle.Item1) && (free || viewer.Status is "Ativo" or "Cancelamento agendado" or "Pagamento pendente"); var annual=cycle.Item1=="Yearly";
<article class="commercial-plan @(Model.Featured && annual ? "featured" : "") @(current?"is-current":"")" id="@(free?Model.Code:$"{Model.Code}-{cycle.Item1.ToLowerInvariant()}")" tabindex="0">
 <header>@if(current){<span class="current-badge">Plano atual</span>}else if(annual && Model.YearlySaving is not null){<span class="plan-badge">@Model.YearlySaving</span>}else if(Model.Featured && !free){<span class="plan-badge">Premium</span>}<p class="plan-audience">@(free?Model.Audience:annual?"Para avançar economizando":"Para evoluir com flexibilidade")</p><h3>@Model.Name @(free?null:annual?"Anual":"Mensal")</h3><p>@Model.Description</p></header>
 <div class="plan-price"><strong>@cycle.Item2</strong><small>@cycle.Item3</small></div>
 <ul>@foreach(var benefit in Model.Benefits){<li><span aria-hidden="true">✓</span>@benefit</li>}</ul>
 @if(current){<a class="btn btn-outline-success btn-lg w-100" href="/account/plan/usage">Ver meu plano</a>}
 else if(free){<a class="btn btn-outline-success btn-lg w-100" href="@(viewer.IsAuthenticated?"/dashboard":"/register")" data-plan-cta="free">@(viewer.IsAuthenticated?"Continuar grátis":"Criar conta grátis")</a>}
 else if(viewer.IsAuthenticated && Model.CheckoutEligible){<form action="/billing/checkout" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="@Model.Code"/><input type="hidden" name="billingCycle" value="@cycle.Item1"/><button class="btn btn-success btn-lg w-100" type="submit" data-plan-cta="@Model.Code">Assinar Premium @((annual)?"anual":"mensal")</button></form>}
 else if(Model.CheckoutEligible){<a class="btn btn-success btn-lg w-100" href="/login?returnUrl=@Uri.EscapeDataString($"/plans#{Model.Code}-{cycle.Item1.ToLowerInvariant()}")" data-plan-cta="@Model.Code">Entrar para assinar</a>}
 else{<a class="btn btn-outline-success btn-lg w-100" href="/support">Avisar quando disponível</a>}
</article>}
