@model HabitFlow.Web.Models.CommercialPlanCardViewModel
<article class="commercial-plan @(Model.Featured ? "featured" : "")" id="@Model.Code"><header>@if(!string.IsNullOrWhiteSpace(Model.Badge)){<span class="plan-badge">@Model.Badge</span>}<p>@Model.Audience</p><h3>@Model.Name</h3><p>@Model.Description</p></header><div class="plan-price">@if(Model.Code=="free"){<strong>Grátis</strong><small>para começar sem cartão</small>}else if(Model.MonthlyPrice is not null || Model.YearlyPrice is not null){<strong data-plan-monthly="@Model.MonthlyPrice" data-plan-yearly="@Model.YearlyPrice">@(Model.MonthlyPrice ?? Model.YearlyPrice)</strong>@if(Model.YearlySaving is not null){<small data-yearly-saving hidden>@Model.YearlySaving no anual</small>}}else{<strong class="unavailable">Plano temporariamente indisponível</strong>}</div><ul>@foreach(var benefit in Model.Benefits){<li><span aria-hidden="true">✓</span>@benefit</li>}</ul>@if(Model.CheckoutEligible && Model.Code != "free" && User.Identity?.IsAuthenticated == true){<form action="/billing/checkout" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="@Model.Code"/><input class="js-cycle-input" type="hidden" name="billingCycle" value="@(Model.MonthlyPrice is null ? "Yearly" : "Monthly")"/><button class="btn btn-success btn-lg w-100" type="submit" data-plan-cta="@Model.Code">@Model.CtaLabel</button></form>}else if(Model.CheckoutEligible){var ctaUrl = Model.Code == "free" && User.Identity?.IsAuthenticated == true ? "/account/plan/usage" : Model.CtaUrl; var ctaLabel = Model.Code == "free" && User.Identity?.IsAuthenticated == true ? "Ver meu plano" : Model.CtaLabel;<a class="btn @(Model.Featured ? "btn-success" : "btn-outline-success") btn-lg w-100" href="@ctaUrl" data-register-cycle="@(Model.Code == "free" ? null : Model.Code)" data-plan-cta="@Model.Code">@ctaLabel</a>}else{<p class="plan-unavailable">Avisaremos quando novas assinaturas estiverem disponíveis.</p>}@if(Model.Code=="ritmo"){<button class="info-trigger" type="button" data-info-title="O que muda no Ritmo?" data-info-text="O Ritmo amplia somente os limites e recursos implementados exibidos nesta página.">O que muda no Ritmo?</button>}</article>
