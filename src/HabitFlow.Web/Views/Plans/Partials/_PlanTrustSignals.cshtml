@model IReadOnlyList<HabitFlow.Web.Models.PlanTrustSignalViewModel>
<section class="plans-section trust-section" aria-labelledby="trust-title"><div class="plans-heading"><span>Confiança em cada etapa</span><h2 id="trust-title">Feito para sua rotina, com cuidado com seus dados</h2></div><div class="trust-grid">@foreach(var item in Model){<article><span aria-hidden="true">✓</span><div><h3>@item.Title</h3><p>@item.Description</p></div></article>}</div><button class="info-trigger" data-info-title="Como protegemos seus dados?" data-info-text="Aplicamos controles de sessão, acesso restrito e uma Central de Privacidade. Consulte nossa política para conhecer os detalhes.">Como protegemos seus dados?</button></section>
