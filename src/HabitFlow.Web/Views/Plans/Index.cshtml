@model IReadOnlyList<HabitFlow.Domain.PublicPlan>
@{ ViewData["Title"]="Planos"; }
<section class="hf-section hf-guided-card text-center"><p class="hf-section-kicker">Seu próximo passo</p><h1>Escolha o ritmo que combina com você.</h1><p class="lead">Comece gratuitamente e avance quando sua rotina pedir mais.</p><partial name="_PlanBillingToggle"/></section>
<div class="row g-3 align-items-stretch">@foreach(var plan in Model){<div class="col-lg-6"><partial name="_PlanCard" model="plan"/></div>}</div>
<partial name="_PlanComparison" model="Model"/><partial name="_PlanQuestions"/>
@section Scripts {<script src="~/js/plan-catalog.js" asp-append-version="true"></script>}
