@model IReadOnlyList<HabitFlow.Domain.Plan>
@{ ViewData["Title"] = "Planos"; }
<section class="hf-section hf-guided-card"><p class="hf-section-kicker">Planos HabitFlow</p><h1>Comece grátis. Evolua quando sua rotina crescer.</h1><p class="lead">O gratuito é suficiente para começar. O Premium libera mais limites e recursos avançados quando você precisar.</p></section>
@await Html.PartialAsync("~/Views/Shared/Partials/_QuickHelpCard.cshtml", null, new ViewDataDictionary(ViewData){{"Text","O gratuito é suficiente para começar. O Premium libera mais limites e recursos avançados."}})
<div class="row g-3"><div class="col-md-6"><article class="hf-premium-card h-100"><span class="hf-plan-badge">Gratuito</span><h2>Para começar com foco.</h2><ul><li>Até 5 hábitos ativos</li><li>Dashboard diário</li><li>Sequência</li><li>Relatórios básicos</li><li>Biblioteca de hábitos</li></ul><a class="btn btn-outline-success w-100" href="/register">Começar grátis</a></article></div><div class="col-md-6"><article class="hf-premium-card h-100"><span class="hf-plan-badge">Premium</span><h2>Para acompanhar mais hábitos e relatórios avançados.</h2><ul><li>Hábitos ilimitados</li><li>Relatórios avançados</li><li>Mais liberdade</li><li>Recursos futuros</li><li>Suporte</li></ul>@{ var premium = Model.FirstOrDefault(p => p.Code.StartsWith("premium")); }@if (premium is not null){<form asp-controller="Billing" asp-action="Checkout" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="@premium.Code"/><input type="hidden" name="billingCycle" value="@(premium.Code.EndsWith("yearly") ? "Yearly" : "Monthly")"/><button class="btn btn-success w-100" type="submit">Assinar Premium</button></form>}else{<a class="btn btn-success w-100" href="/billing">Assinar Premium</a>}</article></div></div>
<section class="hf-section hf-card"><h2>FAQ rápida</h2><details><summary>Preciso pagar para começar?</summary><p>Não. Você pode iniciar no plano gratuito.</p></details><details><summary>O que acontece se eu atingir 5 hábitos?</summary><p>Você pode arquivar um hábito ou evoluir para Premium.</p></details><details><summary>Posso cancelar?</summary><p>Sim, quando o faturamento Premium estiver ativo para sua conta.</p></details><details><summary>Meus dados ficam seguros?</summary><p>O HabitFlow segue boas práticas de segurança e LGPD.</p></details></section>
