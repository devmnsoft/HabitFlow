@model IReadOnlyList<HabitFlow.Domain.Plan>
@{ ViewData["Title"] = "Planos"; }
<section class="hf-section hf-guided-card"><p class="hf-section-kicker">Planos HabitFlow</p><h1>Comece grátis e evolua quando precisar.</h1><p class="lead">O plano gratuito permite acompanhar até 5 hábitos ativos. É o suficiente para começar com foco.</p></section>
<div class="row g-3"><div class="col-md-6"><article class="hf-premium-card h-100"><span class="hf-plan-badge">Gratuito</span><h2>Para começar</h2><ul><li>5 hábitos ativos</li><li>Dashboard diário</li><li>Sequência</li><li>Relatórios básicos</li><li>Biblioteca de hábitos</li></ul><a class="btn btn-outline-success w-100" href="/register">Começar grátis</a></article></div><div class="col-md-6"><article class="hf-premium-card h-100"><span class="hf-plan-badge">Premium</span><h2>Para evoluir sem limites</h2><ul><li>Hábitos ilimitados</li><li>Relatórios avançados</li><li>Mais objetivos</li><li>Recursos futuros</li><li>Suporte prioritário, quando aplicável</li></ul>@{ var premium = Model.FirstOrDefault(p => p.Code.StartsWith("premium")); }@if (premium is not null){<form asp-controller="Billing" asp-action="Checkout" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="@premium.Code"/><input type="hidden" name="billingCycle" value="@(premium.Code.EndsWith("yearly") ? "Yearly" : "Monthly")"/><button class="btn btn-success w-100" type="submit">Assinar Premium</button></form>}else{<a class="btn btn-success w-100" href="/billing">Assinar Premium</a>}</article></div></div>
