@model IReadOnlyList<HabitFlow.Domain.Plan>
@{ ViewData["Title"] = "Planos"; var isAuth = User?.Identity?.IsAuthenticated == true; var monthly = Model.FirstOrDefault(p => p.Code.Contains("monthly", StringComparison.OrdinalIgnoreCase) || p.Code.Contains("mensal", StringComparison.OrdinalIgnoreCase)); var yearly = Model.FirstOrDefault(p => p.Code.Contains("yearly", StringComparison.OrdinalIgnoreCase) || p.Code.Contains("anual", StringComparison.OrdinalIgnoreCase)); var monthlyCode = monthly?.Code ?? "premium_monthly"; var yearlyCode = yearly?.Code ?? "premium_yearly"; }
<section class="hf-section hf-guided-card"><p class="hf-section-kicker">Planos HabitFlow</p><h1>Comece grátis. Evolua quando sua rotina crescer.</h1><p class="lead">O HabitFlow pode ser usado gratuitamente para acompanhar seus primeiros hábitos. O Premium libera mais liberdade e relatórios avançados.</p></section>
@if (ViewBag.ShowSandbox == true) { <div class="alert alert-info">Checkout em modo Sandbox para testes seguros.</div> }
<div class="row g-3">
  <div class="col-lg-4"><article class="hf-premium-card h-100"><span class="hf-plan-badge">Gratuito</span><h2>Para começar com foco.</h2><ul><li>Até 5 hábitos ativos</li><li>Dashboard diário</li><li>Sequência</li><li>Biblioteca de hábitos</li><li>Relatórios básicos</li></ul><a class="btn btn-outline-success w-100" href="@(isAuth ? "/dashboard" : "/register")">Começar grátis</a><a class="btn btn-link w-100" href="/login">Entrar</a></article></div>
  <div class="col-lg-4"><article class="hf-premium-card h-100"><span class="hf-plan-badge">Premium Mensal</span><h2>Mais liberdade mês a mês.</h2><ul><li>Hábitos ilimitados</li><li>Relatórios avançados</li><li>Mais categorias</li><li>Recursos de evolução</li><li>Suporte prioritário</li></ul>@if (isAuth) { <form asp-controller="Billing" asp-action="Checkout" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="@monthlyCode"/><input type="hidden" name="billingCycle" value="Monthly"/><button class="btn btn-success w-100" type="submit">Assinar Premium</button></form> } else { <a class="btn btn-success w-100" href="/register?intent=@monthlyCode">Assinar Premium</a> }</article></div>
  <div class="col-lg-4"><article class="hf-premium-card h-100 border-success"><span class="hf-plan-badge">Premium Anual</span><h2>Melhor custo-benefício.</h2><ul><li>Mesmos benefícios do Premium</li><li>Pagamento anual</li><li>Menos interrupções</li><li>Relatórios avançados</li><li>Hábitos ilimitados</li></ul>@if (isAuth) { <form asp-controller="Billing" asp-action="Checkout" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="@yearlyCode"/><input type="hidden" name="billingCycle" value="Yearly"/><button class="btn btn-success w-100" type="submit">Assinar Premium</button></form> } else { <a class="btn btn-success w-100" href="/register?intent=@yearlyCode">Assinar Premium</a> }</article></div>
</div>
<section class="hf-section hf-card"><h2>FAQ pública</h2><details><summary>Preciso pagar para começar?</summary><p>Não. Você pode iniciar gratuitamente e acompanhar seus primeiros hábitos.</p></details><details><summary>O que acontece se eu chegar a 5 hábitos?</summary><p>Você pode arquivar um hábito ou evoluir para Premium.</p></details><details><summary>Posso cancelar?</summary><p>Sim. O Premium pode ser cancelado conforme as regras do checkout contratado.</p></details><details><summary>Meus dados ficam seguros?</summary><p>Aplicamos boas práticas de segurança, auditoria e LGPD.</p></details></section>
