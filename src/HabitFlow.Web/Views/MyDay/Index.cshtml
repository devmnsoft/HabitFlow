@model DailyRoutineViewModel
@{ ViewData["Title"] = "Meu dia"; }
@section Styles { <link rel="stylesheet" href="~/css/my-day-v3.css" asp-append-version="true" /> }
<main class="my-day-v3 container" data-my-day>
  <partial name="Partials/_MyDayHero" model="Model" />
  <partial name="Partials/_RoutineProgressSummary" model="Model" />
  <partial name="Partials/_DailyCommandCenter" model="Model" />
  @if (Model.Groups.Count == 0)
  {
    <partial name="Partials/_RoutineEmptyState" />
  }
  else
  {
    <div class="routine-timeline" aria-label="Linha do tempo de hoje">
      @foreach (var group in Model.Groups) { <partial name="Partials/_RoutinePeriodGroup" model="group" /> }
    </div>
  }
  <partial name="Partials/_RoutineMoveModal" />
  <partial name="Partials/_RoutinePauseModal" />
  <partial name="Partials/_RoutineRestoreModal" />
  <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-routine-status></div>
</main>
@section Scripts { <script src="~/js/my-day-v3.js" asp-append-version="true"></script> }
