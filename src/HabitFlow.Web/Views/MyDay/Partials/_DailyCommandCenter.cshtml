@model DailyRoutineViewModel
<section class="daily-command" aria-label="Resumo inteligente do dia">
  <article class="daily-command__card daily-command__card--insight">
    <span class="daily-command__eyebrow">Meu próximo passo</span>
    @if (Model.NextSteps.Count == 0)
    {
      <h2>@(Model.FocusHabitName is null ? "Prepare um pequeno avanço" : $"Comece por {Model.FocusHabitName}")</h2>
      <p>@(Model.Pending == 0 ? "Seu planejamento está em dia. Aproveite para revisar o período." : "Concluir a menor ação agora reduz a carga mental e cria ritmo para o restante do dia.")</p>
    }
    else
    {
      var step = Model.NextSteps[0];
      <h2>@step.Title</h2>
      <p>@step.Reason</p>
      <div class="daily-step-actions">
        <a class="btn btn-success" href="@step.DestinationUrl">@step.ActionLabel</a>
        @if (step.CanDismiss)
        {
          <form method="post" action="/my-day/next-step/dismiss">
            @Html.AntiForgeryToken()
            <input type="hidden" name="key" value="@step.Key" />
            <button class="btn btn-outline-success" type="submit">Dispensar</button>
          </form>
        }
      </div>
      <small>Origem: @step.Source. Dispensar não altera agenda, meta ou sessão.</small>
    }
  </article>
  <article class="daily-command__card">
    <span class="daily-command__eyebrow">Sinais de hoje</span>
    <dl class="daily-signals"><div><dt>Sequência atual</dt><dd>@Model.CurrentStreak dia@(Model.CurrentStreak == 1 ? "" : "s")</dd></div><div><dt>Atrasos</dt><dd class="@(Model.Overdue > 0 ? "is-alert" : null)">@Model.Overdue</dd></div><div><dt>Próximo lembrete</dt><dd>@(Model.NextActions.FirstOrDefault(x => x.PreferredTime.HasValue)?.PreferredTime?.ToString("HH:mm") ?? "Sem horário")</dd></div></dl>
    <a class="daily-command__link" href="/reminders">Configurar lembretes</a>
  </article>
  <article class="daily-command__card daily-command__card--wide">
    <div><span class="daily-command__eyebrow">Próximas ações</span><h2>Um passo de cada vez</h2></div>
    @if (Model.NextActions.Count == 0) { <p>Nenhuma pendência ativa para hoje.</p> }
    else { <ol class="daily-next">@foreach (var action in Model.NextActions) { <li><span style="--habit-color:@action.Color"></span><strong>@action.Name</strong><small>@(action.EstimatedMinutes > 0 ? $"{action.EstimatedMinutes} min" : "sem duração")</small></li> }</ol> }
    <a class="btn btn-success" href="/habits/create">Criar novo hábito</a>
  </article>
  <article class="daily-command__card daily-command__card--wide">
    <div><span class="daily-command__eyebrow">Rotina que cabe no dia</span><h2>Informe sua disponibilidade</h2></div>
    <form class="daily-availability" method="get" action="/my-day">
      <label>Tempo disponível <input type="number" name="availableMinutes" min="1" max="1440" placeholder="min" value="@Model.Proposal?.AvailableMinutes" /></label>
      <label>Início <input type="time" name="windowStart" /></label>
      <label>Fim <input type="time" name="windowEnd" /></label>
      <label class="daily-check"><input type="checkbox" name="preferMinimumVersion" value="true" /> Preferir versão mínima</label>
      <button class="btn btn-outline-success" type="submit">Gerar proposta</button>
    </form>
    @if (Model.Proposal is not null)
    {
      <div class="daily-proposal" aria-label="Proposta determinística de rotina">
        <p><strong>@Model.Proposal.KnownEstimatedMinutes min conhecidos</strong>@(Model.Proposal.AvailableMinutes.HasValue ? $" de {Model.Proposal.AvailableMinutes} min disponíveis" : " sem limite de tempo informado").</p>
        @if (Model.Proposal.ExceedsAvailability) { <p class="daily-proposal__alert">A proposta passa do tempo informado porque itens mantidos pelo usuário não foram removidos.</p> }
        <ol class="daily-next">
          @foreach (var item in Model.Proposal.Items.Where(x => x.Included))
          {
            <li><span></span><strong>@item.Name</strong><small>@(item.EstimatedMinutes.HasValue ? $"{item.EstimatedMinutes} min" : "sem duração")@(item.UsesMinimumVersion ? " · mínimo" : "")</small></li>
          }
        </ol>
        @if (Model.Proposal.Alternatives.Count > 0) { <details><summary>Alternativas</summary><ul>@foreach (var text in Model.Proposal.Alternatives) { <li>@text</li> }</ul></details> }
        @if (Model.Proposal.MissingData.Count > 0) { <details><summary>Dados ausentes</summary><ul>@foreach (var text in Model.Proposal.MissingData) { <li>@text</li> }</ul></details> }
      </div>
    }
  </article>
  <article class="daily-command__card daily-command__card--wide">
    <div class="daily-week__header"><div><span class="daily-command__eyebrow">Resumo semanal</span><h2>Seu ritmo nos últimos 7 dias</h2></div><a href="/progress/calendar">Abrir calendário</a></div>
    <div class="daily-week">@foreach (var day in Model.WeeklyPulse) { <div class="@(day.IsToday ? "is-today" : null)"><span style="--pulse:@day.Percentage%"></span><small>@day.Label</small></div> }</div>
  </article>
  @if (Model.PlanLimitReached) { <aside class="daily-plan"><div><strong>Seu plano chegou ao limite</strong><p>Seus dados continuam seguros. Conheça os planos para criar novas rotinas.</p></div><a class="btn btn-light" href="/plans">Ver planos</a></aside> }
</section>
