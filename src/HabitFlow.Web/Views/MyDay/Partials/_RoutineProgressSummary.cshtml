@model DailyRoutineViewModel
<section class="routine-summary" aria-labelledby="routine-progress-title">
 <div><span class="routine-summary__kicker">Ritmo de hoje</span><h2 id="routine-progress-title">@Model.Completed de @Model.Scheduled passos concluídos</h2><div class="routine-summary__stats"><span><strong>@Model.Scheduled</strong> previstos</span><span><strong>@Model.Completed</strong> concluídos</span><span><strong>@Model.Pending</strong> pendentes</span></div>@if(Model.FocusHabitName is not null){<p><strong>Maior impacto no objetivo:</strong> comece por @Model.FocusHabitName.</p>}else{<p>@(Model.Scheduled == 0 ? "Hoje não há hábitos agendados." : "Comece pelo menor hábito para ganhar ritmo.")</p>}</div>
 <div class="routine-summary__meter"><strong>@Model.Percentage%</strong><div class="progress" role="progressbar" aria-label="Progresso diário" aria-valuenow="@Model.Percentage" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@Model.Percentage%"></div></div></div>
</section>
