@model HabitFlow.Shared.Result<HabitFlow.Application.PagedResult<HabitFlow.Application.AdminUserListItem>>
@{ ViewData["Title"]="Usuários Admin"; var users=Model?.Value?.Items ?? Array.Empty<HabitFlow.Application.AdminUserListItem>(); }
<div class="py-4"><h1>Usuários</h1><form class="row g-2 mb-3"><div class="col-md-6"><input name="Search" class="form-control" placeholder="Buscar nome/e-mail" /></div><div class="col"><button class="btn btn-success">Filtrar</button> <a class="btn btn-outline-secondary" href="/admin/exports/users">CSV</a></div></form><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Nome</th><th>E-mail</th><th>Plano</th><th>Status</th><th>Risco</th><th>Hábitos</th><th>Conclusões</th><th>Premium</th><th>Último login</th><th>Ações</th></tr></thead><tbody>@foreach(var u in users){<tr><td>@u.Name</td><td>@u.Email</td><td>@u.Plan/@u.PlanStatus</td><td><span class="badge bg-secondary">@u.AccountStatus</span></td><td>@u.RiskStatus</td><td>@u.ActiveHabits</td><td>@u.Completions</td><td>@(u.WantsPremiumNotice ? "Sim" : "Não")</td><td>@u.LastLoginAt</td><td><a class="btn btn-sm btn-outline-success" href="/admin/users/@u.Id">Detalhe</a></td></tr>}</tbody></table></div></div>
