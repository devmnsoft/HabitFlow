@model IReadOnlyList<HabitFlow.Domain.StructuredLogRow>
@{ ViewData["Title"]="Logs Operacionais"; }
@section Styles { <link rel="stylesheet" href="~/css/operations-v6194.css" asp-append-version="true" /> }
<main class="ops"><header class="ops-hero"><div><span class="ops-kicker">MNSOFT · Observabilidade segura</span><h1>Logs operacionais</h1><p>Eventos estruturados, correlacionáveis e sanitizados.</p></div><a class="ops-export" href="@($"{Context.Request.PathBase}/admin/logs/export{Context.Request.QueryString}")">Exportar CSV</a></header><nav class="ops-nav"><a href="/admin/operations">Operações</a><a href="/admin/system-health">Saúde do sistema</a><a aria-current="page" href="/admin/logs">Logs seguros</a></nav>
<form class="ops-filters" method="get"><label>De<input type="datetime-local" name="From" value="@Context.Request.Query["From"]" /></label><label>Até<input type="datetime-local" name="To" value="@Context.Request.Query["To"]" /></label><label>Cliente<select name="TenantId"><option value="">Todos os clientes</option>@foreach(var x in Model.Where(x=>x.TenantId!=null).DistinctBy(x=>x.TenantId)){<option value="@x.TenantId">@x.ClientName</option>}</select></label><label>Usuário<select name="UserId"><option value="">Todos os usuários</option>@foreach(var x in Model.Where(x=>x.UserId!=null).DistinctBy(x=>x.UserId)){<option value="@x.UserId">@x.UserName</option>}</select></label><label>Módulo<select name="Module"><option value="">Todos</option>@foreach(var x in Model.Select(x=>x.Module).Distinct()){<option>@x</option>}</select></label><label>Severidade<select name="Severity"><option value="">Todas</option>@foreach(var x in new[]{"Debug","Info","Warning","Error","Critical"}){<option>@x</option>}</select></label><label>Correlation ID<input name="CorrelationId" placeholder="Buscar correlação" /></label><button>Aplicar filtros</button></form>
<section class="ops-panel"><div class="ops-table-wrap"><table><thead><tr><th>Data</th><th>Severidade</th><th>Evento</th><th>Cliente / usuário</th><th>Módulo</th><th>Correlation ID</th><th></th></tr></thead><tbody>@foreach(var l in Model){<tr><td>@l.CreatedAt.ToString("dd/MM HH:mm:ss")</td><td><span class="risk">@l.Severity</span></td><td><b>@l.EventName</b><small>@l.Message</small></td><td>@(l.ClientName??"Plataforma")<small>@(l.UserName??"Sistema")</small></td><td>@l.Module</td><td><code>@l.CorrelationId</code></td><td><a href="/admin/logs/@l.Id">Detalhe</a></td></tr>}@if(Model.Count==0){<tr><td colspan="7" class="empty">Nenhum evento corresponde aos filtros. Ajuste o período ou aguarde novos eventos.</td></tr>}</tbody></table></div></section></main>
