@model HabitFlow.Domain.OperationsSnapshot
@{ ViewData["Title"]="Centro de Operações MNSOFT"; }
@section Styles { <link rel="stylesheet" href="~/css/operations-v6194.css" asp-append-version="true" /> }
<main class="ops"><header class="ops-hero"><div><span class="ops-kicker">MNSOFT · SaaS Command Center</span><h1>Centro de Operações</h1><p>Clientes, receita, confiabilidade e risco baseados nos dados operacionais.</p></div><div class="ops-health @Model.SystemStatus.ToLowerInvariant()"><span></span><b>@Model.SystemStatus</b><small>verificado @Model.CheckedAt.ToString("HH:mm") UTC</small></div></header>
<nav class="ops-nav"><a href="/admin/operations" aria-current="page">Operações</a><a href="/admin/system-health">Saúde do sistema</a><a href="/admin/logs">Logs seguros</a></nav>
<section class="ops-metrics" aria-label="Indicadores reais">
@foreach(var x in new[]{("Clientes",Model.TotalClients,"Total cadastrado"),("Ativos",Model.ActiveClients,"Clientes em operação"),("Bloqueados",Model.BlockedClients,"Requer atenção"),("Inadimplentes",Model.OverdueClients,"Cobrança vencida"),("Usuários ativos",Model.ActiveUsers,"Últimos 30 dias"),("Chamados",Model.OpenTickets,"Abertos"),("Críticos",Model.CriticalTickets,"Suporte prioritário"),("Erros",Model.RecentErrors,"Últimas 24 horas"),("Webhooks",Model.FailedWebhooks,"Falhas ativas"),("Integrações",Model.FailedIntegrations,"Falhas ativas"),("API",(int)Math.Min(Model.ApiRequests24h,int.MaxValue),"Requisições / 24h"),("Assinaturas",Model.PendingSubscriptions,"Pendentes"),("Segurança",Model.SecurityAlerts,"Alertas ativos")}) { <article><small>@x.Item1</small><strong>@x.Item2.ToString("N0")</strong><span>@x.Item3</span></article> }
</section>
<div class="ops-grid"><section class="ops-panel"><header><div><h2>Risco por cliente</h2><p>Cálculo transparente: bloqueio, erros, pendências, suporte e limite.</p></div></header><div class="ops-table-wrap"><table><thead><tr><th>Cliente</th><th>Status</th><th>Plano</th><th>Usuários</th><th>Uso</th><th>Chamados</th><th>Pendências</th><th>Erros</th><th>Último acesso</th><th>Risco</th></tr></thead><tbody>@foreach(var t in Model.Tenants){<tr class="@(t.Status.Equals("Blocked",StringComparison.OrdinalIgnoreCase)?"is-blocked":"")"><td><b>@t.ClientName</b><small>@t.RiskReason</small></td><td><span class="badge-status">@t.Status</span></td><td>@t.Plan</td><td>@t.ActiveUsers</td><td>@t.UsedLimit@(t.Limit is null?"":" / "+t.Limit)</td><td>@t.OpenTickets</td><td>@t.PendingPayments</td><td>@t.RecentErrors</td><td>@(t.LastAccess?.ToString("dd/MM HH:mm")??"Sem acesso")</td><td><span class="risk risk-@t.Risk.ToLowerInvariant().Replace("í","i")">@t.Risk</span></td></tr>}@if(Model.Tenants.Count==0){<tr><td colspan="10" class="empty">Nenhum cliente cadastrado. Os riscos aparecerão quando houver dados.</td></tr>}</tbody></table></div></section>
<aside class="ops-panel"><h2>Alertas críticos</h2>@foreach(var a in Model.CriticalAlerts){<article class="ops-alert"><span>@a.Severity</span><b>@a.Title</b><small>@(a.ClientName??"Plataforma") · @a.Occurrences ocorrência(s)</small><form method="post" action="/admin/operations/alerts/@a.Id/resolve"><button>Resolver</button></form></article>}@if(Model.CriticalAlerts.Count==0){<div class="empty">Tudo tranquilo. Nenhum alerta crítico ativo.</div>}<h2>Módulos mais usados</h2>@foreach(var m in Model.Modules){<div class="module"><span>@m.Module</span><b>@m.Uses.ToString("N0")</b></div>}@if(Model.Modules.Count==0){<div class="empty">Uso ainda não registrado.</div>}</aside></div></main>
