@{
    ViewData["Title"] = "Convidar usuário";
}
<h1>Convidar usuário</h1>
<form method="post" action="/admin/users/invite" class="card card-body">
    @Html.AntiForgeryToken()
    <label class="form-label" for="email">E-mail</label>
    <input class="form-control" id="email" name="email" type="email" required maxlength="200" />
    <label class="form-label mt-3" for="role">Perfil</label>
    <select class="form-select" id="role" name="role"><option>User</option><option>Admin</option></select>
    <button class="btn btn-primary mt-3" type="submit">Enviar convite</button>
</form>
