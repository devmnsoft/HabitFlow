@model HabitFlow.Web.Models.AccountInvitesViewModel
@{
    ViewData["Title"] = "Convites";
    var inviteEmail = TempData["InviteEmail"] as string ?? string.Empty;
    var inviteRole = TempData["InviteRole"] as string ?? "User";
}
<header class="mb-4">
    <p class="text-secondary mb-1">Conta</p>
    <h1>Convites</h1>
    <p class="text-secondary">Convites pendentes reservam uma vaga por até sete dias. Rotacionar um link invalida o anterior.</p>
</header>

<section class="card card-body mb-4">
    <h2 class="h4">Convidar pessoa</h2>
    @if (Model.Capacity.InviteBlock is not null)
    {
        <div class="alert alert-warning" role="status">
            @Model.Capacity.InviteBlock.Message
            <a class="alert-link" href="/account/plan/usage">Ver plano e uso</a>
        </div>
    }
    <form method="post" action="/admin/users/invite" class="row g-3 align-items-end">
        @Html.AntiForgeryToken()
        @if (Model.ClientId is not null) { <input type="hidden" name="clientId" value="@Model.ClientId" /> }
        <fieldset disabled="@(Model.Capacity.InviteBlock is not null)">
        <div class="col-12 col-md-6">
            <label class="form-label" for="invite-email">E-mail</label>
            <input class="form-control" id="invite-email" name="email" type="email" required maxlength="200" autocomplete="email" value="@inviteEmail" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="invite-role">Perfil</label>
            <select class="form-select" id="invite-role" name="role">
                <option value="User" selected="@(inviteRole == "User")">Pessoa</option>
                <option value="Admin" selected="@(inviteRole == "Admin")">Admin</option>
            </select>
        </div>
        <div class="col-12 col-md-3">
            <button class="btn btn-success w-100" type="submit">Criar convite</button>
        </div>
        </fieldset>
    </form>
</section>

@if (TempData["InviteLink"] is string inviteLink)
{
    <section class="alert alert-success" role="status" aria-live="polite">
        <p class="mb-2">@TempData["Success"]</p>
        <label class="form-label" for="invite-link">Link para compartilhar</label>
        <div class="input-group">
            <input class="form-control" id="invite-link" value="@inviteLink" readonly />
            <button class="btn btn-outline-success" type="button" data-copy="@inviteLink">Copiar link</button>
        </div>
    </section>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h4 mb-0">Convites enviados</h2>
    <a class="btn btn-outline-secondary" href="/account/people">Voltar a pessoas</a>
</div>
@if (Model.Invites.Count == 0)
{
    <div class="alert alert-light border" role="status">Ainda não há convites nesta conta.</div>
}
else
{
    <div class="vstack gap-3">
        @foreach (var invite in Model.Invites)
        {
            var pending = invite.Status == nameof(HabitFlow.Domain.UserInviteStatus.Pending);
            <article class="card">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-3">
                        <div>
                            <h3 class="h5 mb-1">@invite.Email</h3>
                            <p class="mb-1">@invite.Role · @invite.Status</p>
                            <p class="small text-secondary mb-0">
                                Enviado por @(invite.InviterName ?? "conta") · Criado em @invite.CreatedAt.ToString("dd/MM/yyyy HH:mm 'UTC'") · Válido até @invite.ExpiresAt.ToString("dd/MM/yyyy HH:mm 'UTC'")
                            </p>
                        </div>
                        @if (pending)
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-start">
                                <form method="post" action="/account/invites/@invite.Id/resend">
                                    @Html.AntiForgeryToken()
                                    @if (Model.ClientId is not null) { <input type="hidden" name="clientId" value="@Model.ClientId" /> }
                                    <button class="btn btn-outline-primary" type="submit">Rotacionar e copiar link</button>
                                </form>
                                <form method="post" action="/account/invites/@invite.Id/cancel">
                                    @Html.AntiForgeryToken()
                                    @if (Model.ClientId is not null) { <input type="hidden" name="clientId" value="@Model.ClientId" /> }
                                    <button class="btn btn-outline-danger" type="submit">Cancelar convite</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}
