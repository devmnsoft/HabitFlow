@model (IReadOnlyList<HabitFlow.Domain.HabitObjective> Objectives, IReadOnlyList<HabitFlow.Domain.HabitTemplate> Templates)
@{ ViewData["Title"] = "Admin biblioteca de hábitos"; }
<section class="hf-section"><p class="hf-section-kicker">Admin operacional</p><h1>Biblioteca de hábitos</h1><p class="text-muted">Gestão simples de objetivos e templates prontos. MNSOFT aparece como confiança; HabitFlow continua sendo o produto principal.</p>@await Html.PartialAsync("~/Views/Shared/Partials/_MNSOFTSignature.cshtml")</section>
<h2>Objetivos</h2><div class="table-responsive"><table class="table"><thead><tr><th>Nome</th><th>Slug</th><th>Status</th><th>Ação</th></tr></thead><tbody>@foreach(var o in Model.Objectives){<tr><td>@o.Name</td><td>@o.Slug</td><td>@(o.IsActive ? "Ativo" : "Inativo")</td><td><form method="post" action="/admin/habit-library/objective/toggle">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="isActive" value="@(!o.IsActive)"/><button class="btn btn-sm btn-outline-primary">@(o.IsActive ? "Desativar" : "Ativar")</button></form></td></tr>}</tbody></table></div>
<h2>Templates</h2><div class="table-responsive"><table class="table"><thead><tr><th>Nome</th><th>Categoria</th><th>Dificuldade</th><th>Status</th><th>Ação</th></tr></thead><tbody>@foreach(var t in Model.Templates){<tr><td>@t.Name</td><td>@t.Category</td><td>@t.Difficulty</td><td>@(t.IsActive ? "Ativo" : "Inativo")</td><td><form method="post" action="/admin/habit-library/template/toggle">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id"/><input type="hidden" name="isActive" value="@(!t.IsActive)"/><button class="btn btn-sm btn-outline-primary">@(t.IsActive ? "Desativar" : "Ativar")</button></form></td></tr>}</tbody></table></div>
