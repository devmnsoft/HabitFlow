@model HabitFlow.Shared.Result<HabitFlow.Application.AdminUserDetail>
@{ var u=Model?.Value?.User; ViewData["Title"]="Detalhe do usuário"; }
<div class="container py-4"><a href="/admin/users">← Usuários</a><h1>@u?.Name</h1><p>@u?.Email</p><div class="row g-3"><div class="col-md-4"><form method="post" action="/admin/users/@u?.Id/status">@Html.AntiForgeryToken()<select name="status" class="form-select mb-2"><option>Active</option><option>Blocked</option><option>Suspended</option><option>DeletedPending</option></select><input name="reason" required class="form-control mb-2" placeholder="Motivo obrigatório"/><button class="btn btn-warning" onclick="return confirm('Confirmar alteração de status?')">Alterar status</button></form></div><div class="col-md-4"><form method="post" action="/admin/users/@u?.Id/risk">@Html.AntiForgeryToken()<select name="riskStatus" class="form-select mb-2"><option>Normal</option><option>Watchlist</option><option>Suspicious</option></select><input name="reason" required class="form-control mb-2" placeholder="Motivo obrigatório"/><button class="btn btn-danger">Alterar risco</button></form></div><div class="col-md-4"><form method="post" action="/admin/users/@u?.Id/plan">@Html.AntiForgeryToken()<select name="plan" class="form-select mb-2"><option>Free</option><option>Premium</option></select><select name="planStatus" class="form-select mb-2"><option>Active</option><option>Trial</option><option>Canceled</option><option>Inactive</option><option>PastDue</option></select><input name="reason" required class="form-control mb-2" placeholder="Motivo obrigatório"/><button class="btn btn-success">Alterar plano</button></form></div></div><hr/><form method="post" action="/admin/users/@u?.Id/notes">@Html.AntiForgeryToken()<textarea name="note" required class="form-control" placeholder="Nota administrativa"></textarea><button class="btn btn-outline-success mt-2">Adicionar nota</button></form><h2 class="mt-4">Notas</h2>@foreach(var n in Model?.Value?.Notes ?? Array.Empty<HabitFlow.Domain.AdminUserNote>()){<div class="alert alert-light"><strong>@n.AdminEmail</strong> @n.CreatedAt<br/>@n.Note</div>}</div>
