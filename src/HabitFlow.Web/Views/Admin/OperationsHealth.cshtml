@model HabitFlow.Domain.OperationsHealthReport
@{ ViewData["Title"]="Saúde do Sistema"; }
@section Styles { <link rel="stylesheet" href="~/css/operations-v6194.css" asp-append-version="true" /> }
<main class="ops"><header class="ops-hero"><div><span class="ops-kicker">MNSOFT · Confiabilidade</span><h1>Saúde do sistema</h1><p>Diagnóstico acionável sem exposição de credenciais.</p></div><div class="ops-health @Model.OverallStatus.ToLowerInvariant()"><span></span><b>@Model.OverallStatus</b><small>v@Model.Version · @Model.Environment</small></div></header><nav class="ops-nav"><a href="/admin/operations">Operações</a><a aria-current="page" href="/admin/system-health">Saúde do sistema</a><a href="/admin/logs">Logs seguros</a></nav><section class="health-grid">@foreach(var c in Model.Checks){<article class="health-card"><header><span class="check check-@c.Status.ToLowerInvariant()"></span><div><h2>@c.Name</h2><small>@c.CheckedAt.ToString("dd/MM/yyyy HH:mm") UTC · @c.Severity</small></div><b>@c.Status</b></header><p>@c.Message</p><footer><strong>Ação recomendada</strong><span>@c.Recommendation</span></footer></article>}</section></main>
