@model HabitFlow.Application.UpdateClientRequest
@{ ViewData["Title"] = "Editar cliente"; }
<section class="hf-page-hero"><div><h1>Editar cliente</h1><p>Atualize dados comerciais, plano e status.</p></div></section>
<div class="row g-4"><div class="col-lg-8"><form method="post" class="card hf-card p-4">@Html.AntiForgeryToken()
@using HabitFlow.Domain
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3"><div class="col-md-6"><label class="form-label">Nome do cliente</label><input class="form-control" asp-for="Name" required maxlength="180"><span class="text-danger" asp-validation-for="Name"></span><div class="form-text">Nome comercial usado nas telas administrativas.</div></div><div class="col-md-6"><label class="form-label">Razão social</label><input class="form-control" asp-for="LegalName" maxlength="220"></div><div class="col-md-4"><label class="form-label">CNPJ/CPF</label><input class="form-control" asp-for="Document" maxlength="30"><span class="text-danger" asp-validation-for="Document"></span></div><div class="col-md-4"><label class="form-label">E-mail</label><input class="form-control" asp-for="Email" type="email" maxlength="200"><span class="text-danger" asp-validation-for="Email"></span></div><div class="col-md-4"><label class="form-label">Telefone</label><input class="form-control" asp-for="Phone" maxlength="40"></div><div class="col-md-4"><label class="form-label">Nome do contato</label><input class="form-control" asp-for="ContactName" maxlength="160"></div><div class="col-md-4"><label class="form-label">Plano</label><select class="form-select" asp-for="Plan" asp-items="Html.GetEnumSelectList<ClientPlan>()"></select></div><div class="col-md-4"><label class="form-label">Status</label><select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<ClientStatus>()"></select></div><div class="col-12"><label class="form-label">Observações</label><textarea class="form-control" asp-for="Notes" rows="4"></textarea></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-success" type="submit">Salvar cliente</button><a class="btn btn-outline-secondary" href="/admin/clients">Cancelar</a></div>
</form></div><aside class="col-lg-4"><div class="card hf-card p-4"><h2 class="h5">O que é cliente?</h2><p>Cliente é a empresa ou pessoa que usa o HabitFlow.</p></div></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
