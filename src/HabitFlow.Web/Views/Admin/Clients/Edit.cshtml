@model HabitFlow.Application.UpdateClientRequest
@{ ViewData["Title"] = "Editar cliente"; }
<section class="hf-page-hero"><div><h1>Editar cliente</h1><p>Atualize dados comerciais, plano e status.</p></div></section>
<div class="row g-4"><div class="col-lg-8"><form method="post" class="card hf-card p-4">@Html.AntiForgeryToken()
@using HabitFlow.Domain
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label class="form-label fw-bold">Tipo de cliente</label><div class="row g-2" data-client-type-picker><div class="col-md-6"><label class="card p-3 h-100"><input type="radio" asp-for="PersonType" value="NaturalPerson" data-person-type="NaturalPerson"> <strong>Pessoa Física</strong><span class="text-muted d-block">CPF</span></label></div><div class="col-md-6"><label class="card p-3 h-100"><input type="radio" asp-for="PersonType" value="LegalPerson" data-person-type="LegalPerson"> <strong>Pessoa Jurídica</strong><span class="text-muted d-block">CNPJ</span></label></div></div><div class="form-text">Use CPF para pessoa física e CNPJ para empresa.</div></div>
<input type="hidden" asp-for="DocumentType" data-document-type>
<div class="row g-3"><div class="col-md-6"><label class="form-label" data-name-label>Razão social</label><input class="form-control" asp-for="Name" required maxlength="180"><span class="text-danger" asp-validation-for="Name"></span></div><div class="col-md-6" data-company-field><label class="form-label">Nome fantasia</label><input class="form-control" asp-for="TradeName" maxlength="180"></div><div class="col-md-6"><label class="form-label" data-document-label>CNPJ</label><input class="form-control" asp-for="Document" maxlength="30" data-document-input><span class="text-danger" asp-validation-for="Document"></span><div class="form-text" data-document-help>Documento válido será normalizado no backend.</div></div><div class="col-md-6" data-company-field><label class="form-label">Responsável financeiro</label><input class="form-control" asp-for="BillingResponsibleName" maxlength="160"></div><div class="col-md-6"><label class="form-label" data-email-label>E-mail financeiro</label><input class="form-control" asp-for="BillingEmail" type="email" maxlength="200"></div><div class="col-md-6"><label class="form-label" data-phone-label>Telefone financeiro</label><input class="form-control" asp-for="BillingPhone" maxlength="40"></div><div class="col-md-4"><label class="form-label">Plano</label><select class="form-select" asp-for="Plan" asp-items="Html.GetEnumSelectList<ClientPlan>()"></select></div><div class="col-md-4"><label class="form-label">Status</label><select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<ClientStatus>()"></select></div><div class="col-12"><label class="form-label">Observações</label><textarea class="form-control" asp-for="Notes" rows="4"></textarea></div></div>
<script>
(() => { const root = document.currentScript.closest('form'); if (!root) return; const radios = root.querySelectorAll('[data-person-type]'); const doc = root.querySelector('[data-document-input]'); const docType = root.querySelector('[data-document-type]'); const docLabel = root.querySelector('[data-document-label]'); const nameLabel = root.querySelector('[data-name-label]'); const company = root.querySelectorAll('[data-company-field]'); function digits(v){return (v||'').replace(/\D/g,'');} function maskCpf(v){v=digits(v).slice(0,11); return v.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2');} function maskCnpj(v){v=digits(v).slice(0,14); return v.replace(/(\d{2})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1/$2').replace(/(\d{4})(\d{1,2})$/,'$1-$2');} function apply(){ const pf = root.querySelector('[data-person-type="NaturalPerson"]').checked; docType.value = pf ? 'CPF' : 'CNPJ'; docLabel.textContent = pf ? 'CPF' : 'CNPJ'; nameLabel.textContent = pf ? 'Nome completo' : 'Razão social'; company.forEach(el => el.classList.toggle('d-none', pf)); if (doc) doc.value = pf ? maskCpf(doc.value) : maskCnpj(doc.value); } radios.forEach(r => r.addEventListener('change', apply)); doc?.addEventListener('input', apply); apply(); })();
</script>
<div class="mt-4 d-flex gap-2"><button class="btn btn-success" type="submit">Salvar cliente</button><a class="btn btn-outline-secondary" href="/admin/clients">Cancelar</a></div>
</form></div><aside class="col-lg-4"><div class="card hf-card p-4"><h2 class="h5">O que é cliente?</h2><p>O cliente representa uma conta comercial ou organização dentro do HabitFlow.</p></div></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
