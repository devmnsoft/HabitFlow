@model HabitFlow.Application.ClientDetailDto
@using HabitFlow.Domain
@{ ViewData["Title"] = "Detalhe do cliente"; var c = Model!.Client; }
<section class="hf-page-hero"><div><h1>@c.Name</h1><p>@(c.LegalName ?? "Cliente HabitFlow")</p></div><a class="btn btn-outline-primary" href="/admin/clients/@c.Id/edit">Editar cliente</a></section>
<div class="row g-3 mb-4"><div class="col-md-2"><div class="card hf-card p-3"><small>Usuários vinculados</small><strong>@Model.Metrics.LinkedUsers</strong></div></div><div class="col-md-2"><div class="card hf-card p-3"><small>Hábitos ativos</small><strong>@Model.Metrics.ActiveHabits</strong></div></div><div class="col-md-2"><div class="card hf-card p-3"><small>Hábitos concluídos</small><strong>@Model.Metrics.CompletedHabits</strong></div></div><div class="col-md-2"><div class="card hf-card p-3"><small>Plano</small><strong>@c.Plan</strong></div></div><div class="col-md-2"><div class="card hf-card p-3"><small>Status</small><strong>@c.Status</strong></div></div><div class="col-md-2"><div class="card hf-card p-3"><small>Criado em</small><strong>@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong></div></div></div>
<div class="row g-4"><div class="col-lg-8"><div class="card hf-card p-4"><h2 class="h5">Dados principais</h2><dl class="row"><dt class="col-sm-3">Documento</dt><dd class="col-sm-9">@(c.Document ?? "—")</dd><dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@(c.Email ?? "—")</dd><dt class="col-sm-3">Telefone</dt><dd class="col-sm-9">@(c.Phone ?? "—")</dd><dt class="col-sm-3">Contato</dt><dd class="col-sm-9">@(c.ContactName ?? "—")</dd><dt class="col-sm-3">Observações</dt><dd class="col-sm-9">@(c.Notes ?? "—")</dd></dl></div><div class="card hf-card p-4 mt-3"><h2 class="h5">Usuários vinculados</h2><p class="text-muted">Dados serão atualizados conforme os usuários vinculados utilizarem o sistema.</p><a class="btn btn-outline-secondary disabled" aria-disabled="true">Vincular usuário</a><ul class="list-group mt-3">@foreach(var u in Model.Users){<li class="list-group-item d-flex justify-content-between"><span>@u.Name — @u.Email</span><small>@u.AccountStatus</small></li>} @if(!Model.Users.Any()){<li class="list-group-item text-muted">Nenhum usuário vinculado.</li>}</ul></div></div><aside class="col-lg-4"><div class="card hf-card p-4"><h2 class="h5">Ações rápidas</h2><form method="post" action="/admin/clients/@c.Id/activate" class="mb-2">@Html.AntiForgeryToken()<button class="btn btn-success w-100" data-confirm="Deseja ativar este cliente?" data-confirm-label="Ativar">Ativar cliente</button></form><form method="post" action="/admin/clients/@c.Id/deactivate" class="mb-2">@Html.AntiForgeryToken()<input name="reason" class="form-control mb-2" required placeholder="Motivo"><button class="btn btn-warning w-100" data-confirm="Deseja desativar este cliente?" data-confirm-label="Desativar">Desativar cliente</button></form><form method="post" action="/admin/clients/@c.Id/block">@Html.AntiForgeryToken()<input name="reason" class="form-control mb-2" required placeholder="Motivo obrigatório"><button class="btn btn-danger w-100" data-confirm="Deseja bloquear este cliente?" data-confirm-label="Bloquear">Bloquear cliente</button></form></div></aside></div>
