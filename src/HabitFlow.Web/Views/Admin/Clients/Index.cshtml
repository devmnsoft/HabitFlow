@model IReadOnlyList<HabitFlow.Application.ClientListItemDto>
@using HabitFlow.Domain
@{ ViewData["Title"] = "Clientes"; var filter = ViewData["Filter"] as HabitFlow.Application.ClientFilter ?? new(); }
<section class="hf-page-hero"><div><h1>Clientes</h1><p>Gerencie empresas, contas e planos do HabitFlow.</p></div><a class="btn btn-success" href="/admin/clients/create">Novo cliente</a></section>
<form method="get" class="card hf-card p-3 mb-3"><div class="row g-3"><div class="col-md-5"><label class="form-label">Busca</label><input class="form-control" name="Search" value="@filter.Search" placeholder="Nome, e-mail ou documento"></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="Status"><option value="">Todos</option>@foreach(var s in Enum.GetValues<ClientStatus>()){<option value="@s" selected="@(filter.Status==s)">@s</option>}</select></div><div class="col-md-3"><label class="form-label">Plano</label><select class="form-select" name="Plan"><option value="">Todos</option>@foreach(var p in Enum.GetValues<ClientPlan>()){<option value="@p" selected="@(filter.Plan==p)">@p</option>}</select></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-success w-100">Filtrar</button></div></div></form>
<div class="table-responsive card hf-card"><table class="table align-middle mb-0"><thead><tr><th>Nome</th><th>Documento</th><th>E-mail</th><th>Plano</th><th>Status</th><th>Criado em</th><th>Ações</th></tr></thead><tbody>@foreach(var c in Model ?? Array.Empty<HabitFlow.Application.ClientListItemDto>()){<tr><td>@c.Name</td><td>@(c.Document ?? "—")</td><td>@(c.Email ?? "—")</td><td>@c.Plan</td><td><span class="badge text-bg-@(c.Status==ClientStatus.Active?"success":c.Status==ClientStatus.Blocked?"danger":"warning")">@c.Status</span></td><td>@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><a class="btn btn-sm btn-outline-primary" href="/admin/clients/@c.Id">Detalhes</a></td></tr>} @if(Model is null || !Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4">Nenhum cliente encontrado.</td></tr>}</tbody></table></div>
