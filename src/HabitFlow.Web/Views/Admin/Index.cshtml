@model HabitFlow.Shared.Result<HabitFlow.Application.AdminDashboardDto>
@{ ViewData["Title"] = "Admin Operacional"; var d = Model?.Value; }
<div class="hf-admin-layout"><aside class="hf-admin-sidebar" aria-label="Menu administrativo"><strong>Admin HabitFlow</strong><a href="/admin">Visão geral</a><a href="/admin/users">Usuários</a><a href="/admin/support">Suporte</a><a href="/admin/lgpd">LGPD</a><a href="/admin/logs/system">Logs</a><a href="/admin/leads">Leads</a><a href="/admin/finance">Financeiro</a><a href="/admin/database">Banco de dados</a><a href="/admin/environment">Sistema/Ambiente</a><a href="/admin/settings">Configurações</a></aside><section><header class="hf-page-header"><div><p class="hf-eyebrow">Painel executivo · v4.7</p><h1>Admin Operacional</h1><p>Visão clara de usuários, suporte, LGPD, métricas, financeiro e ambiente.</p></div><a class="btn btn-outline-success" href="/admin/database">Banco de Dados</a></header>@if (Model?.IsFailure == true) { <div class="alert alert-danger hf-alert">@Model.Error.Message</div> }<div class="hf-grid"><div class="hf-col-3 hf-admin-metric"><span>Total de usuários</span><strong>@(d?.TotalUsers ?? 0)</strong><small>base cadastrada</small></div><div class="hf-col-3 hf-admin-metric"><span>Ativos 7 dias</span><strong>@(d?.ActiveUsers7Days ?? 0)</strong><small>engajamento</small></div><div class="hf-col-3 hf-admin-metric"><span>Novos 7 dias</span><strong>@(d?.NewUsers7Days ?? 0)</strong><small>aquisição</small></div><div class="hf-col-3 hf-admin-metric"><span>Hábitos ativos</span><strong>@(d?.ActiveHabits ?? 0)</strong><small>produto</small></div><div class="hf-col-3 hf-admin-metric"><span>Conclusões 7 dias</span><strong>@(d?.Completions7Days ?? 0)</strong><small>valor entregue</small></div><div class="hf-col-3 hf-admin-metric"><span>Tickets abertos</span><strong>@(d?.OpenTickets ?? 0)</strong><small>suporte</small></div><div class="hf-col-3 hf-admin-metric"><span>LGPD abertas</span><strong>@(d?.OpenLgpdRequests ?? 0)</strong><small>privacidade</small></div><div class="hf-col-3 hf-admin-metric"><span>Leads Premium</span><strong>@(d?.PremiumLeads ?? 0)</strong><small>receita potencial</small></div></div><div class="hf-card mt-4"><h2>Atalhos operacionais</h2><div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-success" href="/admin/users">Usuários</a><a class="btn btn-outline-success" href="/admin/support">Suporte</a><a class="btn btn-outline-success" href="/admin/lgpd">LGPD</a><a class="btn btn-outline-success" href="/admin/logs/system">Logs</a><a class="btn btn-outline-success" href="/admin/finance">Financeiro</a></div></div></section></div>
