@model HabitFlow.Shared.Result<HabitFlow.Application.AdminDashboardDto>
@{ ViewData["Title"] = "Admin Operacional"; var d = Model?.Value; }
<section class="container-fluid py-4" style="background:#F3F4F6;color:#111827">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><h1>Admin Operacional</h1><span class="badge" style="background:#10B981">v4.3</span></div>
  @if (Model?.IsFailure == true) { <div class="alert alert-danger">@Model.Error.Message</div> }
  <div class="row g-3">
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small>Total de usuários</small><h2>@(d?.TotalUsers ?? 0)</h2></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small>Ativos 7 dias</small><h2>@(d?.ActiveUsers7Days ?? 0)</h2></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small>Novos 7 dias</small><h2>@(d?.NewUsers7Days ?? 0)</h2></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small>Hábitos ativos</small><h2>@(d?.ActiveHabits ?? 0)</h2></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small>Conclusões 7 dias</small><h2>@(d?.Completions7Days ?? 0)</h2></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small>Tickets abertos</small><h2>@(d?.OpenTickets ?? 0)</h2></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small>LGPD abertas</small><h2>@(d?.OpenLgpdRequests ?? 0)</h2></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small>Leads Premium</small><h2>@(d?.PremiumLeads ?? 0)</h2></div></div></div>
  </div>
  <nav class="nav nav-pills mt-4"><a class="nav-link" href="/admin/users">Usuários</a><a class="nav-link" href="/admin/support">Suporte</a><a class="nav-link" href="/admin/lgpd">LGPD</a><a class="nav-link" href="/admin/logs/system">Logs</a><a class="nav-link" href="/admin/leads">Leads</a><a class="nav-link" href="/admin/finance">Financeiro</a></nav>
</section>
