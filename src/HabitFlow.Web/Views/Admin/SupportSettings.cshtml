@model HabitFlow.Domain.SupportSettings
@{ViewData["Title"]="Configurações de suporte";}
<section class="form-premium"><span class="assist-kicker">Administração</span><h1>Contato e WhatsApp</h1><p>Defina um canal seguro. Se o telefone estiver vazio, o sistema usa o e-mail.</p><form method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"><input type="hidden" asp-for="UpdatedAt"><label>Empresa<input asp-for="CompanyName" maxlength="120" required></label><label>CNPJ<input asp-for="CompanyDocument" maxlength="30" required></label><label>E-mail de suporte<input asp-for="SupportEmail" type="email" required></label><label>WhatsApp internacional<input asp-for="WhatsAppPhone" placeholder="+5511999999999"></label><span asp-validation-for="WhatsAppPhone" class="text-danger"></span><label>Mensagem padrão<textarea asp-for="DefaultMessage" maxlength="500"></textarea></label><label>Horário de atendimento<input asp-for="BusinessHours" maxlength="160"></label><label>Texto do botão<input asp-for="ButtonText" maxlength="80"></label><label class="check"><input asp-for="IsActive"> Canal ativo</label><button class="btn btn-primary">Salvar configurações</button></form></section>

@section Styles {
    <link rel="stylesheet" href="~/css/assistance-v6169.css" asp-append-version="true" />
}
