@model HabitFlow.Web.Models.ChallengePageViewModel
@{ ViewData["Title"]="Desafios"; var active=Model.Challenges.Where(x=>x.Status==HabitFlow.Domain.UserChallengeStatus.Active).ToList(); }
<main class="hf-challenges container">
 <header class="hf-challenge-hero"><div><span>Progresso com propósito</span><h1>Escolha um desafio possível</h1><p>Comece com 7 dias ou avance no seu ritmo. Perder um dia não apaga o caminho.</p></div><a class="btn btn-light" href="/habit-library">Encontrar um hábito</a></header>
 @if(active.Count>0){<section aria-labelledby="active-title"><h2 id="active-title">Em andamento</h2><div class="hf-challenge-grid">@foreach(var item in active){<article class="hf-challenge-card"><div class="d-flex justify-content-between"><strong>@item.Name</strong><span>@item.ProgressDays/@item.DurationDays dias</span></div><div class="progress" role="progressbar" aria-valuenow="@item.ProgressPercent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-success" style="width:@item.ProgressPercent%"></div></div><p>@(item.ProgressDays==0?"Seu primeiro passo pode ser hoje.":"Você está construindo consistência, no seu ritmo.")</p><form method="post" action="/challenges/@item.Id/abandon">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary">Encerrar desafio</button></form></article>}</div></section>}
 <section aria-labelledby="start-title"><h2 id="start-title">Iniciar novo desafio</h2>
 @if(Model.Habits.Count==0){<div class="hf-challenge-empty"><h3>Primeiro, escolha um hábito</h3><p>A biblioteca tem opções simples que você pode personalizar.</p><a class="btn btn-success" href="/habit-library">Abrir biblioteca</a></div>}
 else {<form method="post" action="/challenges/start" class="hf-challenge-start">@Html.AntiForgeryToken()<label for="habitId">Hábito</label><select id="habitId" name="habitId" class="form-select" required>@foreach(var habit in Model.Habits.Where(h=>!h.IsPaused)){<option value="@habit.Id">@habit.Name</option>}</select><fieldset><legend>Duração</legend><label><input type="radio" name="durationDays" value="7" checked><strong>7 dias</strong><small>Disponível no Free</small></label><label><input type="radio" name="durationDays" value="30"><strong>30 dias</strong><small>Premium</small></label><label><input type="radio" name="durationDays" value="90"><strong>90 dias</strong><small>Premium</small></label></fieldset><button class="btn btn-success" type="submit">Começar desafio</button></form>}
 </section>
</main>
@section Styles{<link rel="stylesheet" href="~/css/challenges-v6165.css" asp-append-version="true"/>}
