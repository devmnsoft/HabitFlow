@model HabitFlow.Domain.HabitReminder
<article class="reminder-card @(Model.IsActive ? "" : "is-paused")"><div class="reminder-icon" aria-hidden="true">🔔</div><div><h2>@Model.HabitName</h2><p class="reminder-time">@Model.ReminderTime.ToString("HH:mm")</p><p>@string.Join(", ", Model.DaysOfWeek.Select(x => new[]{"Dom","Seg","Ter","Qua","Qui","Sex","Sáb"}[x])) · @Model.Timezone.Replace('_',' ')</p><span class="status">@(Model.IsActive ? "Ativo" : "Pausado")</span></div><form method="post" action="/reminders/@Model.Id/@(Model.IsActive ? "pause" : "resume")">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary">@(Model.IsActive ? "Pausar" : "Reativar")</button></form></article>
