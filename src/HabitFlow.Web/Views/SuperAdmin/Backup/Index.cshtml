@model HabitFlow.Application.BackupGovernanceInfo
@{
    ViewData["Title"] = "Backup & Restore Governança";
}

<div class="container-fluid py-4" style="max-width: 1300px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge" style="background: #e0e7ff; color: #3730a3; font-weight: 600; font-size: 0.75rem; padding: 0.35rem 0.65rem; border-radius: 9999px;">
                    Resiliência & Continuidade de Negócio
                </span>
                <span class="badge" style="background: #dcfce7; color: #166534; font-weight: 700; font-size: 0.85rem; padding: 0.35rem 0.75rem; border-radius: 9999px;">
                    ● RPO & RTO Monitorados
                </span>
            </div>
            <h1 class="h3 fw-bold mb-1" style="color: #0f172a;">Governança de Backup e Procedimentos de Restore</h1>
            <p class="text-muted small mb-0">
                Políticas de integridade, cálculo criptográfico SHA-256 e checklist obrigatório para restore em ambiente descartável isolado.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/superadmin" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 8px;">
                Painel SuperAdmin
            </a>
        </div>
    </div>

    <!-- Alerta de Segurança Operacional -->
    <div class="alert alert-warning border-0 shadow-sm d-flex gap-3 align-items-start mb-4" style="background: #fffbeb; border-left: 4px solid #f59e0b !important; border-radius: 8px; color: #92400e;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" class="flex-shrink-0 mt-1"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <div class="small">
            <strong>Regra Crítica de Segurança:</strong> Nunca execute restore diretamente no cluster PostgreSQL ativo de produção sem confirmação de contingência formal.
            Todo teste de restore deve ser realizado exclusivamente em contêiner descartável ou cluster isolado de staging.
        </div>
    </div>

    <!-- Métricas RPO / RTO -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 10px; background: #ffffff;">
                <span class="text-muted small text-uppercase fw-bold">RPO (Recovery Point)</span>
                <h4 class="fw-bold mt-2 mb-0" style="color: #0f172a;">@Model.RpoTarget</h4>
                <small class="text-muted mt-1">Perda máxima tolerável</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 10px; background: #ffffff;">
                <span class="text-muted small text-uppercase fw-bold">RTO (Recovery Time)</span>
                <h4 class="fw-bold mt-2 mb-0" style="color: #0f172a;">@Model.RtoTarget</h4>
                <small class="text-muted mt-1">Tempo máximo de recuperação</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 10px; background: #ffffff;">
                <span class="text-muted small text-uppercase fw-bold">Formato & Compressão</span>
                <h5 class="fw-bold mt-2 mb-0 text-truncate" style="color: #0f172a;" title="@Model.Strategy">pg_dump Custom (-Fc)</h5>
                <small class="text-muted mt-1">Zlib com integridade SHA-256</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 10px; background: #ffffff;">
                <span class="text-muted small text-uppercase fw-bold">Política de Retenção</span>
                <h5 class="fw-bold mt-2 mb-0 text-truncate" style="color: #0f172a;" title="@Model.RetentionPolicy">7d Local / 30d Cloud</h5>
                <small class="text-muted mt-1">Com imutabilidade WORM</small>
            </div>
        </div>
    </div>

    <!-- Checklist de Restore em Ambiente Descartável -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 10px; background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold" style="color: #0f172a; font-size: 1rem;">Checklist Obrigatório de Restore (Ambiente Descartável)</h5>
        </div>
        <div class="card-body p-3">
            <ol class="mb-0 ps-3 small text-muted d-flex flex-column gap-2">
                @foreach (var step in Model.RestoreChecklistSteps)
                {
                    <li style="color: #334155;">@step</li>
                }
            </ol>
        </div>
    </div>

    <!-- Tabela de Histórico de Backups -->
    <div class="card border-0 shadow-sm" style="border-radius: 10px; background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color: #0f172a; font-size: 1rem;">Registros de Backup Verificados</h5>
            <small class="text-muted">Documentação técnica em <code>database/BACKUP_RESTORE.md</code></small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.75rem;">
                    <tr>
                        <th style="padding: 0.75rem 1rem;">Data/Hora</th>
                        <th style="padding: 0.75rem 1rem;">Tipo</th>
                        <th style="padding: 0.75rem 1rem;">Arquivo</th>
                        <th style="padding: 0.75rem 1rem;">Tamanho</th>
                        <th style="padding: 0.75rem 1rem;">Duração</th>
                        <th style="padding: 0.75rem 1rem;">Integridade</th>
                        <th style="padding: 0.75rem 1rem;">Hash SHA-256</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.RecentBackups)
                    {
                        var isVerified = b.IntegrityStatus == "Verified";
                        <tr>
                            <td style="padding: 0.75rem 1rem;" class="text-nowrap">
                                <span class="fw-semibold">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                <span class="badge bg-light text-dark border">@b.BackupType</span>
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                <code style="color: #1e40af;">@b.FileName</code>
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                @(Math.Round(b.SizeBytes / (1024.0 * 1024.0), 2)) MB
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                @b.DurationMs ms
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                <span class="badge" style="background: @(isVerified ? "#dcfce7" : "#fef3c7"); color: @(isVerified ? "#166534" : "#92400e"); font-weight: 600;">
                                    @b.IntegrityStatus
                                </span>
                            </td>
                            <td style="padding: 0.75rem 1rem;">
                                <small class="text-muted font-monospace" title="@b.Sha256Hash">
                                    @(b.Sha256Hash != null && b.Sha256Hash.Length > 16 ? b.Sha256Hash[..16] + "..." : (b.Sha256Hash ?? "—"))
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
