@model HabitFlow.Application.ClientDetailDto
@{ var c = Model.Client; ViewData["Title"] = $"Cliente {c.Name}"; }
<section class="py-4"><a href="/superadmin/clients">← Clientes</a><h1>@c.Name</h1><p class="text-muted">@c.PersonType · @c.DocumentType: @(c.DocumentRaw ?? c.DocumentNormalized)</p><div class="row g-3"><div class="col-md-4"><div class="card"><div class="card-body"><h2 class="h6">Plano</h2><p>@c.Plan</p><p>Assinatura: @c.SubscriptionStatus</p><p>Benefícios: @c.BenefitsStatus</p><p>Pagamento: @c.PaymentStatus</p></div></div></div><div class="col-md-8"><div class="card"><div class="card-body"><h2 class="h6">Ações sensíveis</h2><form id="block-paid-benefits" method="post" action="/superadmin/clients/@c.Id/block-paid-benefits" class="mb-2">@Html.AntiForgeryToken()<label>Motivo obrigatório</label><input name="reason" class="form-control" required /><button type="button" class="btn btn-warning mt-2" data-feedback-confirm data-form="block-paid-benefits" data-confirm-title="Bloquear benefícios pagos?" data-confirm-message="O cliente continuará com acesso ao plano gratuito, mas recursos Premium e Enterprise serão desativados até a regularização." data-confirm-label="Bloquear benefícios">Bloquear benefícios pagos</button></form><form method="post" action="/superadmin/clients/@c.Id/release-paid-benefits">@Html.AntiForgeryToken()<label>Motivo obrigatório</label><input name="reason" class="form-control" required /><button class="btn btn-success mt-2">Liberar benefícios pagos</button></form></div></div></div></div><h2 class="h5 mt-4">Usuários vinculados</h2><ul>@foreach(var u in Model.Users){<li>@u.Name (@u.Email) - @u.Role</li>}</ul></section>
