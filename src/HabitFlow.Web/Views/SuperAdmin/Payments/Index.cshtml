@model IReadOnlyList<HabitFlow.Domain.SuperAdminPaymentRow>
@{ ViewData["Title"] = "Pagamentos SuperAdmin"; }
<section class="premium-card"><h1>Pagamentos</h1><table class="table"><thead><tr><th>Cliente</th><th>Fatura</th><th>Valor</th><th>Vencimento</th><th>Método</th><th>Status</th><th>Pago em</th><th>Checkout</th><th>MP ID</th><th>Ações</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.ClientName</td><td>@p.InvoiceNumber</td><td>@p.Amount</td><td>@p.DueDate</td><td>@p.Method</td><td>@p.Status</td><td>@p.PaidAt</td><td>@p.CheckoutUrl</td><td>@p.ProviderPaymentId</td><td><form method="post" action="/superadmin/payments/@p.Id/mark-as-paid">@Html.AntiForgeryToken()<input name="reason" placeholder="Motivo" required minlength="5"/><button>Marcar pago</button></form><form method="post" action="/superadmin/payments/@p.Id/mark-as-overdue">@Html.AntiForgeryToken()<input name="reason" placeholder="Motivo" required minlength="5"/><button>Marcar vencido</button></form></td></tr>}</tbody></table></section>
