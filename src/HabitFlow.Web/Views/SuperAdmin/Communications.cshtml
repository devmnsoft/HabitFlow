@model IReadOnlyList<HabitFlow.Domain.ClientCommunication>
@{ ViewData["Title"] = "Comunicações SuperAdmin"; }
<section class="premium-card"><h1>Comunicações dos clientes</h1><p>Visão global SuperAdmin respeitando operação comercial e auditoria.</p>@foreach(var c in Model){<article><strong>@c.Title</strong><p>@c.Message</p><small>@c.ClientId · @c.Type · @c.Status</small></article>}</section>
