@model HabitFlow.Domain.HomologationReport
@{ ViewData["Title"] = "Homologação"; }
<section class="hf-activation premium-card">
  <h1>Relatórios de homologação</h1>
  <div class="hf-help"><strong>Como usar.</strong> Filtre por período, nome do tenant, plano e status. A exportação usa o mesmo filtro e não pede ID.</div>
  <form method="get" action="/superadmin/homologation" class="hf-grid">
    <label>De <input type="date" name="from" /></label>
    <label>Até <input type="date" name="to" /></label>
    <label>Tenant <input name="tenant" maxlength="120" /></label>
    <label>Plano <select name="plan"><option value="">Todos</option><option>Free</option><option>Premium</option><option>Enterprise</option></select></label>
    <label>Status <select name="status"><option value="">Todos</option><option>Active</option><option>Inactive</option><option>Blocked</option></select></label>
    <button type="submit">Filtrar</button>
  </form>
  @if (Model.Pendencies.Count > 0) { <div class="hf-empty"><ul>@foreach (var item in Model.Pendencies) { <li>@item</li> }</ul></div> }
  @if (Model.Rows.Count == 0) { <div class="hf-empty">Nenhum tenant no filtro informado.</div> }
  else
  {
    <table class="table"><thead><tr><th>Cliente</th><th>Status</th><th>Plano</th><th>Usuários ativos</th><th>Hábitos</th><th>IA</th><th>Chamados</th></tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
      <tr><td>@row.Name</td><td>@row.Status</td><td>@row.Plan</td><td>@row.ActiveUsers</td><td>@row.Habits</td><td>@(row.AiKnown ? row.AiRequests7Days.ToString() : "não disponível")</td><td>@(row.TicketsKnown ? row.OpenTickets.ToString() : "não disponível")</td></tr>
    }
    </tbody></table>
  }
  <p><a href="/superadmin/homologation/export">Exportar CSV</a></p>
</section>
