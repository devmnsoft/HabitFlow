@model IReadOnlyList<HabitFlow.Domain.SuperAdminSubscriptionRow>
@{ ViewData["Title"] = "Assinaturas SuperAdmin"; }
<section class="premium-card"><h1>Assinaturas</h1><table class="table"><thead><tr><th>Cliente</th><th>Plano</th><th>Status</th><th>Ciclo</th><th>Período</th><th>Trial</th><th>Cancelado</th><th>Próxima cobrança</th><th>Ações</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.ClientName</td><td>@s.PlanCode</td><td>@s.Status</td><td>@s.BillingCycle</td><td>@s.CurrentPeriodStart - @s.CurrentPeriodEnd</td><td>@s.TrialEndsAt</td><td>@s.CanceledAt</td><td>@s.NextDueDate</td><td><form method="post" action="/superadmin/subscriptions/@s.Id/cancel">@Html.AntiForgeryToken()<input name="reason" placeholder="Motivo" required minlength="5"/><button>Cancelar</button></form><form method="post" action="/superadmin/subscriptions/@s.Id/reactivate">@Html.AntiForgeryToken()<input name="reason" placeholder="Motivo" required minlength="5"/><button>Reativar</button></form></td></tr>}</tbody></table></section>
