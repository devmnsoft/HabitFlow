@model IReadOnlyList<HabitFlow.Domain.SuperAdminPaymentRow>
@{ ViewData["Title"] = "Inadimplentes SuperAdmin"; }
<section class="premium-card"><h1>Inadimplentes</h1><table class="table"><thead><tr><th>Cliente</th><th>Fatura vencida</th><th>Dias em atraso</th><th>Valor</th><th>Vencimento</th><th>Ações</th></tr></thead><tbody>@foreach(var p in Model){var days=(DateOnly.FromDateTime(DateTime.UtcNow).DayNumber-p.DueDate.DayNumber);<tr><td>@p.ClientName</td><td>@p.InvoiceNumber</td><td>@days</td><td>@p.Amount</td><td>@p.DueDate</td><td><a href="/superadmin/clients/@p.ClientId">Abrir cliente</a><form method="post" action="/superadmin/payments/@p.Id/mark-as-paid">@Html.AntiForgeryToken()<input name="reason" placeholder="Motivo" required minlength="5"/><button>Marcar pago</button></form></td></tr>}</tbody></table></section>
