@model HabitFlow.Domain.SystemHealthStatus
@{ ViewData["Title"] = "System Health"; }
<section class="premium-card"><h1>System Health</h1><dl><dt>Banco</dt><dd>@(Model.DatabaseOk ? "Operacional" : "Indisponível")</dd><dt>Ambiente</dt><dd>@Model.EnvironmentName</dd><dt>Versão</dt><dd>@Model.ApplicationVersion</dd><dt>Porta/URLs</dt><dd>@Model.Urls</dd><dt>Docker obrigatório</dt><dd>@Model.DockerRequired</dd><dt>Mercado Pago</dt><dd>@(Model.MercadoPagoConfigured ? "Configurado" : "Não configurado")</dd><dt>Planos</dt><dd>@Model.PlansCount</dd><dt>Biblioteca de hábitos</dt><dd>@Model.HabitTemplatesCount</dd></dl><h2>Migrations</h2><ul>@foreach(var m in Model.Migrations){<li>@m.Id - @m.Name - @(m.Applied ? "aplicada" : "pendente")</li>}</ul><h2>Tabelas ausentes</h2><ul>@foreach(var t in Model.MissingTables){<li>@t</li>}</ul></section>
