@model IReadOnlyList<HabitFlow.Domain.LgpdRequestRecord>
@{
    ViewData["Title"] = "Gestão LGPD & Governança de Privacidade";
    var openCount = Model.Count(r => r.Status is "Aberta" or "Em análise" or "Aguardando confirmação");
    var processedCount = Model.Count(r => r.Status == "Processada");
}

<div class="container-fluid py-4" style="max-width: 1300px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge" style="background: #e0e7ff; color: #3730a3; font-weight: 600; font-size: 0.75rem; padding: 0.35rem 0.65rem; border-radius: 9999px;">
                    Privacidade & Conformidade
                </span>
                <span class="badge" style="background: @(openCount > 0 ? "#fef3c7" : "#dcfce7"); color: @(openCount > 0 ? "#92400e" : "#166534"); font-weight: 700; font-size: 0.85rem; padding: 0.35rem 0.75rem; border-radius: 9999px;">
                    ● @openCount Pendente(s)
                </span>
            </div>
            <h1 class="h3 fw-bold mb-1" style="color: #0f172a;">Painel de Solicitações LGPD e Governança de Dados</h1>
            <p class="text-muted small mb-0">
                Atendimento aos direitos dos titulares (Art. 18 LGPD): portabilidade, anonimização, exclusão e retificação com isolamento multi-tenant.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/superadmin" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 8px;">
                Painel SuperAdmin
            </a>
        </div>
    </div>

    <!-- Guia de Operação -->
    <div class="alert alert-info border-0 shadow-sm d-flex gap-3 align-items-start mb-4" style="background: #f8fafc; border-left: 4px solid #0284c7 !important; border-radius: 8px; color: #0369a1;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2" class="flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <div class="small">
            <strong>Diretriz de retenção legal:</strong> Exclusão total não apaga notas fiscais ou faturas emitidas vinculadas a obrigações tributárias (Art. 16, I e II).
            Para registros operacionais nessas condições, utilize <em>Anonimização</em> dos identificadores pessoais do usuário.
        </div>
    </div>

    <!-- Indicadores -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 10px; background: #ffffff;">
                <span class="text-muted small text-uppercase fw-bold">Pendentes</span>
                <h3 class="fw-bold mt-2 mb-0" style="color: @(openCount > 0 ? "#b45309" : "#166534");">@openCount</h3>
                <small class="text-muted mt-1">Requerem ação do DPO</small>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 10px; background: #ffffff;">
                <span class="text-muted small text-uppercase fw-bold">Processadas</span>
                <h3 class="fw-bold mt-2 mb-0" style="color: #166534;">@processedCount</h3>
                <small class="text-muted mt-1">Concluídas com sucesso</small>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 10px; background: #ffffff;">
                <span class="text-muted small text-uppercase fw-bold">Total Registrado</span>
                <h3 class="fw-bold mt-2 mb-0" style="color: #0f172a;">@Model.Count</h3>
                <small class="text-muted mt-1">Histórico completo</small>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm p-3" style="border-radius: 10px; background: #ffffff;">
                <span class="text-muted small text-uppercase fw-bold">Prazo Legal (Art. 19)</span>
                <h3 class="fw-bold mt-2 mb-0" style="color: #0f172a;">≤ 15 dias</h3>
                <small class="text-muted mt-1">Conformidade ANPD</small>
            </div>
        </div>
    </div>

    <!-- Filtro de Status -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 10px; background: #ffffff;">
        <div class="card-body p-3">
            <form method="get" action="/superadmin/lgpd" class="d-flex gap-2 align-items-center flex-wrap">
                <label class="small fw-semibold text-muted">Filtrar por Status:</label>
                <select name="status" class="form-select form-select-sm" style="max-width: 200px;">
                    <option value="">Todos os status</option>
                    @foreach (var s in HabitFlow.Domain.LgpdRequestStatuses.All)
                    {
                        <option value="@s" selected="@(ViewData["SelectedStatus"]?.ToString() == s)">@s</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">Filtrar</button>
                @if (ViewData["SelectedStatus"] != null)
                {
                    <a href="/superadmin/lgpd" class="btn btn-outline-secondary btn-sm">Limpar</a>
                }
            </form>
        </div>
    </div>

    <!-- Tabela de Solicitações -->
    <div class="card border-0 shadow-sm" style="border-radius: 10px; background: #ffffff;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.75rem;">
                    <tr>
                        <th style="padding: 0.75rem 1rem;">Data</th>
                        <th style="padding: 0.75rem 1rem;">Tipo</th>
                        <th style="padding: 0.75rem 1rem;">Status</th>
                        <th style="padding: 0.75rem 1rem;">Tenant / Titular</th>
                        <th style="padding: 0.75rem 1rem;">Motivo Informado</th>
                        <th style="padding: 0.75rem 1rem;">Notas do DPO</th>
                        <th style="padding: 0.75rem 1rem; text-align: right;">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Nenhuma solicitação LGPD encontrada.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model)
                        {
                            var isOpen = req.Status is "Aberta" or "Em análise" or "Aguardando confirmação";
                            var isDone = req.Status == "Processada";
                            var statusBg = isOpen ? "#fef3c7" : isDone ? "#dcfce7" : "#fee2e2";
                            var statusColor = isOpen ? "#92400e" : isDone ? "#166534" : "#991b1b";

                            <tr>
                                <td style="padding: 0.75rem 1rem;" class="text-nowrap">
                                    <span class="fw-semibold">@req.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    <small class="text-muted d-block">@req.CreatedAt.ToString("HH:mm") UTC</small>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <span class="badge bg-light text-dark border fw-bold">@req.RequestType</span>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <span class="badge" style="background: @statusBg; color: @statusColor; font-weight: 600; padding: 0.35rem 0.6rem; border-radius: 6px;">
                                        @req.Status
                                    </span>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <div class="small fw-semibold text-truncate" style="max-width: 160px;" title="@req.ClientId">Tenant: @req.ClientId.ToString()[..8]...</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">User: @req.UserId.ToString()[..8]...</div>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <span class="small text-muted" style="max-width: 220px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @(req.Reason ?? "Não especificado")
                                    </span>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <span class="small text-muted" style="max-width: 200px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @(req.AdminNotes ?? "—")
                                    </span>
                                </td>
                                <td style="padding: 0.75rem 1rem; text-align: right;">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openUpdateModal('@req.Id', '@req.RequestType', '@req.Status', '@(req.AdminNotes?.Replace("'", "\\'") ?? "")')">
                                        Atualizar Status
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Atualizar Status LGPD -->
<div id="modalUpdateLgpd" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.6); align-items: center; justify-content: center; z-index: 9999; padding: 1rem;">
    <div style="background: #ffffff; border-radius: 12px; max-width: 500px; width: 100%; padding: 1.75rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
        <form method="post" id="formUpdateLgpd" action="">
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0" style="color: #0f172a;">Atualizar Solicitação LGPD</h5>
                <button type="button" onclick="document.getElementById('modalUpdateLgpd').style.display='none';" class="btn-close"></button>
            </div>
            
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted">Novo Status</label>
                <select name="status" id="modalLgpdStatus" class="form-select form-select-sm" required>
                    @foreach (var s in HabitFlow.Domain.LgpdRequestStatuses.All)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted">Parecer do DPO / Notas Administrativas</label>
                <textarea name="adminNotes" id="modalLgpdNotes" rows="3" class="form-control form-control-sm" placeholder="Ex: Dados anonimizados no banco e faturas mantidas conforme Art. 16 da LGPD..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('modalUpdateLgpd').style.display='none';">Cancelar</button>
                <button type="submit" class="btn btn-primary btn-sm fw-semibold">Salvar com Auditoria</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openUpdateModal(id, type, status, notes) {
        document.getElementById('formUpdateLgpd').action = '/superadmin/lgpd/' + id + '/update-status';
        document.getElementById('modalLgpdStatus').value = status;
        document.getElementById('modalLgpdNotes').value = notes;
        document.getElementById('modalUpdateLgpd').style.display = 'flex';
    }
</script>
