@model HabitFlow.Application.SuperAdminDashboardDto
@{
    ViewData["Title"] = "SuperAdmin";
}
<section class="container py-4 superadmin-shell">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold mb-1">HabitFlow SaaS</p><h1>Dashboard Super Administrador</h1><p class="text-muted">Visão global de clientes, planos, pagamentos, inadimplência e bloqueios.</p></div><a class="btn btn-outline-primary" href="/superadmin/export/clients">Exportar clientes CSV</a></div>
    <div class="row g-3">
        <div class="col-md-2"><div class="card shadow-sm"><div class="card-body"><span>Total de clientes</span><h2>@Model.TotalClients</h2></div></div></div>
        <div class="col-md-2"><div class="card shadow-sm"><div class="card-body"><span>Clientes ativos</span><h2>@Model.ActiveClients</h2></div></div></div>
        <div class="col-md-2"><div class="card shadow-sm"><div class="card-body"><span>Free</span><h2>@Model.FreeClients</h2></div></div></div>
        <div class="col-md-2"><div class="card shadow-sm"><div class="card-body"><span>Premium</span><h2>@Model.PremiumClients</h2></div></div></div>
        <div class="col-md-2"><div class="card shadow-sm"><div class="card-body"><span>Enterprise</span><h2>@Model.EnterpriseClients</h2></div></div></div>
        <div class="col-md-2"><div class="card shadow-sm"><div class="card-body"><span>Inadimplentes</span><h2>0</h2></div></div></div>
    </div>
    <nav class="nav nav-pills my-4"><a class="nav-link" href="/superadmin/clients">Clientes</a><a class="nav-link" href="/superadmin/plans">Planos</a><a class="nav-link" href="/superadmin/subscriptions">Assinaturas</a><a class="nav-link" href="/superadmin/payments">Pagamentos</a><a class="nav-link" href="/superadmin/overdue">Inadimplentes</a><a class="nav-link" href="/superadmin/audit">Logs</a><a class="nav-link" href="/superadmin/system">Sistema</a></nav>
    <div class="row g-3"><div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Visão financeira</h2><p>Receita confirmada, pendente, MRR estimado e cobranças Pix/Boleto ficam centralizadas para confirmação backend/webhook.</p></div></div></div><div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Clientes que precisam de atenção</h2><p>Inadimplentes continuam no Free; apenas benefícios Premium/Enterprise são bloqueados.</p></div></div></div></div>
</section>
