@model (IReadOnlyList<HabitFlow.Domain.OperationalAuditEvent> OpEvents, IReadOnlyList<HabitFlow.Domain.SuperAdminAuditRow> AdminAudits)
@{
    ViewData["Title"] = "Auditoria Operacional & Governança";
    var events = Model.OpEvents ?? Array.Empty<HabitFlow.Domain.OperationalAuditEvent>();
    var adminAudits = Model.AdminAudits ?? Array.Empty<HabitFlow.Domain.SuperAdminAuditRow>();
}

<div class="container-fluid py-4" style="max-width: 1400px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge" style="background: #e0e7ff; color: #3730a3; font-weight: 600; font-size: 0.75rem; padding: 0.35rem 0.65rem; border-radius: 9999px;">
                    Segurança & Rastreabilidade
                </span>
                <span class="badge" style="background: #f1f5f9; color: #475569; font-weight: 600; font-size: 0.75rem; padding: 0.35rem 0.65rem; border-radius: 9999px;">
                    @events.Count evento(s) filtrado(s)
                </span>
            </div>
            <h1 class="h3 fw-bold mb-1" style="color: #0f172a;">Auditoria Operacional e Registro de Eventos</h1>
            <p class="text-muted small mb-0">
                Trilha completa de ações administrativas, alterações de permissão, planos, billing e LGPD com correlação e mascaramento de segredos.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/superadmin/audit/export?@(Context.Request.QueryString.Value?.TrimStart('?'))" class="btn btn-outline-success d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" style="border-radius: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                Exportar CSV Seguro
            </a>
            <a href="/superadmin" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 8px;">
                Voltar ao Painel
            </a>
        </div>
    </div>

    <!-- Guia de Operação -->
    <div class="alert alert-info border-0 shadow-sm d-flex gap-3 align-items-start mb-4" style="background: #f8fafc; border-left: 4px solid #3b82f6 !important; border-radius: 8px; color: #1e3a8a;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" class="flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <div class="small">
            <strong>Regras de auditoria:</strong> Todas as alterações manuais em tenants e cobrança requerem motivo explícito.
            Payloads contendo senhas, tokens ou cartões são automaticamente mascarados antes da persistência.
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 10px; background: #ffffff;">
        <div class="card-body p-3">
            <form method="get" action="/superadmin/audit" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Evento</label>
                    <input type="text" name="eventName" value="@ViewData["EventName"]" placeholder="Ex: tenant.created, plan.changed..." class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Severidade</label>
                    <select name="severity" class="form-select form-select-sm">
                        <option value="">Todas</option>
                        <option value="INFO" selected="@(ViewData["Severity"]?.ToString() == "INFO")">INFO</option>
                        <option value="WARNING" selected="@(ViewData["Severity"]?.ToString() == "WARNING")">WARNING</option>
                        <option value="ERROR" selected="@(ViewData["Severity"]?.ToString() == "ERROR")">ERROR</option>
                        <option value="CRITICAL" selected="@(ViewData["Severity"]?.ToString() == "CRITICAL")">CRITICAL</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Executor (Email/ID)</label>
                    <input type="text" name="executor" value="@ViewData["Executor"]" placeholder="ID ou e-mail..." class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Data Início</label>
                    <input type="date" name="from" value="@ViewData["From"]" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Data Fim</label>
                    <input type="date" name="to" value="@ViewData["To"]" class="form-control form-control-sm" />
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Filtrar</button>
                    <a href="/superadmin/audit" class="btn btn-outline-secondary btn-sm" title="Limpar">✕</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Auditoria Operacional -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 10px; background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color: #0f172a; font-size: 1rem;">Eventos Auditados do SaaS</h5>
            <small class="text-muted">Exibindo até 100 registros mais recentes</small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.75rem;">
                    <tr>
                        <th style="padding: 0.75rem 1rem;">Data/Hora</th>
                        <th style="padding: 0.75rem 1rem;">Evento</th>
                        <th style="padding: 0.75rem 1rem;">Executor</th>
                        <th style="padding: 0.75rem 1rem;">Tenant</th>
                        <th style="padding: 0.75rem 1rem;">Severidade</th>
                        <th style="padding: 0.75rem 1rem;">Status</th>
                        <th style="padding: 0.75rem 1rem; text-align: right;">Detalhes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (events.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Nenhum evento de auditoria encontrado com os filtros aplicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ev in events)
                        {
                            var isCrit = ev.Severity is "CRITICAL" or "ERROR";
                            var isWarn = ev.Severity is "WARNING";
                            var badgeBg = isCrit ? "#fee2e2" : isWarn ? "#fef3c7" : "#e0f2fe";
                            var badgeColor = isCrit ? "#991b1b" : isWarn ? "#92400e" : "#075985";

                            <tr>
                                <td style="padding: 0.75rem 1rem;" class="text-nowrap">
                                    <span class="fw-semibold">@ev.OccurredAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">@ev.OccurredAt.ToString("ss.fff")s UTC</small>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <code class="fw-bold" style="color: #1e40af;">@ev.EventName</code>
                                    <small class="d-block text-muted" style="font-size: 0.7rem;">Corr: @ev.CorrelationId[..Math.Min(8, ev.CorrelationId.Length)]...</small>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <span>@(ev.ExecutorEmail ?? ev.ExecutorUserId ?? "Sistema")</span>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    @if (ev.ClientId.HasValue && ev.ClientId != Guid.Empty)
                                    {
                                        <a href="/superadmin/clients/@ev.ClientId" class="text-decoration-none fw-semibold">
                                            @ev.ClientId.Value.ToString()[..8]...
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Global</span>
                                    }
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <span class="badge" style="background: @badgeBg; color: @badgeColor; font-weight: 600; padding: 0.3rem 0.55rem; border-radius: 6px;">
                                        @ev.Severity
                                    </span>
                                </td>
                                <td style="padding: 0.75rem 1rem;">
                                    <span class="badge bg-light text-dark border">@ev.Status</span>
                                </td>
                                <td style="padding: 0.75rem 1rem; text-align: right;">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="showPayloadModal('@ev.EventName', '@ev.CorrelationId', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ev.PayloadJson)))">
                                        Ver Payload
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Detalhes Seguros do Payload -->
<div id="modalPayload" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.6); align-items: center; justify-content: center; z-index: 9999; padding: 1rem;">
    <div style="background: #ffffff; border-radius: 12px; max-width: 600px; width: 100%; padding: 1.5rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-0" id="modalPayloadTitle" style="color: #0f172a;">Detalhes Auditados</h5>
                <small class="text-muted" id="modalPayloadCorr"></small>
            </div>
            <button type="button" onclick="document.getElementById('modalPayload').style.display='none';" class="btn-close"></button>
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold text-muted">Payload Sanitizado (JSON):</label>
            <pre id="modalPayloadContent" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; font-size: 0.85rem; max-height: 320px; overflow-y: auto; white-space: pre-wrap; word-break: break-all; color: #0f172a;"></pre>
        </div>
        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('modalPayload').style.display='none';">Fechar</button>
        </div>
    </div>
</div>

<script>
    function showPayloadModal(eventName, corrId, payload) {
        document.getElementById('modalPayloadTitle').textContent = 'Evento: ' + eventName;
        document.getElementById('modalPayloadCorr').textContent = 'Correlation ID: ' + corrId;
        try {
            const parsed = JSON.parse(payload);
            document.getElementById('modalPayloadContent').textContent = JSON.stringify(parsed, null, 2);
        } catch {
            document.getElementById('modalPayloadContent').textContent = payload || 'Sem payload registrado.';
        }
        document.getElementById('modalPayload').style.display = 'flex';
    }
</script>
