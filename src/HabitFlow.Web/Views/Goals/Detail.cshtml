@model GoalDetailsViewModel
@{ViewData["Title"]=Model.Goal.Title;}
@section Styles{<link rel="stylesheet" href="~/css/goals-v5.css" asp-append-version="true">}
<header class="hf-goal-detail-hero"><div><a href="/goals" class="hf-back-link">Voltar aos objetivos</a><p class="hf-section-kicker">Objetivo em foco</p><h1>@Model.Goal.Title</h1><p>@Model.Goal.Description</p></div><a class="btn btn-outline-success" href="/goals/@Model.Goal.Id/edit">Editar objetivo</a></header>
<div class="hf-goal-detail-grid"><main><section class="hf-card"><h2>Quanto já avancei</h2><partial name="Partials/_GoalProgressBar" model="Model.Progress" /></section><partial name="Partials/_GoalLinkedHabits" model="Model" /><partial name="Partials/_GoalTimeline" model="Model.Timeline" /></main><aside><partial name="Partials/_GoalRecommendationCard" model="Model.Recommendation" /><partial name="Partials/_GoalLifecycleModal" model="Model.Goal" /></aside></div>
@section Scripts{<script src="~/js/goals-v5.js" asp-append-version="true"></script>}
