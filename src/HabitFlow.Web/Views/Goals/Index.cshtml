@model GoalListViewModel
@{ViewData["Title"]="Objetivos";}
@section Styles{<link rel="stylesheet" href="~/css/goals-v5.css" asp-append-version="true">}
<partial name="Partials/_GoalHero" model="Model" />
<partial name="Partials/_GoalFilters" model="Model" />
@if(Model.Goals.Count==0){<partial name="Partials/_GoalEmptyState" />}
else{<section class="hf-goal-grid" aria-label="Objetivos encontrados">@foreach(var item in Model.Goals){<partial name="Partials/_GoalCard" model="item" />}</section>}
@section Scripts{<script src="~/js/goals-v5.js" asp-append-version="true"></script>}
