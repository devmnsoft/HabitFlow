@{ViewData["Title"]="Novo objetivo";}
<header class="hf-page-header"><div><p class="hf-section-kicker">Um passo de cada vez</p><h1>Criar objetivo</h1><p>Dê um nome claro ao que você quer acompanhar.</p></div></header>
<form method="post" class="hf-card mx-auto" style="max-width:44rem">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label class="form-label" for="title">Título</label><input class="form-control" id="title" name="title" maxlength="160" required></div><div class="mb-3"><label class="form-label" for="description">Por que isso importa?</label><textarea class="form-control" id="description" name="description" rows="3"></textarea></div><div class="row g-3"><div class="col-md-6"><label class="form-label" for="targetType">Como acompanhar</label><select class="form-select" id="targetType" name="targetType"><option value="HabitCompletions">Conclusões de hábitos</option><option value="ActiveDays">Dias presentes</option><option value="StreakDays">Dias em sequência</option><option value="WeeklyCompletions">Conclusões por semana</option><option value="Custom">Valor personalizado</option></select></div><div class="col-md-6"><label class="form-label" for="targetValue">Meta</label><input class="form-control" id="targetValue" name="targetValue" type="number" min="1" required></div><div class="col-md-6"><label class="form-label" for="startDate">Início</label><input class="form-control" id="startDate" name="startDate" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required></div><div class="col-md-6"><label class="form-label" for="endDate">Prazo opcional</label><input class="form-control" id="endDate" name="endDate" type="date"></div></div><button class="btn btn-success mt-4">Guardar objetivo</button></form>
