@model HabitFlow.Domain.UserGoal
@{ViewData["Title"]=Model.Title;var percent=Math.Min(100,Model.TargetValue==0?0:Model.CurrentValue*100/Model.TargetValue);}
<header class="hf-page-header"><div><p class="hf-section-kicker">Objetivo em foco</p><h1>@Model.Title</h1><p>@Model.Description</p></div><a class="btn btn-outline-success" href="/goals/@Model.Id/edit">Editar</a></header><section class="hf-card"><h2 class="h5">Seu progresso</h2><div class="progress my-3" role="progressbar" aria-label="@percent% concluído"><div class="progress-bar bg-success" style="width:@percent%">@percent%</div></div><p>@Model.CurrentValue de @Model.TargetValue</p><div class="d-flex gap-2">@if(Model.Status=="Active"){<form method="post" action="/goals/@Model.Id/pause">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary">Pausar</button></form>}else if(Model.Status=="Paused"){<form method="post" action="/goals/@Model.Id/resume">@Html.AntiForgeryToken()<button class="btn btn-success">Retomar</button></form>}<form method="post" action="/goals/@Model.Id/cancel">@Html.AntiForgeryToken()<button class="btn btn-link text-secondary">Encerrar</button></form></div></section>
