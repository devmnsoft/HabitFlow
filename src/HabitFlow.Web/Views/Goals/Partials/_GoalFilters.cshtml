@model GoalListViewModel
<form method="get" class="hf-goal-filters" role="search"><div><label for="goal-search">Buscar objetivo</label><input id="goal-search" class="form-control" type="search" name="search" value="@Model.Search" placeholder="Ex.: cuidar da saúde"></div><div><label for="goal-status">Status</label><select id="goal-status" class="form-select" name="status"><option value="All" selected="@(Model.Status=="All")">Todos</option><option value="Active" selected="@(Model.Status=="Active")">Ativos</option><option value="Paused" selected="@(Model.Status=="Paused")">Pausados</option><option value="Completed" selected="@(Model.Status=="Completed")">Concluídos</option><option value="Canceled" selected="@(Model.Status=="Canceled")">Encerrados</option></select></div><button class="btn btn-outline-success">Aplicar filtros</button></form>
