@model GoalListViewModel
<form method="get" class="hf-goal-filters" role="search"><div><label for="goal-search">Buscar objetivo</label><input id="goal-search" class="form-control" type="search" name="search" value="@Model.Search" placeholder="Ex.: cuidar da saúde"></div><div><label for="goal-status">Status</label><select id="goal-status" class="form-select" name="status"><option value="All" selected="@(Model.Status=="All")">Todos</option><option value="Active" selected="@(Model.Status=="Active")">Ativos</option><option value="Paused" selected="@(Model.Status=="Paused")">Pausados</option><option value="Completed" selected="@(Model.Status=="Completed")">Concluídos</option><option value="Canceled" selected="@(Model.Status=="Canceled")">Cancelados</option></select></div><div><label for="goal-sort">Ordenar</label><select id="goal-sort" class="form-select" name="sort"><option value="recent" selected="@(Model.Sort=="recent")">Mais recentes</option><option value="progress-asc" selected="@(Model.Sort=="progress-asc")">Menor progresso</option><option value="progress-desc" selected="@(Model.Sort=="progress-desc")">Maior progresso</option><option value="deadline" selected="@(Model.Sort=="deadline")">Prazo mais próximo</option><option value="linked" selected="@(Model.Sort=="linked")">Com hábitos vinculados</option><option value="unlinked" selected="@(Model.Sort=="unlinked")">Sem hábitos vinculados</option></select></div><button class="btn btn-outline-success">Aplicar filtros</button></form>
