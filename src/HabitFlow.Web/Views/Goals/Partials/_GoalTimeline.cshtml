@model IReadOnlyList<GoalTimelineEntry>
<section class="hf-card"><h2>Timeline do objetivo</h2>@if(Model.Count==0){<p class="hf-inline-empty">As conclusões dos hábitos aparecerão aqui.</p>}else{<ol class="hf-goal-timeline">@foreach(var item in Model){<li><span></span><div><strong>@item.EventType</strong><p>@item.PreviousValue → @item.CurrentValue · <time datetime="@item.CreatedAt.ToString("O")">@item.LocalDate.ToString("dd/MM/yyyy")</time></p></div></li>}</ol>}</section>
