@model GoalDetailsViewModel
<section class="hf-card" id="linked-habits"><div class="hf-section-heading"><div><h2>Hábitos que ajudam</h2><p>O progresso é calculado somente com conclusões reais.</p></div></div>@if(Model.LinkedHabits.Count==0){<p class="hf-inline-empty">Conecte um hábito para transformar intenção em ação.</p>}else{<ul class="hf-linked-list">@foreach(var habit in Model.LinkedHabits){<li><span><strong>@habit.Name</strong><small>@(habit.IsPaused?"Pausado":"Ativo")</small></span><form method="post" action="/goals/@Model.Goal.Id/unlink-habit">@Html.AntiForgeryToken()<input type="hidden" name="habitId" value="@habit.Id"><button class="btn btn-sm btn-outline-secondary">Desconectar</button></form></li>}</ul>}@if(Model.AvailableHabits.Count>0){<form class="hf-link-form" method="post" action="/goals/@Model.Goal.Id/link-habit">@Html.AntiForgeryToken()<label for="habitId">Adicionar hábito</label><div><select class="form-select" id="habitId" name="habitId" required><option value="">Selecione</option>@foreach(var habit in Model.AvailableHabits){<option value="@habit.Id">@habit.Name</option>}</select><button class="btn btn-success">Conectar</button></div></form>}</section>
