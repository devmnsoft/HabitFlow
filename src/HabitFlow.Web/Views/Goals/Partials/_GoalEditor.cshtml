@model HabitFlow.Web.Models.GoalFormViewModel
@{var action=Model.GoalId is null?"/goals/create":$"/goals/{Model.GoalId}/edit";}
<form method="post" action="@action" class="hf-card hf-goal-editor" data-hf-validate novalidate>
  @Html.AntiForgeryToken()
  <div asp-validation-summary="All" class="hf-form-error" role="alert" tabindex="-1"></div>
  <fieldset><legend>1. Sua direção</legend>
    <label asp-for="Title">Onde você quer chegar? <span class="visually-hidden">(obrigatório)</span></label>
    <input class="form-control" asp-for="Title" maxlength="160" required aria-required="true"><span asp-validation-for="Title" class="hf-validation-message"></span>
    <label asp-for="Description">Por que isso importa?</label>
    <textarea class="form-control" asp-for="Description" maxlength="1000" rows="3"></textarea><span asp-validation-for="Description" class="hf-validation-message"></span>
  </fieldset>
  <fieldset><legend>2. Como medir</legend><div class="row g-3">
    <div class="col-md-7"><label asp-for="TargetType">Indicador real <span class="visually-hidden">(obrigatório)</span></label><select class="form-select" asp-for="TargetType" required aria-required="true"><option value="HabitCompletions">Conclusões dos hábitos conectados</option><option value="ActiveDays">Dias com conclusão</option><option value="StreakDays">Dias em sequência</option><option value="WeeklyCompletions">Conclusões na semana</option><option value="Custom">Valor personalizado</option></select><span asp-validation-for="TargetType" class="hf-validation-message"></span></div>
    <div class="col-md-5"><label asp-for="TargetValue">Meta <span class="visually-hidden">(obrigatório)</span></label><input class="form-control" asp-for="TargetValue" type="number" min="1" max="100000" required aria-required="true"><span asp-validation-for="TargetValue" class="hf-validation-message"></span></div>
  </div></fieldset>
  <fieldset><legend>3. Horizonte</legend><div class="row g-3">
    <div class="col-md-6"><label asp-for="StartDate">Início <span class="visually-hidden">(obrigatório)</span></label><input class="form-control" asp-for="StartDate" type="date" required aria-required="true"><span asp-validation-for="StartDate" class="hf-validation-message"></span></div>
    <div class="col-md-6"><label asp-for="EndDate">Prazo opcional</label><input class="form-control" asp-for="EndDate" type="date"><span asp-validation-for="EndDate" class="hf-validation-message"></span></div>
  </div></fieldset>
  <div class="hf-editor-actions"><a class="btn btn-outline-secondary" href="@(Model.GoalId is null?"/goals":$"/goals/{Model.GoalId}")">Cancelar</a><button class="btn btn-success" type="submit" data-loading-text="Salvando…">@(Model.GoalId is null?"Criar e conectar hábitos":"Salvar alterações")</button></div>
</form>
