@model GoalEditorViewModel
@{var goal=Model.Goal;var action=goal is null?"/goals/create":$"/goals/{goal.Id}/edit";}
<form method="post" action="@action" class="hf-card hf-goal-editor">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger" role="alert"></div><fieldset><legend>1. Sua direção</legend><label for="title">Onde você quer chegar?</label><input class="form-control" id="title" name="title" maxlength="160" value="@goal?.Title" required><label for="description">Por que isso importa?</label><textarea class="form-control" id="description" name="description" rows="3">@goal?.Description</textarea></fieldset><fieldset><legend>2. Como medir</legend><div class="row g-3"><div class="col-md-7"><label for="targetType">Indicador real</label><select class="form-select" id="targetType" name="targetType"><option value="HabitCompletions" selected="@(goal?.TargetType=="HabitCompletions")">Conclusões dos hábitos conectados</option><option value="ActiveDays" selected="@(goal?.TargetType=="ActiveDays")">Dias com conclusão</option><option value="StreakDays" selected="@(goal?.TargetType=="StreakDays")">Dias em sequência</option><option value="WeeklyCompletions" selected="@(goal?.TargetType=="WeeklyCompletions")">Conclusões na semana</option><option value="Custom" selected="@(goal?.TargetType=="Custom")">Valor personalizado</option></select></div><div class="col-md-5"><label for="targetValue">Meta</label><input class="form-control" id="targetValue" name="targetValue" type="number" min="1" value="@(goal?.TargetValue??1)" required></div></div></fieldset><fieldset><legend>3. Horizonte</legend><div class="row g-3"><div class="col-md-6"><label for="startDate">Início</label><input class="form-control" id="startDate" name="startDate" type="date" value="@Model.DefaultStartDate.ToString("yyyy-MM-dd")" required></div><div class="col-md-6"><label for="endDate">Prazo opcional</label><input class="form-control" id="endDate" name="endDate" type="date" value="@(goal?.EndDate?.ToString("yyyy-MM-dd"))"></div></div></fieldset><div class="hf-editor-actions"><a class="btn btn-outline-secondary" href="@(goal is null?"/goals":$"/goals/{goal.Id}")">Cancelar</a><button class="btn btn-success">@(goal is null?"Criar e conectar hábitos":"Salvar alterações")</button></div></form>
