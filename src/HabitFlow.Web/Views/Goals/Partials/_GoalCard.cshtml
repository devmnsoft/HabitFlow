@model GoalCardViewModel
@{ var remaining = Model.Goal.EndDate.HasValue ? Model.Goal.EndDate.Value.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber : (int?)null; }
<article class="hf-goal-card"><div class="hf-goal-card-top"><span class="hf-goal-status hf-goal-status-@Model.Goal.Status.ToLowerInvariant()">@Model.Goal.Status</span><span>@Model.LinkedHabitCount hábito(s) conectado(s)</span></div><h2><a href="/goals/@Model.Goal.Id">@Model.Goal.Title</a></h2><p>@(string.IsNullOrWhiteSpace(Model.Goal.Description)?"Defina por que este objetivo importa para manter a direção clara.":Model.Goal.Description)</p><partial name="Partials/_GoalProgressBar" model="Model.Progress" /><div class="hf-goal-meta"><span>@Model.Progress.CurrentValue de @Model.Progress.TargetValue</span>@if(remaining.HasValue){<span>@(remaining < 0 ? "Prazo encerrado" : remaining == 0 ? "Termina hoje" : $"{remaining} dias restantes")</span>}</div><p class="hf-goal-next"><strong>Próxima ação:</strong> @(Model.LinkedHabitCount == 0 ? "vincule um hábito pequeno." : Model.Progress.Percentage >= 90 ? "falta pouco: conclua o próximo passo." : "avance em um hábito vinculado.")</p><div class="hf-goal-actions"><a class="hf-card-link" href="/goals/@Model.Goal.Id">Ver detalhes <span aria-hidden="true">→</span></a>@if(Model.LinkedHabitCount==0){<a class="btn btn-sm btn-outline-success" href="/goals/@Model.Goal.Id#linked-habits">Vincular hábito</a>}</div></article>
