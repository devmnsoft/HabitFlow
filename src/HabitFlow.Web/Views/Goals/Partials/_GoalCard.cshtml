@model GoalCardViewModel
<article class="hf-goal-card"><div class="hf-goal-card-top"><span class="hf-goal-status hf-goal-status-@Model.Goal.Status.ToLowerInvariant()">@Model.Goal.Status</span><span>@Model.LinkedHabitCount hábito(s) conectado(s)</span></div><h2><a href="/goals/@Model.Goal.Id">@Model.Goal.Title</a></h2><p>@(string.IsNullOrWhiteSpace(Model.Goal.Description)?"Defina por que este objetivo importa para manter a direção clara.":Model.Goal.Description)</p><partial name="Partials/_GoalProgressBar" model="Model.Progress" /><a class="hf-card-link" href="/goals/@Model.Goal.Id">Ver plano e próxima ação <span aria-hidden="true">→</span></a></article>
