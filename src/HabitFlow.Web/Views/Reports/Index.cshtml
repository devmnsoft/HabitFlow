@model HabitFlow.Application.PersonalReport
@{ ViewData["Title"] = "Relatórios"; var rate = Model?.CompletionRate ?? 0; var period = ViewData["ReportPeriod"] as string ?? "weekly"; }
<header class="hf-page-header"><div><p class="hf-eyebrow">Relatórios pessoais</p><h1>Resumo @(period == "monthly" ? "mensal" : "semanal")</h1><p>Período de @Model.PeriodStart.ToString("dd/MM/yyyy") a @Model.PeriodEnd.ToString("dd/MM/yyyy"), calculado a partir da sua agenda e das conclusões reais.</p></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-secondary" href="/reports/monthly/export/pdf">Exportar PDF <span class="badge text-bg-warning">Premium</span></a><a class="btn btn-success" href="/reports/export-csv">Exportar CSV <span class="badge text-bg-light">Premium</span></a></div></header>
<nav class="nav nav-pills mb-4" aria-label="Período do relatório"><a class="nav-link @(period == "weekly" ? "active" : null)" href="/reports/weekly" aria-current="@(period == "weekly" ? "page" : null)">Esta semana</a><a class="nav-link @(period == "monthly" ? "active" : null)" href="/reports/monthly" aria-current="@(period == "monthly" ? "page" : null)">Este mês</a></nav>
@if ((Model?.TotalCompletions ?? 0) == 0) { <div class="alert alert-info">Você ainda não possui conclusões suficientes para gerar um relatório completo. Comece marcando seus hábitos no Dashboard.</div> }
<section class="hf-grid mb-4"><div class="hf-col-3 hf-metric-card"><span>Planejados</span><strong>@Model.Planned</strong><small>no período</small></div><div class="hf-col-3 hf-metric-card"><span>Conclusões</span><strong>@Model.TotalCompletions</strong><small>registros reais</small></div><div class="hf-col-3 hf-metric-card"><span>Dias ativos</span><strong>@Model.ActiveDays</strong><small>com pelo menos um check</small></div><div class="hf-col-3 hf-card"><h2 class="h5">Consistência</h2><div class="progress" role="progressbar" aria-label="Taxa de consistência" aria-valuenow="@rate" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@rate%">@rate%</div></div></div></section>
<section class="row g-3"><div class="col-lg-6"><div class="hf-card h-100"><h2>Leitura do período</h2><p class="text-muted">Você concluiu @Model.TotalCompletions de @Model.Planned ações planejadas. Use a taxa para comparar seu próprio ritmo, sem buscar perfeição.</p></div></div><div class="col-lg-6"><div class="hf-card h-100"><h2>Próxima semana</h2><p class="text-muted">@(rate >= 70 ? "Preserve os horários e contextos que já funcionaram." : "Reduza um hábito difícil e escolha um primeiro passo de poucos minutos.")</p></div></div><div class="col-12"><div class="alert alert-success hf-alert">@Model.Insight</div></div></section>
