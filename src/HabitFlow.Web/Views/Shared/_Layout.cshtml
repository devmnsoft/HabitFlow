@using HabitFlow.Web.Models
@inject HabitFlow.Web.Services.LayoutContextResolver ContextResolver
@inject IWebHostEnvironment HostEnvironment
@inject HabitFlow.Application.ProductTipService ProductTips
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var title = ViewData["Title"] as string ?? "HabitFlow";
    var navigationContext = ContextResolver.Resolve(Context, ViewContext.RouteData, ViewData);
    var contextName = navigationContext.ToString().ToLowerInvariant();
    var contextualStylesheet = $"{contextName}.css";
    var sidebarVariant = navigationContext == NavigationContext.Account ? NavigationVariant.AccountSidebar : NavigationVariant.PlatformSidebar;
    var hasSidebar = navigationContext is NavigationContext.Account or NavigationContext.Platform;
    var tipClientId = Guid.TryParse(User?.FindFirst("client_id")?.Value, out var parsedClientId) ? parsedClientId : Guid.Empty;
    var tipUserId = Guid.TryParse(User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var parsedUserId) ? parsedUserId : Guid.Empty;
    var productTip = isAuthenticated
      ? await ProductTips.GetNextAsync(tipClientId, tipUserId, Context.Request.Path, Context.RequestAborted)
      : null;
    var version = typeof(Program).Assembly.GetName().Version?.ToString(3) ?? "6.5.1";
}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>@title · HabitFlow</title>
  <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true">
  <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true">
  <meta name="theme-color" content="#10B981">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="apple-touch-icon" href="~/icons/icon-192.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/feedback-v5.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/layout-premium.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/layout-stabilization.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/navigation-premium.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/app-shell-premium.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/global-search.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/header-v4.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/navigation-v4.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/product-tips-v4.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/@contextualStylesheet" asp-append-version="true">
  <link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/product-polish-v6129.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/print.css" media="print" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hf-contrast-default hf-font-normal hf-context-@contextName" data-navigation-context="@contextName">
<a class="visually-hidden-focusable hf-skip" href="#conteudo">Ir para o conteúdo</a>
@await Component.InvokeAsync("AppHeader")
<div class="hf-page @(hasSidebar ? "hf-page-with-sidebar" : null)">
  @if (hasSidebar)
  {
    <aside class="hf-context-sidebar" aria-label="Menu @(navigationContext == NavigationContext.Account ? "da conta" : "da plataforma")">@await Component.InvokeAsync("Navigation", new { context = navigationContext, variant = sidebarVariant })</aside>
  }
  <main id="conteudo" class="hf-main" tabindex="-1">
    <div class="hf-content-shell">
      @await Html.PartialAsync("~/Views/Shared/Partials/_AppMessages.cshtml")
      @await Html.PartialAsync("~/Views/Shared/Partials/_FeedbackBridge.cshtml")
      @RenderBody()
    </div>
  </main>
</div>
@if (navigationContext == NavigationContext.Public)
{
  <footer class="hf-footer hf-public-footer" data-footer-context="public"><div class="hf-shell hf-footer-grid"><div>@await Html.PartialAsync("~/Views/Shared/Partials/_MNSOFTBrandBadge.cshtml", null, new ViewDataDictionary(ViewData) { ["Compact"] = "true" })</div><div><h2>HabitFlow</h2><p>Hábitos, rotina e progresso em um só lugar.</p></div><nav aria-label="Produto"><h2>Produto</h2><a href="/demo">Como funciona</a><a href="/habit-library">Biblioteca</a><a href="/plans">Planos</a></nav><nav aria-label="Suporte e legal"><h2>Confiança</h2><a href="/help">Ajuda</a><a href="/privacy">Privacidade</a><a href="/terms">Termos</a><a href="/legal/cookies">Cookies</a><a href="/lgpd">LGPD</a></nav></div><div class="hf-shell hf-footer-bottom">© 2026 MNSOFT — CNPJ 18.160.057/0001-13</div></footer>
}
else if (navigationContext == NavigationContext.Platform)
{
  <footer class="hf-footer hf-operational-footer" data-footer-context="platform"><div class="hf-shell">HabitFlow v@version · @HostEnvironment.EnvironmentName · <a href="/health">Health</a> · MNSOFT</div></footer>
}
else
{
  <footer class="hf-footer hf-compact-footer" data-footer-context="@contextName"><div class="hf-shell">HabitFlow · <a href="/help">Ajuda</a> · <a href="/privacy">Política de Privacidade</a> · <a href="/account/privacy">Gerenciar privacidade</a> · <a href="/account/security">Segurança</a> · <a href="/account/plan/usage">Plano</a> · v@version · MNSOFT</div></footer>
}
@await Html.PartialAsync("~/Views/Shared/Partials/_ToastHost.cshtml")
@await Html.PartialAsync("~/Views/Shared/Partials/_FeedbackModal.cshtml")
@await Html.PartialAsync("~/Views/Shared/Partials/_ConfirmationDialog.cshtml")
@if (productTip is not null) { @await Html.PartialAsync("~/Views/Shared/Partials/_ProductTipPopover.cshtml", productTip) }
@if (isAuthenticated && navigationContext != NavigationContext.Public) { @await Html.PartialAsync("~/Views/Shared/Partials/_GlobalSearchModal.cshtml") }
@if (isAuthenticated && navigationContext != NavigationContext.Public) { <a class="hf-assistant-fab" href="/assistant" aria-label="Abrir Assistente HabitFlow">✦<span>Assistente</span></a> }
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/design-system.js" asp-append-version="true"></script>
<script src="~/js/feedback-system.js" asp-append-version="true"></script>
<script src="~/js/feedback-v5.js" asp-append-version="true"></script>
<script src="~/js/modal-manager.js" asp-append-version="true"></script>
<script src="~/js/form-validation.js" asp-append-version="true"></script>
<script src="~/js/guided-tour.js" asp-append-version="true"></script>
<script src="~/js/pwa.js" asp-append-version="true"></script>
<script src="~/js/offline-sync.js" asp-append-version="true"></script>
<script src="~/js/navigation-premium.js" asp-append-version="true"></script>
<script src="~/js/app-shell-premium.js" asp-append-version="true"></script>
<script src="~/js/global-search.js" asp-append-version="true"></script>
<script src="~/js/header-v4.js" asp-append-version="true"></script>
<script src="~/js/guided-tour-v4.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
