@using System.Security.Claims
@using HabitFlow.Web.Models
@inject HabitFlow.Web.Services.NavigationService Navigation
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var userName = User?.FindFirst(ClaimTypes.Name)?.Value ?? User?.Identity?.Name ?? "Visitante";
    var userEmail = User?.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var isAdmin = User?.IsInRole("Admin") == true || User?.FindFirst(ClaimTypes.Role)?.Value == "Admin";
    var title = ViewData["Title"] as string ?? "HabitFlow";
    var navigationContext = ViewData["NavigationContext"] is NavigationContext value ? value : (isAuthenticated ? NavigationContext.Personal : NavigationContext.Public);
    var layoutClass = ViewData["LayoutClass"] as string ?? "hf-public";
    var contextualStylesheet = navigationContext switch
    {
        NavigationContext.Personal => "personal.css",
        NavigationContext.Account => "account.css",
        NavigationContext.Platform => "platform.css",
        _ => "public.css"
    };
}
<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@title · HabitFlow</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#10B981">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/base.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/components.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/@contextualStylesheet" asp-append-version="true">
  <link rel="stylesheet" href="/css/accessibility.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/responsive.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/print.css" media="print" asp-append-version="true">
</head>
<body class="hf-contrast-default hf-font-normal @layoutClass">
<a class="visually-hidden-focusable hf-skip" href="#conteudo">Ir para o conteúdo</a>
<header class="hf-topbar">
  <nav class="navbar navbar-expand-lg" aria-label="Navegação principal">
    <div class="container-fluid hf-shell">
      <a class="hf-brand" href="/"><span class="hf-brand-mark" aria-hidden="true">✓</span><span><strong>HabitFlow</strong><small>Consistência diária, sem complicação.</small></span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hfNav" aria-controls="hfNav" aria-expanded="false" aria-label="Abrir menu"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="hfNav">
        @await Component.InvokeAsync("Navigation", new { context = navigationContext })
        <div class="hf-user-area @(isAuthenticated ? "hf-session-actions" : "hf-auth-actions")">
          @if (isAuthenticated) { @await Html.PartialAsync("~/Views/Shared/Partials/_NotificationBell.cshtml") }
          @if (isAuthenticated) { <a class="btn btn-outline-success" href="/account/plan">Meu plano</a>@if(Navigation.HasPlatformAccess(User!)){<a class="btn btn-outline-secondary" href="/superadmin">Gestão da Plataforma</a>}<div class="hf-user-chip"><span>@userName</span><small>@userEmail</small></div><button type="button" class="btn btn-outline-success" data-pwa-install hidden>Instalar HabitFlow</button><form method="post" action="/logout" class="m-0">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary" data-loading-text="Saindo...">Sair</button></form> } else { <a class="btn btn-outline-success" href="/login">Entrar</a><a class="btn btn-success btn-primary-cta" href="/register">Começar grátis</a> }
        </div>
      </div>
    </div>
  </nav>
</header>
<main id="conteudo" class="hf-main" tabindex="-1">
  <div class="container-fluid hf-shell">
    @await Html.PartialAsync("~/Views/Shared/Partials/_AppMessages.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_FeedbackBridge.cshtml")
    @RenderBody()
  </div>
</main>
<footer class="hf-footer"><div class="container-fluid hf-shell hf-footer-premium"><div>@await Html.PartialAsync("~/Views/Shared/Partials/_MNSOFTBrandBadge.cshtml", null, new ViewDataDictionary(ViewData){{"Compact","true"}})</div><div><h2>HabitFlow</h2><p>Hábitos, rotina e progresso em um só lugar.</p></div><nav aria-label="Produto"><h2>Produto</h2><ul class="hf-footer-links"><li><a href="/">Início</a></li><li><a href="/demo">Demonstração</a></li><li><a href="/habit-library">Biblioteca</a></li><li><a href="/plans">Planos</a></li></ul></nav><nav aria-label="Suporte"><h2>Suporte</h2><ul class="hf-footer-links"><li><a href="/help">Central de Ajuda</a></li><li><a href="/support">Suporte</a></li><li><a href="/privacy">Privacidade</a></li><li><a href="/terms">Termos</a></li><li><a href="/lgpd">LGPD</a></li></ul></nav></div><div class="container-fluid hf-shell hf-footer-bottom">© 2026 MNSOFT — CNPJ 18.160.057/0001-13 — comercial@mnsoft.com.br</div></footer>
@await Html.PartialAsync("~/Views/Shared/Partials/_ToastHost.cshtml")
@await Html.PartialAsync("~/Views/Shared/Partials/_FeedbackModal.cshtml")
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/site.js" asp-append-version="true"></script><script src="/js/guided-tour.js" asp-append-version="true"></script><script src="/js/pwa.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", false)
</body></html>
