@using System.Security.Claims
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var userName = User?.FindFirst(ClaimTypes.Name)?.Value ?? User?.Identity?.Name ?? "Visitante";
    var userEmail = User?.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var isAdmin = User?.IsInRole("Admin") == true || User?.FindFirst(ClaimTypes.Role)?.Value == "Admin";
    var title = ViewData["Title"] as string ?? "HabitFlow";
}
<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@title · HabitFlow</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
</head>
<body>
<a class="visually-hidden-focusable hf-skip" href="#conteudo">Ir para o conteúdo</a>
<header class="hf-topbar">
  <nav class="navbar navbar-expand-lg" aria-label="Navegação principal">
    <div class="container-fluid hf-shell">
      <a class="hf-brand" href="/"><span class="hf-brand-mark" aria-hidden="true">✓</span><span><strong>HabitFlow</strong><small>Consistência diária, sem complicação.</small></span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hfNav" aria-controls="hfNav" aria-expanded="false" aria-label="Abrir menu"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="hfNav">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 hf-nav-links">
          <li class="nav-item"><a class="nav-link" href="/">Início</a></li><li class="nav-item"><a class="nav-link" href="/habit-library">Biblioteca</a></li><li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li><li class="nav-item"><a class="nav-link" href="/habits">Hábitos</a></li><li class="nav-item"><a class="nav-link" href="/progress">Progresso</a></li><li class="nav-item"><a class="nav-link" href="/reports">Relatórios</a></li><li class="nav-item"><a class="nav-link" href="/support">Suporte</a></li>@if(isAdmin){<li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>}
        </ul>
        <div class="hf-user-area">
          @await Html.PartialAsync("~/Views/Shared/Partials/_NotificationBell.cshtml")
          @if (isAuthenticated) { <div class="hf-user-chip"><span>@userName</span><small>@userEmail</small></div><span class="hf-plan-badge">Free</span><form method="post" action="/logout" class="m-0">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary" data-loading-text="Saindo...">Logout</button></form> } else { <a class="btn btn-outline-success" href="/login">Entrar</a><a class="btn btn-success" href="/register">Começar grátis</a> }
        </div>
      </div>
    </div>
  </nav>
</header>
<main id="conteudo" class="hf-main" tabindex="-1">
  <div class="container-fluid hf-shell">
    @foreach (var key in new[]{"Success","Info","Error"}) { if (TempData[key] is not null) { var cls = key == "Error" ? "danger" : key == "Info" ? "info" : "success"; <div class="alert alert-@cls hf-alert alert-dismissible fade show" role="status"><span>@TempData[key]</span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button></div> } }
    @RenderBody()
  </div>
</main>
<footer class="hf-footer"><div class="container-fluid hf-shell"><div class="hf-footer-brand">@await Html.PartialAsync("~/Views/Shared/Partials/_MNSOFTSignature.cshtml")</div><nav aria-label="Links legais"><a href="/profile">Privacidade</a><a href="/profile">Termos</a><a href="/support">Suporte</a></nav></div></footer>
@await Html.PartialAsync("~/Views/Shared/Partials/_ToastHost.cshtml")
@await Html.PartialAsync("~/Views/Shared/Partials/_ConfirmModal.cshtml")
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", false)
</body></html>
