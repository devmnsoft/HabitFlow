@model HabitFlow.Web.Models.NavigationViewModel
@using HabitFlow.Web.Models
@{
    var isSidebar = Model.Variant is NavigationVariant.AccountSidebar or NavigationVariant.PlatformSidebar or NavigationVariant.MobileDrawer;
    var cssClass = Model.Variant switch
    {
        NavigationVariant.MobileBottom => "hf-mobile-bottom",
        NavigationVariant.MobileDrawer => "hf-drawer-nav",
        NavigationVariant.AccountSidebar => "hf-sidebar-nav hf-account-nav",
        NavigationVariant.PlatformSidebar => "hf-sidebar-nav hf-platform-nav",
        _ => "navbar-nav hf-top-nav"
    };
    string Group(NavigationItem item) => Model.Context != NavigationContext.Platform ? string.Empty : item.SortOrder switch
    {
        <= 15 => "Visão",
        <= 45 => "Gestão",
        <= 75 => "Financeiro",
        <= 85 => "Operação",
        _ => "Controle"
    };
}
<nav class="@cssClass" aria-label="@((Model.Context is NavigationContext.Account or NavigationContext.Platform) ? "Navegação contextual" : "Navegação principal")" data-navigation-variant="@Model.Variant">
    @if (isSidebar && Model.Context == NavigationContext.Account)
    {
        @await Html.PartialAsync("~/Views/Shared/Partials/_AccountMenuGroups.cshtml", Model.Items)
    }
    else if (isSidebar && Model.Context == NavigationContext.Platform)
    {
        @foreach (var group in Model.Items.GroupBy(Group))
        {
            <section class="hf-nav-group">
                <h2>@group.Key</h2>
                @foreach (var item in group)
                {
                    @await Html.PartialAsync("~/Views/Shared/Components/Navigation/_Link.cshtml", item, new ViewDataDictionary(ViewData) { ["ShowDescription"] = true })
                }
            </section>
        }
    }
    else
    {
        @foreach (var item in Model.Items)
        {
            @await Html.PartialAsync("~/Views/Shared/Components/Navigation/_Link.cshtml", item, new ViewDataDictionary(ViewData) { ["ShowDescription"] = isSidebar })
        }
        @if (Model.Context == NavigationContext.Public && Model.Variant == NavigationVariant.MobileDrawer)
        {
            @await Html.PartialAsync("~/Views/Shared/Partials/_PublicNavCta.cshtml")
        }
    }
</nav>
