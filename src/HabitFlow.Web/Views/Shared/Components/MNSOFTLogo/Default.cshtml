@model HabitFlow.Web.ViewComponents.MNSOFTLogoViewModel
@if (Model.HasOfficialLogo)
{
    <img class="mnsoft-official-logo" src="@Model.OfficialLogoPath" alt="Logo oficial da MNSOFT" loading="lazy" decoding="async" />
}
else
{
    <span class="mnsoft-fallback-logo" role="img" aria-label="MNSOFT Consultorias e soluções em TI">
        <strong>MNSOFT</strong>
        <small>Consultorias e soluções em TI.</small>
    </span>
}
