@model HabitFlow.Application.FeatureAccessViewModel
<section class="hf-card border-0 bg-success-subtle" aria-labelledby="feature-access-title">
  <p class="hf-section-kicker">Uma opção para sua jornada</p><h2 id="feature-access-title" class="h4">@Model.Title</h2><p>@Model.Explanation</p>
  <p class="small mb-3">Este recurso faz parte do @Model.RecommendedPlan.</p>
  <div class="d-flex flex-wrap gap-2"><a class="btn btn-success" href="/plans">Ver planos</a><a class="btn btn-outline-success" href="/dashboard">Continuar no Gratuito</a></div>
</section>
