@model HabitFlow.Web.Models.AppHeaderViewModel
<header class="app-header-v2" data-app-header data-layout-region="header">
 <div class="app-header-v2__desktop hf-shell">
  <div class="app-header-v2__zone app-header-v2__zone--brand" data-header-zone="brand"><partial name="~/Views/Shared/Partials/AppHeader/_Brand.cshtml" model="Model" /></div>
  <div class="app-header-v2__zone app-header-v2__zone--navigation" data-header-zone="navigation"><partial name="~/Views/Shared/Partials/AppHeader/_PrimaryNavigation.cshtml" model="Model.Navigation" /></div>
  <div class="app-header-v2__zone app-header-v2__zone--search" data-header-zone="search">@if(Model.IsAuthenticated){<partial name="~/Views/Shared/Partials/AppHeader/_HeaderSearch.cshtml"/>}</div>
  <div class="app-header-v2__zone app-header-v2__zone--actions" data-header-zone="actions">
   @if(Model.IsAuthenticated){<partial name="~/Views/Shared/Partials/AppHeader/_QuickCreateMenu.cshtml" model="Model.QuickActions"/><partial name="~/Views/Shared/Partials/AppHeader/_HeaderNotifications.cshtml" model="Model.Notifications"/><partial name="~/Views/Shared/Partials/AppHeader/_PlanStatusPill.cshtml" model="Model"/>}
   else {<div class="app-header-v2__auth"><a class="btn btn-sm btn-outline-success" href="/login">Entrar</a><a class="btn btn-sm btn-success" href="/register">Começar grátis</a></div>}
  </div>
  @if(Model.IsAuthenticated){<div class="app-header-v2__zone app-header-v2__zone--user" data-header-zone="user"><partial name="~/Views/Shared/Partials/AppHeader/_UserMenu.cshtml" model="Model"/></div>}
 </div>
 <partial name="~/Views/Shared/Partials/AppHeader/_MobileHeader.cshtml" model="Model" />
</header>
<partial name="~/Views/Shared/Partials/AppHeader/_MobileDrawer.cshtml" model="Model" />
@if(Model.IsAuthenticated){<partial name="~/Views/Shared/Partials/AppHeader/_MobileBottomNav.cshtml" model="Model.Navigation"/>}
