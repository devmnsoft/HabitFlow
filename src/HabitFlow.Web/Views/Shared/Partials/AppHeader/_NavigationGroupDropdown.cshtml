@model HabitFlow.Web.Models.HeaderNavigationGroup
<div class="dropdown app-nav-v2__more"><button class="app-nav-v2__link app-nav-v2__more-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" data-header-more aria-expanded="false">@Model.Label</button><ul class="dropdown-menu dropdown-menu-end app-nav-v2__menu">@foreach(var item in Model.Items){<li class="app-nav-v2__menu-item--@item.Code"><a class="dropdown-item @(item.IsActive?"active":"")" href="@item.Url"><strong>@item.Label</strong><small>@item.Description</small></a></li>}</ul></div>
