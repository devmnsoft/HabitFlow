@model HabitFlow.Web.Models.AppHeaderViewModel
<div class="dropdown"><button class="app-header-v2__user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Abrir menu de @Model.UserName"><span class="app-header-v2__avatar" aria-hidden="true">@Model.Initial</span><span class="app-header-v2__user-name">@Model.UserName</span></button><div class="dropdown-menu dropdown-menu-end app-header-v2__user-menu"><header><span class="app-header-v2__avatar" aria-hidden="true">@Model.Initial</span><div><strong>@Model.UserName</strong><small>@Model.UserEmail</small><span>@Model.PlanName · Conta protegida</span></div></header>@if(Model.HasPlatformAccess){<a class="app-header-v2__platform" href="/superadmin">Gestão da Plataforma</a>}<section><h2>Conta</h2><a href="/profile">Minha conta</a><a href="/account/security">Segurança</a><a href="/account/privacy">Privacidade</a><a href="/profile/accessibility">Preferências</a></section><section><h2>Assinatura</h2><a href="/account/plan/usage">Meu plano e uso</a>@if(Model.HasBillingAccess){<a href="/billing">Pagamentos</a>}<a href="/plans">Comparar planos</a></section><section><h2>Ajuda</h2><a href="/help">Central de ajuda</a><a href="/support">Suporte</a><a href="/privacy">Política de privacidade</a></section><section><h2>Sistema</h2><button type="button" data-pwa-install hidden>Instalar HabitFlow</button><form method="post" action="/logout">@Html.AntiForgeryToken()<button type="submit" data-loading-text="Saindo...">Sair</button></form></section></div></div>
