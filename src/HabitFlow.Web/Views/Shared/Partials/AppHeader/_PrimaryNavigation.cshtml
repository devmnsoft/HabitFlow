@model HabitFlow.Web.Models.HeaderNavigationViewModel
@{ var promoted = Model.Secondary.SelectMany(group => group.Items).FirstOrDefault(item => item.Code == "progress"); }
<nav class="app-nav-v2" aria-label="Navegação principal" data-header-navigation>@foreach(var item in Model.Primary){<a class="app-nav-v2__link app-nav-v2__link--@item.Code @(item.IsActive?"is-active":"")" href="@item.Url" aria-current="@(item.IsActive?"page":null)">@item.Label</a>}@if(promoted is not null){<a class="app-nav-v2__link app-nav-v2__link--promoted @(promoted.IsActive?"is-active":"")" href="@promoted.Url" aria-current="@(promoted.IsActive?"page":null)">@promoted.Label</a>}@foreach(var group in Model.Secondary){<partial name="~/Views/Shared/Partials/AppHeader/_NavigationGroupDropdown.cshtml" model="group"/>}</nav>
