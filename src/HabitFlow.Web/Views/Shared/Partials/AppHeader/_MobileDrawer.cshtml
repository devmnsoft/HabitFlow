@model HabitFlow.Web.Models.AppHeaderViewModel
<div class="offcanvas offcanvas-start app-header-v2__drawer" tabindex="-1" id="appHeaderDrawer" aria-labelledby="appHeaderDrawerTitle"><div class="offcanvas-header"><h2 id="appHeaderDrawerTitle">Navegação</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar menu"></button></div><div class="offcanvas-body"><nav aria-label="Navegação móvel">@foreach(var item in Model.Navigation.Primary.Concat(Model.Navigation.Secondary.SelectMany(x=>x.Items))){<a class="@(item.IsActive?"is-active":"")" href="@item.Url" aria-current="@(item.IsActive?"page":null)"><strong>@item.Label</strong><small>@item.Description</small></a>}</nav>@if(Model.IsAuthenticated){<hr/><h3>Ações rápidas</h3>@foreach(var action in Model.QuickActions){<a href="@action.Url">@action.Label</a>}}</div></div>
