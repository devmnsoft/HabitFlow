@model HabitFlow.Application.SupportContact
<aside class="support-contact" aria-label="Contato com suporte"><div><span class="assist-kicker">Suporte humano</span><h2>Ainda precisa de ajuda?</h2><p>@Model.CompanyName · @Model.BusinessHours</p></div><div>@if(Model.WhatsAppUrl is not null){<a class="btn btn-success" href="/support/whatsapp" target="_blank" rel="noopener noreferrer" data-support-whatsapp>@Model.ButtonText</a>}else{<a class="btn btn-primary" href="mailto:@Model.Email">Enviar e-mail para @Model.Email</a>}<a class="btn btn-outline-primary" href="/support/tickets/new">Abrir chamado</a></div></aside>
