@model HabitFlow.Web.Models.AppHeaderViewModel
<header class="header-v4 header-v4--public" data-header-root data-layout-region="header"><div class="header-v4__bar hf-shell">
 <button class="header-v4__icon header-v4__menu" type="button" data-bs-toggle="offcanvas" data-bs-target="#headerDrawer" aria-controls="headerDrawer" aria-label="Abrir menu principal"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
 <div data-header-zone="brand"><partial name="~/Views/Shared/Partials/Header/_HeaderBrand.cshtml" model="Model" /></div>
 <nav class="navigation-v4" aria-label="Navegação pública" data-header-zone="navigation">@foreach(var item in Model.Navigation.Primary){<a class="@(item.IsActive?"is-active":"")" href="@item.Url" aria-current="@(item.IsActive?"page":null)">@item.Label</a>}@foreach(var group in Model.Navigation.Secondary){<div class="dropdown"><button class="navigation-v4__more dropdown-toggle" data-bs-toggle="dropdown" type="button">Mais</button><div class="dropdown-menu">@foreach(var item in group.Items){<a class="dropdown-item" href="@item.Url">@item.Label</a>}</div></div>}</nav>
 <div class="header-v4__public-actions" data-header-zone="actions">@if(Model.IsAuthenticated){<a class="btn btn-success btn-sm" href="/dashboard">Abrir app</a><partial name="~/Views/Shared/Partials/Header/_HeaderUserMenu.cshtml" model="Model"/>}else{<a class="btn btn-outline-success btn-sm" href="/login">Entrar</a><a class="btn btn-success btn-sm" href="/register">Começar grátis</a>}</div>
</div></header><partial name="~/Views/Shared/Partials/Header/_HeaderDrawer.cshtml" model="Model" />
