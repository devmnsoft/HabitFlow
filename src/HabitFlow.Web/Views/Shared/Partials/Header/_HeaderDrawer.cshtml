@model HabitFlow.Web.Models.AppHeaderViewModel
<div class="offcanvas offcanvas-start header-v4__drawer" tabindex="-1" id="headerDrawer" aria-labelledby="headerDrawerTitle"><div class="offcanvas-header"><h2 id="headerDrawerTitle">Navegação</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar menu"></button></div><div class="offcanvas-body"><nav aria-label="Navegação móvel">@foreach(var item in Model.Navigation.Primary.Concat(Model.Navigation.Secondary.SelectMany(x=>x.Items))){<a class="@(item.IsActive?"is-active":"")" href="@item.Url" aria-current="@(item.IsActive?"page":null)"><strong>@item.Label</strong><small>@item.Description</small></a>}</nav>@if(Model.IsAuthenticated){<hr/><h3>Ações rápidas</h3>@foreach(var action in Model.QuickActions){<a href="@action.Url">@action.Label</a>}}@if(Model.Context == HabitFlow.Web.Models.NavigationContext.Public){<hr/><div class="d-grid gap-2">@if(Model.IsAuthenticated){<a class="btn btn-success" href="/dashboard">Abrir app</a>}else{<a class="btn btn-outline-success" href="/login">Entrar</a><a class="btn btn-success" href="/register">Começar grátis</a>}</div>}</div></div>
