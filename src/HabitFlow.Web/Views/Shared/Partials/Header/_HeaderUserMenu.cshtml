@model HabitFlow.Web.Models.AppHeaderViewModel
@{ bool Active(string path) => Model.CurrentPath.Equals(path, StringComparison.OrdinalIgnoreCase) || Model.CurrentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase); }
<div class="dropdown"><button class="header-v4__user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Abrir menu de @Model.UserName"><span class="header-v4__avatar" aria-hidden="true">@Model.Initial</span><span class="header-v4__user-name">@Model.UserName</span></button><div class="dropdown-menu dropdown-menu-end header-v4__user-menu"><header><span class="header-v4__avatar" aria-hidden="true">@Model.Initial</span><div><strong>@Model.UserName</strong><small>@Model.UserEmail</small><span>@Model.PlanName · Conta protegida</span></div><button type="button" class="header-v4__dropdown-close" data-header-dropdown-close aria-label="Fechar menu do usuário">×</button></header>@if(Model.HasPlatformAccess){<a class="header-v4__platform" href="/superadmin">Gestão da Plataforma</a>}<section><h2>Conta</h2><a class="@(Active("/profile") ? "is-active" : null)" href="/profile">Minha conta</a><a class="@(Active("/account/security") ? "is-active" : null)" href="/account/security" aria-current="@(Active("/account/security") ? "page" : null)">Segurança</a><a class="@(Active("/account/privacy") ? "is-active" : null)" href="/account/privacy" aria-current="@(Active("/account/privacy") ? "page" : null)">Privacidade</a><a href="/profile/accessibility">Preferências</a></section><section><h2>Assinatura</h2><a class="@(Active("/account/plan") ? "is-active" : null)" href="/account/plan/usage">Meu plano e uso</a>@if(Model.HasBillingAccess){<a href="/billing">Pagamentos</a>}<a href="/plans">Comparar planos</a></section><section><h2>Ajuda</h2><a href="/help">Central de ajuda</a><a href="/support">Suporte</a><a href="/privacy">Política de privacidade</a></section><section><h2>Sistema</h2><button type="button" data-pwa-install hidden>Instalar HabitFlow</button><form method="post" action="/logout">@Html.AntiForgeryToken()<button type="submit" data-loading-text="Saindo...">Sair</button></form></section></div></div>
