@inject IWebHostEnvironment Env
@{
    var messages = new[] {
        (Key:"Success", Type:"success", Title:"Tudo certo", Modal:false),
        (Key:"Info", Type:"info", Title:"Informação", Modal:false),
        (Key:"Warning", Type:"warning", Title:"Atenção", Modal:false),
        (Key:"Error", Type:"error", Title:"Não foi possível concluir", Modal:true),
        (Key:"ValidationError", Type:"warning", Title:"Revise os dados", Modal:false),
        (Key:"DatabaseError", Type:"database", Title:"Não conseguimos concluir agora", Modal:true),
        (Key:"Empty", Type:"info", Title:"Nada por aqui ainda", Modal:false)
    };
}
<div class="hf-feedback-seed" hidden>
@foreach (var item in messages)
{
    if (TempData[item.Key] is not null)
    {
        var message = TempData[item.Key]?.ToString();
        if (item.Modal)
        {
            <span data-hf-modal="@message" data-hf-modal-type="@item.Type" data-hf-modal-title="@item.Title"></span>
        }
        else
        {
            <span data-hf-toast="@message" data-hf-toast-type="@item.Type" data-hf-toast-title="@item.Title"></span>
        }
        if (item.Key == "DatabaseError" && (Env.IsDevelopment() || User?.IsInRole("Admin") == true))
        {
            <span data-hf-toast="Verifique o painel de diagnóstico e o guia PostgreSQL." data-hf-toast-type="info" data-hf-toast-title="Diagnóstico disponível"></span>
        }
    }
}
</div>
