@{ var hasHabits = (bool?)ViewData["HasHabits"] ?? false; var hasDone = (bool?)ViewData["HasDone"] ?? false; var items = new[]{("Criar conta",true,"/profile"),("Escolher um objetivo",hasHabits,"/habit-library"),("Adicionar primeiro hábito",hasHabits,"/habit-library"),("Marcar primeiro hábito",hasDone,"/dashboard"),("Ver progresso",hasDone,"/progress"),("Conhecer biblioteca",hasHabits,"/habit-library")}; }
