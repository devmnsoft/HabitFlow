@model IReadOnlyList<HabitFlow.Web.Models.NavigationItem>
@{ var accessCodes = new[] { "account", "security", "privacy", "preferences" }; }
<section class="hf-nav-group"><h2>Conta e acesso</h2>@foreach(var item in Model.Where(x=>accessCodes.Contains(x.Code))){@await Html.PartialAsync("~/Views/Shared/Components/Navigation/_Link.cshtml",item,new ViewDataDictionary(ViewData){{"ShowDescription",true}})}</section><section class="hf-nav-group"><h2>Plano e atendimento</h2>@foreach(var item in Model.Where(x=>!accessCodes.Contains(x.Code))){@await Html.PartialAsync("~/Views/Shared/Components/Navigation/_Link.cshtml",item,new ViewDataDictionary(ViewData){{"ShowDescription",true}})}</section>
