@{
    var id = (string)(ViewData["Id"] ?? "Password");
    var name = (string)(ViewData["Name"] ?? id);
    var label = (string)(ViewData["Label"] ?? "Senha");
    var autocomplete = (string)(ViewData["Autocomplete"] ?? "current-password");
    var placeholder = (string)(ViewData["Placeholder"] ?? "Digite sua senha");
    var helpText = (string?)(ViewData["HelpText"] ?? null);
}
<div class="hf-password-field mb-3">
  <label class="form-label" for="@id">@label</label>
  <div class="hf-password-control">
    <input class="form-control" id="@id" name="@name" type="password" required autocomplete="@autocomplete" placeholder="@placeholder" />
    <button type="button" class="hf-password-toggle" data-password-toggle="#@id" aria-label="Mostrar senha" aria-pressed="false">
      <svg class="hf-eye-open" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
      <svg class="hf-eye-closed" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.8M7.5 7.8C4.3 9.4 2.5 12 2.5 12s3.5 6 9.5 6c1.5 0 2.8-.4 4-.9M10 6.2c.6-.1 1.3-.2 2-.2 6 0 9.5 6 9.5 6s-.7 1.2-2 2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  @if (!string.IsNullOrWhiteSpace(helpText)) { <div class="hf-field-help">@helpText</div> }
</div>
