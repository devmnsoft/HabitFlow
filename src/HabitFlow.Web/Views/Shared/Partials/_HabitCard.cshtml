@model HabitFlow.Application.HabitDto
<article class="hf-habit-card" style="--habit-color:@Model.Color"><div><span class="hf-dot"></span><span class="hf-badge">@(Model.Category ?? "Rotina")</span><h2 class="h5 mt-2">@Model.Name</h2><p>@(Model.DoneToday ? "Concluído hoje" : "Pendente hoje") · sequência em construção</p></div><div class="d-flex gap-2 flex-wrap"><form method="post" action="/Habits/@(Model.DoneToday ? "Uncomplete" : "Complete")/@Model.Id">@Html.AntiForgeryToken()<button class="btn btn-success" data-loading-text="Salvando...">@(Model.DoneToday ? "Desmarcar" : "Marcar")</button></form><a class="btn btn-outline-success" href="/habits/@Model.Id">Detalhe</a></div></article>
