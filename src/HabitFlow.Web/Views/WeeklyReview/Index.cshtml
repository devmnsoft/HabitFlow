@model WeeklyReviewResult
@{ ViewData["Title"] = "Revisão semanal"; }
@section Styles { <link rel="stylesheet" href="~/css/weekly-review.css" asp-append-version="true" /> }
<main class="weekly-review container">
    <header class="review-hero"><div><span class="eyebrow">Olhar com gentileza, ajustar com intenção</span><h1>Como foi sua semana?</h1><p>@Model.PeriodStart.ToString("dd MMM") — @Model.PeriodEnd.ToString("dd MMM") · uma leitura prática, sem julgamentos.</p></div><a href="/reports" class="btn btn-light">Ver relatório completo</a></header>
    <section class="review-metrics" aria-label="Resumo da semana">
        <article><strong>@Model.Completed/@Model.Scheduled</strong><span>passos concluídos</span></article><article><strong>@Model.Percentage%</strong><span>consistência</span></article>
        <article><strong>@(Model.BestDay ?? "Em construção")</strong><span>melhor dia</span></article><article><strong>@(Model.WorstDay ?? "Sem agenda")</strong><span>dia com mais espaço</span></article>
        <article><strong>@Model.DaysWithoutActivity</strong><span>dias sem atividade</span></article><article><strong>@(Model.MostActiveGoal ?? "Escolha um foco")</strong><span>objetivo em destaque</span></article>
    </section>
    <section class="review-answer-grid" aria-label="Leitura rápida"><article><span>O que você manteve</span><strong>@(Model.BestHabit ?? "A semana ainda pode começar")</strong></article><article><span>Onde simplificar</span><strong>@(Model.MostForgottenHabit ?? "Nenhum ajuste necessário")</strong></article></section>

    @if (Model.Recommendations.Count > 0) { <section class="review-section"><div class="section-heading"><div><span class="eyebrow">Próxima semana</span><h2>Ações que podem ajudar</h2></div><p>Regras simples explicam cada sugestão. Nada muda sem sua escolha.</p></div><div class="recommendation-grid">@foreach (var item in Model.Recommendations) { <article class="recommendation recommendation--@item.Severity"><span class="recommendation-code">Sugestão prática</span><h3>@item.Title</h3><p>@item.Message</p>@if (item.ActionUrl is not null) { <a href="@item.ActionUrl" class="btn btn-success">@item.ActionLabel</a> }</article> }</div></section> }

    <section class="review-section"><div class="section-heading"><div><span class="eyebrow">Por área da vida</span><h2>Equilíbrio da rotina</h2></div></div><div class="category-grid">@foreach (var category in Model.Categories) { <article class="category-card @(category.Scheduled == 0 ? "is-empty" : "")"><div><h3>@category.Name</h3><span>@category.Trend</span></div><strong>@category.Percentage%</strong><div class="progress" role="progressbar" aria-label="Consistência em @category.Name" aria-valuenow="@category.Percentage" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@category.Percentage%"></div></div><small>@category.Completed conclusões · @category.Scheduled oportunidades</small></article> }</div></section>

    <section class="review-section"><div class="section-heading"><div><span class="eyebrow">Hábitos</span><h2>Ritmo de cada prática</h2></div></div><div class="review-grid">@foreach (var habit in Model.Habits) { <article class="review-habit"><div><div><h3>@habit.Name</h3><span>@habit.Category · melhor sequência: @habit.CurrentStreak</span></div><strong>@habit.Percentage%</strong></div><div class="progress"><div class="progress-bar" style="width:@habit.Percentage%"></div></div><p>@habit.Insight</p><div class="card-actions"><a href="/habits/@habit.HabitId" class="btn btn-sm btn-outline-success">Abrir hábito</a>@if (!habit.HasReminder) { <a href="/habits/@habit.HabitId/reminders" class="btn btn-sm btn-link">Criar lembrete</a> }</div></article> }</div></section>

    @if (Model.Goals.Count > 0) { <section class="review-section"><div class="section-heading"><div><span class="eyebrow">Objetivos</span><h2>Intenção conectada à rotina</h2></div></div><div class="goal-list">@foreach (var goal in Model.Goals.Take(4)) { <article><div><h3>@goal.Title</h3><span>@(goal.HasLinkedHabit ? "Com hábito vinculado" : "Ainda sem hábito vinculado")</span></div><strong>@goal.Percentage%</strong><a href="/goals/@goal.GoalId" class="btn btn-sm btn-outline-success">Abrir objetivo</a></article> }</div></section> }

    @if (!Model.IsCompleted) { <form method="post" action="@($"/weekly-review/{Model.PeriodStart:yyyy-MM-dd}/complete")" class="review-complete">@Html.AntiForgeryToken()<input type="hidden" name="idempotencyKey" value="@Model.IdempotencyKey"/><button class="btn btn-success btn-lg" data-submit-once>Concluir minha revisão</button><p>Isso registra seu aprendizado. Nenhum hábito será alterado automaticamente.</p></form> } else { <div class="alert alert-success" role="status">Revisão concluída. Seu aprendizado ficou registrado.</div> }
</main>
@section Scripts { <script src="~/js/weekly-review.js" asp-append-version="true"></script> }
