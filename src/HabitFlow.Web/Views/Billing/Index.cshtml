@model IReadOnlyList<HabitFlow.Domain.PaymentTransaction>
@{
    ViewData["Title"] = "Minha assinatura";
    var subscription = ViewBag.Subscription as HabitFlow.Domain.Subscription;
    var checkoutEnabled = ViewBag.CheckoutEnabled as bool? ?? false;
    string PlanName(string? code) => code?.ToLowerInvariant() switch { "free" => "Free", "ritmo" or "premium" => "Premium", "team" => "Team", "enterprise" => "Enterprise", _ => code ?? "Free" };
    string StatusName(HabitFlow.Domain.SubscriptionStatus status) => status switch
    {
        HabitFlow.Domain.SubscriptionStatus.Active => "Ativa",
        HabitFlow.Domain.SubscriptionStatus.Pending or HabitFlow.Domain.SubscriptionStatus.PaymentPending or HabitFlow.Domain.SubscriptionStatus.PastDue => "Pagamento pendente",
        HabitFlow.Domain.SubscriptionStatus.Canceled => "Cancelada",
        HabitFlow.Domain.SubscriptionStatus.Trial or HabitFlow.Domain.SubscriptionStatus.Trialing => "Avaliação",
        _ => "Em análise"
    };
}

<div class="py-4">
    <h1>Minha assinatura</h1>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning">@error</div>
    }
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Assinatura atual</h2>
            @if (!checkoutEnabled)
            {
                <div class="alert alert-info" role="status">Checkout online indisponível neste ambiente. Nenhuma cobrança é simulada. Para contratar ou regularizar, fale com <a href="mailto:comercial@mnsoft.com.br">comercial@mnsoft.com.br</a> ou <a href="/support">abra um chamado</a>.</div>
            }
            @if (subscription is null)
            {
                <p>Você está no plano Free. Os limites desse plano continuam valendo.</p>
                <a href="/plans" class="btn btn-primary">Ver planos</a>
            }
            else
            {
                var pending = subscription.Status is HabitFlow.Domain.SubscriptionStatus.Pending or HabitFlow.Domain.SubscriptionStatus.PaymentPending or HabitFlow.Domain.SubscriptionStatus.PastDue;
                if (pending)
                {
                    <div class="alert alert-warning" role="status">Pagamento pendente. Os recursos pagos ainda não foram liberados.</div>
                }
                <dl class="row">
                    <dt class="col-sm-3">Plano</dt>
                    <dd class="col-sm-9">@PlanName(subscription.PlanCode)</dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@StatusName(subscription.Status)</dd>
                    <dt class="col-sm-3">Ciclo</dt>
                    <dd class="col-sm-9">@subscription.BillingCycle</dd>
                    <dt class="col-sm-3">Próxima cobrança / fim do período</dt>
                    <dd class="col-sm-9">@subscription.CurrentPeriodEnd?.ToString("dd/MM/yyyy")</dd>
                    @if (subscription.CanceledAt is not null)
                    {
                        <dt class="col-sm-3">Cancelamento</dt>
                        <dd class="col-sm-9">Programado para o fim do período pago</dd>
                    }
                </dl>

                @if (subscription.Status == HabitFlow.Domain.SubscriptionStatus.Active && subscription.CanceledAt is null)
                {
                    <form action="/account/billing/cancel" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reason" value="Cancelamento solicitado pelo titular" />
                        <button class="btn btn-outline-danger" type="submit" data-confirm="Cancelar a assinatura ao fim do período já pago?" data-confirm-label="Cancelar assinatura" data-loading-text="Cancelando…">Cancelar assinatura</button>
                    </form>
                }
            }
        </div>
    </div>

    <h2 class="h5">Histórico financeiro</h2>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Status</th>
                    <th>Valor</th>
                    <th>Provider</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model)
                {
                    <tr>
                        <td>@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@tx.Status</td>
                        <td>@tx.Amount?.ToString("C")</td>
                        <td>@tx.Provider</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
