@model IReadOnlyList<HabitFlow.Domain.PaymentTransaction>
@{
    ViewData["Title"] = "Minha assinatura";
    var subscription = ViewBag.Subscription as HabitFlow.Domain.Subscription;
}
<div class="container py-4"><h1>Minha assinatura</h1>
@if (TempData["Error"] is string error){<div class="alert alert-warning">@error</div>}
<div class="card mb-4"><div class="card-body"><h2 class="h5">Assinatura atual</h2>
@if (subscription is null){<p>Você está no plano Gratuito.</p><a href="/plans" class="btn btn-primary">Ver planos</a>} else {<dl class="row"><dt class="col-sm-3">Plano</dt><dd class="col-sm-9">@subscription.PlanCode</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@subscription.Status</dd><dt class="col-sm-3">Ciclo</dt><dd class="col-sm-9">@subscription.BillingCycle</dd><dt class="col-sm-3">Período</dt><dd class="col-sm-9">@subscription.CurrentPeriodStart?.ToString("dd/MM/yyyy") - @subscription.CurrentPeriodEnd?.ToString("dd/MM/yyyy")</dd></dl><a href="/support" class="btn btn-outline-secondary">Solicitar cancelamento via suporte</a>}</div></div>
<h2 class="h5">Histórico financeiro</h2><div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Status</th><th>Valor</th><th>Provider</th></tr></thead><tbody>@foreach (var tx in Model){<tr><td>@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@tx.Status</td><td>@tx.Amount?.ToString("C")</td><td>@tx.Provider</td></tr>}</tbody></table></div></div>
