@model HabitFlow.Domain.User?
@{ ViewData["Title"] = "Perfil e privacidade"; }
<header class="hf-page-header"><div><p class="hf-eyebrow">Conta e LGPD</p><h1>Perfil, plano e privacidade</h1><p>Gerencie dados da conta, solicitações LGPD e segurança com linguagem clara.</p></div></header>
<section class="row g-3"><div class="col-lg-6"><div class="hf-card h-100"><h2>Dados da conta</h2><dl><dt>Nome</dt><dd>@(Model?.Name ?? "Não informado")</dd><dt>E-mail</dt><dd>@(Model?.Email ?? "Não informado")</dd><dt>Status</dt><dd><span class="hf-status-badge">@(Model?.AccountStatus.ToString() ?? "Ativo")</span></dd><dt>Plano atual</dt><dd><span class="hf-plan-badge">@(Model?.Plan.ToString() ?? "Free")</span></dd></dl><a class="btn btn-outline-success" href="/habits">Editar rotina</a> <a class="btn btn-success" href="/profile/accessibility">Preferências de visualização</a></div></div><div class="col-lg-6"><div class="hf-card h-100"><h2>Privacidade e LGPD</h2><p>Você pode solicitar exportação ou exclusão dos seus dados. A operação é auditada e tratada pelo suporte MNSOFT.</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-success" href="/support">Solicitar exportação</a><a class="btn btn-outline-danger" href="/support" data-confirm="Abrir solicitação de exclusão de dados?">Solicitar exclusão</a><form method="post" action="/logout">@Html.AntiForgeryToken()<button class="btn btn-secondary">Logout</button></form></div></div></div></section>
