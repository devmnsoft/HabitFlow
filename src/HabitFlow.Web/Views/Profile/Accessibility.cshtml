@model HabitFlow.Web.Models.UserUiPreferenceViewModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Preferências de visualização"; }
<header class="hf-page-header surface-blue"><div><p class="hf-eyebrow">Acessibilidade</p><h1>Preferências de visualização</h1><p>Ajuste contraste, tamanho da fonte e animações para deixar o HabitFlow mais confortável para você.</p></div><a class="btn btn-outline-success" href="/profile">Voltar ao perfil</a></header>
<section class="row g-3"><div class="col-lg-7"><form class="hf-card surface-light" method="post" action="/profile/accessibility" data-ui-preferences-form>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label" asp-for="ContrastMode">Contraste</label><select class="form-select" asp-for="ContrastMode" asp-items="Model.ContrastOptions" data-ui-contrast></select></div><div class="mb-3"><label class="form-label" asp-for="FontScale">Tamanho da fonte</label><select class="form-select" asp-for="FontScale" asp-items="Model.FontOptions" data-ui-font></select></div><div class="form-check form-switch mb-4"><input class="form-check-input" asp-for="ReduceMotion" data-ui-motion><label class="form-check-label" asp-for="ReduceMotion">Reduzir animações</label></div><button class="btn btn-success" data-loading-text="Salvando...">Salvar preferências</button></form></div><aside class="col-lg-5"><div class="hf-card surface-green"><h2>Pré-visualização imediata</h2><p class="text-readable-muted">As alterações são aplicadas na tela antes de salvar. Após login, a preferência salva no banco prevalece sobre o localStorage.</p><p><span class="hf-status-badge">✓ Contraste seguro</span> <span class="hf-badge">Aa Fonte legível</span></p></div></aside></section>
