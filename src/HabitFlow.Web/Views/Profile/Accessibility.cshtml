@model HabitFlow.Web.Models.UserUiPreferenceViewModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Preferências de visualização"; }
<header class="hf-page-header surface-blue"><div><p class="hf-eyebrow">Acessibilidade</p><h1>Preferências de visualização</h1><p>Ajuste contraste, tamanho da fonte, animações, toasts e pop-ups para deixar o HabitFlow mais confortável.</p></div><a class="btn btn-outline-success" href="/profile">Voltar ao perfil</a></header>
<section class="row g-3"><div class="col-lg-7"><form class="hf-card surface-light" method="post" action="/profile/accessibility" data-ui-preferences-form>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label" asp-for="ContrastMode">Contraste</label><select class="form-select" asp-for="ContrastMode" asp-items="Model.ContrastOptions" data-ui-contrast></select></div><div class="mb-3"><label class="form-label" asp-for="FontScale">Tamanho da fonte</label><select class="form-select" asp-for="FontScale" asp-items="Model.FontOptions" data-ui-font></select></div><div class="form-check form-switch mb-3"><input class="form-check-input" asp-for="ReduceMotion" data-ui-motion><label class="form-check-label" asp-for="ReduceMotion">Reduzir animações</label></div><hr><h2 class="h5">Mensagens e pop-ups</h2><p class="text-readable-muted">Controle feedbacks rápidos, conquistas e dicas sem bloquear sua rotina.</p><div class="form-check form-switch mb-2"><input class="form-check-input" asp-for="ShowAchievementPopups" data-ui-achievements><label class="form-check-label" asp-for="ShowAchievementPopups">Mostrar conquistas</label></div><div class="form-check form-switch mb-2"><input class="form-check-input" asp-for="ShowTipPopups" data-ui-tips><label class="form-check-label" asp-for="ShowTipPopups">Mostrar dicas de uso</label></div><div class="form-check form-switch mb-2"><input class="form-check-input" asp-for="EnableToasts" data-ui-toasts><label class="form-check-label" asp-for="EnableToasts">Mostrar notificações rápidas</label></div><div class="form-check form-switch mb-4"><input class="form-check-input" asp-for="ReducePopups" data-ui-reduce-popups><label class="form-check-label" asp-for="ReducePopups">Reduzir pop-ups não essenciais</label></div><button class="btn btn-success" data-loading-text="Salvando...">Salvar preferências</button></form></div><aside class="col-lg-5"><div class="hf-card surface-green"><h2>Pré-visualização imediata</h2><p class="text-readable-muted">As alterações são aplicadas antes de salvar. Preferências salvas no banco prevalecem após login.</p><p><span class="hf-status-badge">✓ Contraste seguro</span> <span class="hf-badge">Aa Fonte legível</span></p></div></aside></section>
