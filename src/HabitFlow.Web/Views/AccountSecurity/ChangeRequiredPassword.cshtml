@model HabitFlow.Web.Models.RequiredPasswordChangeViewModel
@{ ViewData["Title"] = "Proteja sua conta"; }
@section Styles { <link rel="stylesheet" href="~/css/account-security.css" asp-append-version="true" /> }
<main class="security-page">
  <section class="security-card" aria-labelledby="security-title">
    <span class="security-card__eyebrow">Etapa obrigatória de segurança</span>
    <h1 id="security-title">Crie uma nova senha</h1>
    <p>Antes de continuar, substitua a senha temporária. As demais sessões serão encerradas.</p>
    <form method="post" novalidate>
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert" aria-live="polite"></div>
      <div class="form-field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
      <div class="form-field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" aria-describedby="password-help" /><small id="password-help">Use de 8 a 128 caracteres e não reutilize a senha atual.</small><span asp-validation-for="NewPassword"></span></div>
      <div class="form-field"><label asp-for="Confirmation"></label><input asp-for="Confirmation" autocomplete="new-password" /><span asp-validation-for="Confirmation"></span></div>
      <button class="btn btn-primary" type="submit">Atualizar senha com segurança</button>
    </form>
  </section>
</main>
