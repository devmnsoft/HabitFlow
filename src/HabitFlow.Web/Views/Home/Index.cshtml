@{ ViewData["Title"] = "Início"; var features = new[]{("Organizar hábitos","Crie uma rotina clara para o dia.","organization"),("Acompanhar progresso","Veja barras, relatórios e histórico.","progress"),("Manter sequência","Celebre dias consistentes.","streak"),("Usar biblioteca pronta","Comece com sugestões por objetivo.","library"),("Ver relatórios","Entenda sua evolução ao longo do tempo.","report"),("Ganhar clareza do dia","Saiba exatamente o próximo passo.","check")}; }
<section class="hf-hero hf-hero-grid mb-5" id="inicio"><div><span class="hf-section-kicker">Um espaço simples para cuidar da sua rotina.</span><h1>Pequenos passos. Uma rotina que faz sentido para você.</h1><p class="lead">Organize seus hábitos, acompanhe seu progresso e encontre um ritmo que caiba na sua vida.</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-success btn-lg" href="/register">Criar meu espaço</a><a class="btn btn-outline-success btn-lg" href="/demo">Ver um dia no HabitFlow</a></div><p class="small text-muted mt-3">Comece no seu tempo. O plano Gratuito não exige cartão.</p></div><aside class="hf-mockup-card" aria-label="Ilustração de uma rotina organizada no HabitFlow">@await Html.PartialAsync("~/Views/Shared/Partials/Illustrations/_HeroHabitDashboardIllustration.cshtml")</aside></section>
<section class="hf-section" id="como-usar"><p class="hf-section-kicker">Como funciona</p><h2>Comece em quatro passos simples.</h2><div class="row g-3">@foreach(var s in new[]{("1","Escolha um objetivo"),("2","Adicione hábitos prontos"),("3","Marque o que concluiu"),("4","Veja sua evolução")}){<div class="col-md-3"><article class="hf-step-card h-100"><span>@s.Item1</span><h3 class="h5">@s.Item2</h3></article></div>}</div></section>
<section class="hf-section"><p class="hf-section-kicker">O que você consegue fazer</p><h2>Rotina, hábitos e progresso em um só lugar.</h2><div class="row g-3">@foreach(var f in features){<div class="col-md-6 col-xl-4"><article class="hf-feature-card h-100">@await Html.PartialAsync("~/Views/Shared/Partials/Icons/_Icon.cshtml", null, new ViewDataDictionary(ViewData){{"Name",f.Item3},{"Class","hf-icon-lg"}})<h3 class="h5">@f.Item1</h3><p>@f.Item2</p></article></div>}</div></section>
<section class="hf-section hf-guided-card"><p class="hf-section-kicker">Para quem serve</p><h2>Para quem quer organização, estudos melhores, saúde, rotina e evolução visível.</h2><p class="mb-0">Use o HabitFlow para transformar metas grandes em pequenas ações acompanháveis no dia a dia.</p></section>
<section class="hf-section hf-premium-card text-center"><h2>Comece com um hábito hoje.</h2><p>Escolha uma sugestão pronta ou cadastre sua primeira rotina em poucos minutos.</p><a class="btn btn-success btn-lg" href="/habit-library">Explorar biblioteca</a></section>
