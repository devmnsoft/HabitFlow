@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Hábitos melhores"; }
<section class="hf-hero mb-4"><div><p class="hf-eyebrow">SaaS de consistência pessoal</p><h1>Construa hábitos melhores, um dia de cada vez.</h1><p class="lead text-muted">O HabitFlow ajuda você a acompanhar sua rotina, manter sua sequência e visualizar seu progresso sem complicação.</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-success btn-lg" href="/register">Começar agora</a><a class="btn btn-outline-success btn-lg" href="/login">Entrar</a></div><p class="small text-muted mt-3">Seus hábitos são privados e ficam vinculados à sua conta.</p></div><div class="hf-dashboard-mock" aria-label="Prévia visual do dashboard"><div class="d-flex justify-content-between"><strong>Hoje no HabitFlow</strong><span class="hf-badge">Streak 12 dias</span></div><div class="my-4"><div class="d-flex justify-content-between small"><span>Progresso diário</span><span>80%</span></div><div class="progress"><div class="progress-bar" style="width:80%"></div></div></div><div class="d-grid gap-2"><div class="hf-card text-dark">✓ Beber água</div><div class="hf-card text-dark">✓ Ler 10 minutos</div><div class="hf-card text-dark">○ Caminhar</div></div></div></section>
<section class="hf-grid mb-4">@foreach(var b in new[]{("Simples de usar","Marque hábitos em segundos."),("Foco em consistência","Sequências claras e motivadoras."),("Progresso visual","Barras, rankings e histórico."),("Feito para celular","Mobile first em 360px+."),("Privacidade e segurança","LGPD e conta protegida."),("Gratuito para começar","Até 5 hábitos ativos.")}){<article class="hf-card hf-col-4"><span class="hf-card-icon" aria-hidden="true">✓</span><h2 class="h5">@b.Item1</h2><p class="text-muted mb-0">@b.Item2</p></article>}</section>
<section class="hf-card mb-4"><p class="hf-eyebrow">Como funciona</p><div class="row g-3">@foreach(var s in new[]{"Crie seus hábitos","Marque o que concluiu","Acompanhe sua sequência","Evolua com relatórios"}.Select((v,i)=>(v,i+1))){<div class="col-md-3"><div class="hf-empty-icon">@s.Item2</div><h3 class="h5">@s.v</h3></div>}</div></section>
<section class="row g-3 mb-4"><div class="col-md-6"><div class="hf-card h-100"><span class="hf-plan-badge">Gratuito</span><h2 class="mt-2">Comece pequeno</h2><ul><li>Até 5 hábitos ativos</li><li>Histórico e streak</li><li>Relatórios básicos</li></ul></div></div><div class="col-md-6"><div class="hf-card h-100"><span class="hf-plan-badge">Premium</span><h2 class="mt-2">Para evoluir mais</h2><ul><li>Hábitos ilimitados</li><li>Relatórios avançados</li><li>Desafios e planos mensal/anual quando habilitados</li></ul></div></div></section>
