@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Sistema simples para hábitos"; var quickHabits = new[]{"Beber água","Caminhar","Ler 10 minutos","Estudar 30 minutos","Dormir mais cedo"}; }
<section class="hf-hero hf-hero-grid mb-5" id="inicio">
  <div><span class="hf-section-kicker">Desenvolvido por MNSOFT</span><h1>Organize seus hábitos e acompanhe sua evolução todos os dias.</h1><p class="lead">O HabitFlow é um sistema simples para criar hábitos, marcar suas conclusões e visualizar seu progresso sem complicação.</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-success btn-lg" href="/register">Começar grátis</a><a class="btn btn-outline-success btn-lg" href="#como-funciona">Ver como funciona</a></div><p class="small text-muted mt-3">Comece com até 5 hábitos no plano gratuito.</p></div>
  <aside class="hf-mockup-card" aria-label="Prévia visual do HabitFlow"><div class="d-flex justify-content-between"><strong>Progresso de hoje</strong><span>75%</span></div><div class="progress my-3"><div class="progress-bar" style="width:75%"></div></div><p>3 de 4 hábitos concluídos</p><div class="hf-premium-card mb-3"><span>Sequência</span><strong>7 dias</strong></div><div class="hf-premium-card mb-3"><span>Próximo hábito</span><strong>Ler 10 minutos</strong></div><div class="hf-week"><span>S</span><span>T</span><span>Q</span><span>Q</span><span>S</span><span>S</span><span>D</span></div></aside>
</section>
<section class="hf-section"><p class="hf-section-kicker">O que o HabitFlow faz?</p><div class="row g-3"><div class="col-md-4"><article class="hf-feature-card"><h2>Cria sua rotina</h2><p>Cadastre hábitos como beber água, estudar, caminhar ou dormir melhor.</p></article></div><div class="col-md-4"><article class="hf-feature-card"><h2>Mostra o que fazer hoje</h2><p>Veja em uma tela simples quais hábitos estão planejados para o dia.</p></article></div><div class="col-md-4"><article class="hf-feature-card"><h2>Acompanha sua evolução</h2><p>Marque o que concluiu e acompanhe sequência, histórico e relatórios.</p></article></div></div></section>
<section class="hf-section" id="como-funciona"><p class="hf-section-kicker">Como funciona?</p><div class="row g-3">@foreach(var step in new[]{"Escolha um objetivo","Crie ou selecione hábitos prontos","Acompanhe seu progresso diariamente"}.Select((text,index)=>(text,index:index+1))){<div class="col-md-4"><article class="hf-step-card"><span>@step.index</span><h2>@step.text</h2></article></div>}</div></section>
<section class="hf-section"><p class="hf-section-kicker">Para quem serve?</p><div class="hf-chip-grid">@foreach(var item in new[]{"Pessoas que querem criar uma rotina melhor","Estudantes","Profissionais","Pessoas em busca de saúde e bem-estar","Quem quer se organizar melhor","Quem quer acompanhar pequenas metas"}){<span class="hf-chip">@item</span>}</div></section>
<section class="hf-section hf-guided-card"><p class="hf-section-kicker">Comece com um hábito simples</p><h2>Escolha seu primeiro passo.</h2><div class="d-flex flex-wrap gap-2">@foreach(var habit in quickHabits){<a class="btn btn-outline-success" href="@(User.Identity?.IsAuthenticated == true ? "/habit-library" : $"/register?intent={Uri.EscapeDataString(habit)}")">@habit</a>}</div></section>
<section class="hf-section hf-premium-card"><h2>HabitFlow é um sistema simples para criar, acompanhar e manter hábitos no dia a dia.</h2><p>Você cadastra seus hábitos, marca o que concluiu e acompanha sua evolução com sequências, metas e relatórios fáceis de entender.</p><p>Produto desenvolvido pela MNSOFT — Consultorias e soluções em TI.</p>@await Html.PartialAsync("~/Views/Shared/Partials/_MNSOFTSignature.cshtml")</section>
