@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Hábitos melhores com acompanhamento simples"; var quickHabits = new[]{("Beber água","water"),("Caminhar","walk"),("Ler 10 minutos","book"),("Estudar","study"),("Dormir mais cedo","sleep")}; }
<section class="hf-hero hf-hero-grid mb-5" id="inicio"><div><span class="hf-section-kicker">Desenvolvido por MNSOFT</span><h1>Crie hábitos melhores com uma rotina simples de acompanhar.</h1><p class="lead">O HabitFlow mostra o que você precisa fazer hoje, registra o que foi concluído e acompanha sua evolução com sequências, metas e relatórios.</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-success btn-lg" href="/register">Começar grátis</a><a class="btn btn-outline-success btn-lg" href="/demo">Ver demonstração</a></div><p class="small text-muted mt-3">Comece com até 5 hábitos no plano gratuito.</p></div><aside class="hf-mockup-card" id="demonstracao" aria-label="Demonstração visual do HabitFlow">@await Html.PartialAsync("~/Views/Shared/Partials/Illustrations/_DashboardIllustration.cshtml")<div class="hf-demo-grid"><span>Hoje: <strong>4 hábitos</strong></span><span>Concluídos: <strong>3</strong></span><span>Sequência: <strong>7 dias</strong></span><span>Próximo passo: <strong>Beber água</strong></span></div></aside></section>
<section class="hf-section"><p class="hf-section-kicker">O que é o HabitFlow?</p><h2>É um sistema para criar hábitos, acompanhar o dia e visualizar sua evolução sem complicação.</h2><p>Você entende o próximo passo, marca conclusões e acompanha sequências sem planilhas ou telas confusas.</p></section><section class="hf-section" id="como-usar"><p class="hf-section-kicker">Como usar em 3 passos</p><div class="row g-3">@foreach(var step in new[]{"Escolha um objetivo","Adicione hábitos prontos","Marque suas conclusões"}.Select((text,index)=>(text,index:index+1))){<div class="col-md-4"><article class="hf-step-card"><span>@step.index</span><h2>@step.text</h2><p>Um caminho curto para sair da intenção e começar hoje.</p></article></div>}</div></section>
<section class="hf-section"><p class="hf-section-kicker">O que você consegue fazer</p><div class="row g-3">@foreach(var item in new[]{("Criar hábitos","habit"),("Ver hábitos do dia","calendar"),("Marcar conclusão","check"),("Acompanhar sequência","progress"),("Ver relatórios","report"),("Receber orientação","guide")}){<div class="col-md-4"><article class="hf-feature-card">@await Html.PartialAsync("~/Views/Shared/Partials/Icons/_Icon.cshtml", null, new ViewDataDictionary(ViewData){{"Name",item.Item2},{"Class","hf-icon-lg"}})<h2>@item.Item1</h2><p>Recursos simples, claros e pensados para manter sua rotina visível.</p></article></div>}</div></section>
<section class="hf-section"><p class="hf-section-kicker">Para quem é</p><div class="hf-chip-grid">@foreach(var item in new[]{"Quem quer se organizar","Quem quer estudar melhor","Quem quer cuidar da saúde","Quem quer ser mais produtivo","Quem quer criar rotina"}){<span class="hf-chip">@item</span>}</div></section>
<section class="hf-section hf-guided-card"><p class="hf-section-kicker">Comece sem pensar muito</p><h2>Escolha um hábito pronto.</h2><div class="d-flex flex-wrap gap-2">@foreach(var habit in quickHabits){<a class="btn btn-outline-success" href="@(User.Identity?.IsAuthenticated == true ? "/habit-library" : $"/register?intent={Uri.EscapeDataString(habit.Item1)}")">@await Html.PartialAsync("~/Views/Shared/Partials/Icons/_Icon.cshtml", null, new ViewDataDictionary(ViewData){{"Name",habit.Item2}}) @habit.Item1</a>}</div></section>
<section class="hf-section hf-premium-card"><h2>Por que voltar todos os dias?</h2><p>Para manter sequência, ver progresso, completar metas, criar rotina e sentir avanço real com pequenas ações.</p></section>
<section class="hf-section hf-premium-card"><h2>Confiança MNSOFT</h2><p>Produto desenvolvido pela MNSOFT com foco em simplicidade, segurança, LGPD e operação profissional. E-mail comercial: comercial@mnsoft.com.br</p>@await Html.PartialAsync("~/Views/Shared/Partials/_MNSOFTSignature.cshtml")</section>
<section class="hf-section text-center"><h2>Comece com um hábito hoje.</h2><a class="btn btn-success btn-lg" href="/register">Começar grátis</a></section>
