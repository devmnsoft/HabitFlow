@model HabitFlow.Application.ProgressDayDetailViewModel
@{ ViewData["Title"] = "Detalhe do dia"; }
<header class="hf-page-header"><div><p class="hf-eyebrow">Detalhe diário</p><h1>@Model.Date.ToString("dd/MM/yyyy")</h1><p>@Model.CompletedCount de @Model.ScheduledCount concluídos · @Model.CompletionPercentage%</p></div><a class="btn btn-outline-secondary" href="/progress/calendar?year=@Model.Date.Year&month=@Model.Date.Month">Voltar ao calendário</a></header>
@if(Model.Habits.Count==0){<div class="alert alert-light">Não há hábitos previstos para este dia.</div>}else{<div class="list-group">@foreach(var habit in Model.Habits){<article class="list-group-item d-flex justify-content-between align-items-center"><div><strong>@habit.Name</strong><div class="text-muted">@(habit.Category ?? "Sem categoria") @if(habit.SuggestedTime.HasValue){<span>· @habit.SuggestedTime.Value.ToString("HH:mm")</span>}</div></div><span class="badge @(habit.Completed?"text-bg-success":"text-bg-secondary")">@(habit.Completed?"Concluído":"Pendente")</span></article>}</div>}
