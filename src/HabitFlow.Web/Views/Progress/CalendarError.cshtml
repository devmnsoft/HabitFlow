@{ ViewData["Title"] = "Progresso indisponível"; }
<div class="hf-card text-center">
@if (ViewData["AvailableFrom"] is DateOnly availableFrom) {
    <h1>Este período não está disponível no seu plano atual.</h1>
    <p>Seus dados continuam guardados. Você pode consultar períodos a partir de @availableFrom.ToString("dd/MM/yyyy").</p>
    <div class="d-flex justify-content-center gap-2"><a class="btn btn-primary" href="/progress/calendar">Voltar ao período disponível</a><a class="btn btn-outline-secondary" href="/plans">Comparar planos</a></div>
} else {
    <h1>Não foi possível carregar seu progresso agora.</h1><p>Tente novamente em alguns instantes.</p><div class="d-flex justify-content-center gap-2"><a class="btn btn-primary" href="/progress/calendar">Tentar novamente</a><a class="btn btn-outline-secondary" href="/help/progress">Ir para ajuda</a></div>
}
</div>
