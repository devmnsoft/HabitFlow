@model HabitFlow.Application.LeaderboardPage
@{ViewData["Title"]="Ranking seguro";}
@section Styles{<link rel="stylesheet" href="~/css/gamification.css" asp-append-version="true"/>}
<main class="gamification-section"><header class="hf-page-header gamification-hero"><div><p class="hf-eyebrow">Opcional e positivo</p><h1>Ranking seguro</h1><p>Compartilhe apenas um apelido. Hábitos, e-mail e outros dados pessoais nunca são exibidos.</p></div><a class="btn btn-light" href="/gamification">Meu progresso</a></header>
<section class="gamification-stats" aria-label="Seus pontos"><article class="hf-card"><small>Pontos reais</small><strong>@Model.Balance.TotalPoints</strong><span>@Model.Balance.TodayPoints de @Model.Balance.DailyLimit hoje</span></article><article class="hf-card"><small>Participação</small><strong>@(Model.Preference.IsOptedIn?"Ativa":"Privada")</strong><span>Você pode sair quando quiser</span></article></section>
<form method="post" action="/leaderboard/preference" class="hf-card p-4">@Html.AntiForgeryToken()<h2 class="h4">Privacidade do ranking</h2><label class="form-label" for="publicName">Nome público ou apelido</label><input id="publicName" name="publicName" value="@Model.Preference.PublicName" maxlength="40" class="form-control" required/><fieldset class="mt-3"><legend class="h6">Quem pode comparar pontos?</legend><label class="me-3"><input type="radio" name="scope" value="Private" checked="@(Model.Preference.Scope==HabitFlow.Domain.LeaderboardScope.Private)"/> Privado</label><label class="me-3"><input type="radio" name="scope" value="Team" checked="@(Model.Preference.Scope==HabitFlow.Domain.LeaderboardScope.Team)"/> Meu time</label><label><input type="radio" name="scope" value="General" checked="@(Model.Preference.Scope==HabitFlow.Domain.LeaderboardScope.General)"/> Geral</label></fieldset><div class="mt-3"><button class="btn btn-success" name="optedIn" value="true">Participar</button>@if(Model.Preference.IsOptedIn){<button class="btn btn-outline-secondary" name="optedIn" value="false">Sair do ranking</button>}</div></form>
<section class="mt-4"><h2>Participantes</h2><div class="badge-grid">@foreach(var item in Model.Entries){<article class="hf-card badge-card"><span class="badge-icon">@item.Position</span><div><strong>@item.PublicName</strong><p>@item.Points pontos de consistência</p></div></article>}@if(Model.Entries.Count==0){<div class="hf-card empty-kind"><strong>Seu espaço continua privado</strong><p>Participe quando fizer sentido. Não há punição por ficar fora.</p></div>}</div></section></main>
