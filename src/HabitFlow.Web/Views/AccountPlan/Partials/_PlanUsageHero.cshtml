@model HabitFlow.Web.Models.PlanUsageViewModel
<section class="p-4 p-lg-5 mb-4 rounded-4 bg-success-subtle" aria-labelledby="plan-usage-title">
    <span class="text-success fw-semibold">Plano efetivo</span>
    <h1 id="plan-usage-title" class="display-6 fw-bold">@Model.PlanName</h1>
    <p>Plano contratado: <strong>@Model.ContractedPlanName</strong></p>
    @if (!string.IsNullOrWhiteSpace(Model.RestrictionReason))
    {
        <div class="alert alert-warning mb-3" role="status">@Model.RestrictionReason</div>
    }
    @if (Model.HasPaidSubscription)
    {
        <p class="lead mb-0">Acompanhe seus limites, recursos e assinatura em um só lugar.</p>
    }
    else
    {
        <p class="lead mb-0">Você está no plano gratuito. Sua rotina e seus dados continuam sob seu controle.</p>
    }
    @if (Model.NextBillingAt is not null)
    {
        <p class="mt-3 mb-0">Próxima cobrança ou renovação: <strong>@Model.NextBillingAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</strong>@if (Model.PaymentStatus is not null) { <text> · Status: @Model.PaymentStatus</text> }</p>
    }
</section>
