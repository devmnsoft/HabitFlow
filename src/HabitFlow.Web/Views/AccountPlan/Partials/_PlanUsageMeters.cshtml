@model HabitFlow.Web.Models.PlanUsageViewModel
<section class="row g-3 mb-4" aria-label="Limites e uso">
@foreach (var item in new[] { Model.ActiveHabits, Model.ActiveGoals, Model.AccountPeople })
{
    <div class="col-12 col-md-6 col-xl-4">
        <article class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-3">
                    <h2 class="h5">@item.Label</h2>
                    <strong>@item.Current@(item.Limit is null or < 0 ? " · ilimitado" : $" de {item.Limit}")</strong>
                </div>
                @if (item.Percentage is not null)
                {
                    <div class="progress" role="progressbar" aria-label="Uso de @item.Label" aria-valuenow="@item.Percentage" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @(item.IsAtLimit ? "bg-danger" : item.IsNearLimit ? "bg-warning" : "bg-success")" style="width:@item.Percentage%"></div>
                    </div>
                    <p class="small mt-2 mb-0">
                        @if (item.IsAtLimit) { <span>O limite foi atingido. Itens existentes são preservados; novas admissões ficam bloqueadas.</span> }
                        else if (item.IsNearLimit) { <span>Você está perto do limite: ainda há @item.Available vaga(s) disponível(is).</span> }
                        else { <span>@item.Available vaga(s) disponível(is) neste plano.</span> }
                    </p>
                }
                else { <p class="text-secondary mb-0">Uso ilimitado para este recurso.</p> }
                @if (item.Label == "Pessoas da conta" && Model.ExcessAccountPeople > 0)
                {
                    <p class="small text-warning-emphasis mt-2 mb-0">@Model.ExcessAccountPeople vaga(s) acima da capacidade após alteração de plano. As pessoas e seus dados foram preservados.</p>
                }
            </div>
        </article>
    </div>
}
</section>
