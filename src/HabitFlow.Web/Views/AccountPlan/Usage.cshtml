@model HabitFlow.Web.Models.PlanUsageViewModel
@{ ViewData["Title"] = "Uso do plano"; }
<main class="container py-4 plan-usage-page">
  @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
  @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
  @if (TempData["Info"] is string info) { <div class="alert alert-info" role="status">@info</div> }
  <partial name="Partials/_PlanUsageHero" model="Model" />
  <partial name="Partials/_PlanUsageMeters" model="Model" />
  <partial name="Partials/_PlanFeatureGrid" model="Model" />
  <partial name="Partials/_PlanBlockedFeatures" model="Model" />
  <partial name="Partials/_PlanUpgradeCard" model="Model" />
  <aside class="alert alert-light border mt-4"><strong>Se seu plano mudar:</strong> seus dados não são apagados e você continua podendo editar o que já criou. Limites valem apenas para novas criações.</aside>
  <div class="d-flex gap-2 flex-wrap"><a class="btn btn-success" href="/plans">Ver planos</a><a class="btn btn-outline-success" href="/my-day">Voltar ao Meu Dia</a></div>
</main>
