@model HabitFlow.Web.Models.PlanChangeImpactViewModel
@{ ViewData["Title"] = "Revisar mudança de plano"; }
<main class="container py-5"><div class="card shadow-sm mx-auto" style="max-width:720px"><div class="card-body p-4"><h1 class="h3">Plano @Model.PlanName</h1><partial name="Partials/_PlanChangeImpact" model="Model" />@if(!Model.IsCurrent){<form method="post" asp-action="ConfirmChange" asp-route-planCode="@Model.PlanCode">@Html.AntiForgeryToken()<button class="btn btn-success" type="submit">Continuar com segurança</button></form>}else{<a class="btn btn-outline-success" href="/account/plan/usage">Voltar ao uso do plano</a>}</div></div></main>
