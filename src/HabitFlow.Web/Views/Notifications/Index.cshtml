@model IReadOnlyList<HabitFlow.Domain.Notification>
@{ ViewData["Title"] = "Notificações"; }
<section class="hero-card"><h1>Notificações</h1><p>Acompanhe conquistas, lembretes e avisos persistentes em um só lugar.</p><form method="post" action="/notifications/read-all">@Html.AntiForgeryToken()<button class="btn btn-outline-success" data-loading-text="Atualizando...">Marcar todas como lidas</button></form></section>
<div class="hf-notification-list mt-3">@foreach (var n in Model){<article class="hf-notification-item"><div class="d-flex justify-content-between gap-3 flex-wrap"><div><span class="hf-status-badge">@n.Severity</span><h2 class="h5 mt-2">@n.Title</h2><p>@n.Message</p>@if(!string.IsNullOrWhiteSpace(n.ActionUrl)){<a class="btn btn-sm btn-outline-success" href="@n.ActionUrl">Abrir ação</a>}</div><form method="post" action="/notifications/@n.Id/read">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success" data-loading-text="Marcando...">Marcar como lida</button></form></div></article>}@if(!Model.Any()){<div class="hf-empty-state"><h2 class="h5">Nenhuma notificação nova.</h2><p class="mb-0">Quando houver conquistas, lembretes ou avisos persistentes, eles aparecerão aqui.</p></div>}</div>
