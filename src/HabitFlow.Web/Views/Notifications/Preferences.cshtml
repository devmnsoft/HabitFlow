@model HabitFlow.Web.Models.PushNotificationViewModel
@{ ViewData["Title"] = "Preferências de notificações"; }
@section Styles { <link rel="stylesheet" href="~/css/notification-preferences.css" asp-append-version="true" /> }
<header class="py-3"><a href="/notifications">← Notificações</a><h1>Como você quer ser lembrado?</h1><p>Você controla cada canal. As notificações internas funcionam sem Web Push e nenhuma permissão é solicitada sem sua ação.</p></header>
<div class="notification-grid">
<section class="notification-card" aria-labelledby="browser-title"><h2 id="browser-title">Notificações do navegador</h2>
@if (Model.PushConfigured) {<p id="push-status" aria-live="polite">Verificando suporte…</p><button type="button" class="btn btn-success" id="enable-push" data-public-key="@Model.PublicKey">Ativar neste dispositivo</button>}
else {<p class="alert alert-info">Web Push não está configurado neste ambiente. Você continuará recebendo notificações internas; o HabitFlow não solicitará permissão do navegador.</p>}
</section>
<section class="notification-card"><h2>Preferências</h2><form class="notification-form" method="post" action="/notifications/preferences" data-notification-preferences>@Html.AntiForgeryToken()
<fieldset><legend>Canais</legend>
<label class="form-check form-switch"><input class="form-check-input" type="checkbox" name="internalEnabled" value="true" checked="@Model.Preference.InternalEnabled"> Notificações internas</label>
@if(Model.PushConfigured){<label class="form-check form-switch"><input class="form-check-input" type="checkbox" name="pushEnabled" value="true" checked="@Model.Preference.PushEnabled"> Notificações do navegador</label>}
</fieldset>
<fieldset><legend>Conteúdo</legend>
<label class="form-check"><input class="form-check-input" type="checkbox" name="habitReminders" value="true" checked="@Model.Preference.HabitReminders"> Lembretes de hábitos</label>
<label class="form-check"><input class="form-check-input" type="checkbox" name="dailySummary" value="true" checked="@Model.Preference.DailySummary"> Resumo diário</label>
<label class="form-check"><input class="form-check-input" type="checkbox" name="weeklySummary" value="true" checked="@Model.Preference.WeeklySummary"> Resumo semanal</label>
</fieldset>
<fieldset><legend>Horário silencioso</legend><p class="text-muted">Deixe ambos vazios para não silenciar.</p><div class="quiet-grid"><label>Início<input class="form-control" type="time" name="quietStart" value="@Model.Preference.QuietStart"></label><label>Fim<input class="form-control" type="time" name="quietEnd" value="@Model.Preference.QuietEnd"></label></div></fieldset>
<label>Timezone<select class="form-select" name="timezone" required><option value="America/Sao_Paulo" selected="@(Model.Preference.Timezone=="America/Sao_Paulo")">Brasília (São Paulo)</option><option value="America/Manaus" selected="@(Model.Preference.Timezone=="America/Manaus")">Manaus</option><option value="America/Belem" selected="@(Model.Preference.Timezone=="America/Belem")">Belém</option><option value="America/Fortaleza" selected="@(Model.Preference.Timezone=="America/Fortaleza")">Fortaleza</option><option value="UTC" selected="@(Model.Preference.Timezone=="UTC")">UTC</option></select></label>
<label>Idioma<select class="form-select" name="language" required><option value="pt-BR" selected="@(Model.Preference.Language=="pt-BR")">Português (Brasil)</option><option value="en-US" selected="@(Model.Preference.Language=="en-US")">English (US)</option></select></label>
<label>Limite diário<input class="form-control" type="number" inputmode="numeric" name="maximumPerDay" min="1" max="20" required value="@Model.Preference.MaximumPerDay"></label>
<button class="btn btn-success" type="submit">Salvar preferências</button></form></section>
<section class="notification-card"><h2>Seus dispositivos</h2>@if(Model.Devices.Count==0){<p>Nenhum dispositivo conectado.</p>}@foreach(var d in Model.Devices){<div class="device"><span><strong>@d.DeviceName</strong><br><small>@(d.IsActive?"Ativo":"Revogado")</small></span>@if(d.IsActive){<button type="button" class="btn btn-outline-danger remove-device" data-id="@d.Id">Revogar</button>}</div>}
@if(Model.PushConfigured && Model.Devices.Any(d=>d.IsActive)){<form method="post" action="/notifications/push/test">@Html.AntiForgeryToken()<button class="btn btn-outline-success">Testar notificação</button></form>}
</section></div>
@section Scripts {<script src="~/js/push-notifications.js" asp-append-version="true"></script>}
