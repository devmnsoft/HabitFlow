@model HabitFlow.Web.Models.PushNotificationViewModel
@{ViewData["Title"]="Preferências de notificações";}
@section Styles{<style>.push-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))}.push-card{padding:1.25rem;border:1px solid #dbe7e2;border-radius:1rem;background:#fff}.push-card button,.push-card input,.push-card select{min-height:44px}.device{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.75rem 0;border-top:1px solid #e2e8f0}</style>}
<header><a href="/notifications">← Notificações</a><h1>Como você quer ser lembrado?</h1><p>O HabitFlow só pede permissão quando você escolher ativar. Push complementa as notificações internas.</p></header>
<div class="push-grid">
<section class="push-card"><h2>Push neste dispositivo</h2><p id="push-status" aria-live="polite">Verificando suporte…</p><button class="btn btn-success" id="enable-push" data-public-key="@Model.PublicKey">Ativar push</button></section>
<section class="push-card"><h2>Preferências</h2><form method="post" action="/notifications/preferences">@Html.AntiForgeryToken()<label class="form-check"><input class="form-check-input" type="checkbox" name="pushEnabled" value="true" checked="@Model.Preference.PushEnabled"> Push</label><input type="hidden" name="internalEnabled" value="true"><label>Silêncio de <input type="time" name="quietStart" value="@Model.Preference.QuietStart"></label><label> até <input type="time" name="quietEnd" value="@Model.Preference.QuietEnd"></label><label>Máximo diário <input type="number" inputmode="numeric" name="maximumPerDay" min="1" max="20" value="@Model.Preference.MaximumPerDay"></label><button class="btn btn-success" type="submit">Salvar preferências</button></form></section>
<section class="push-card"><h2>Seus dispositivos</h2>@if(Model.Devices.Count==0){<p>Nenhum dispositivo conectado.</p>}@foreach(var d in Model.Devices){<div class="device"><span><strong>@d.DeviceName</strong><br><small>@(d.IsActive?"Ativo":"Inativo")</small></span><button class="btn btn-outline-danger remove-device" data-id="@d.Id">Remover</button></div>}<form method="post" action="/notifications/push/test">@Html.AntiForgeryToken()<button class="btn btn-outline-success">Enviar teste</button></form></section>
</div>
@section Scripts{<script src="~/js/push-notifications.js" asp-append-version="true"></script>}
