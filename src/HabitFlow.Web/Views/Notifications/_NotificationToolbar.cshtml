@{
    var search = Context.Request.Query["search"].ToString();
    var filter = Context.Request.Query["filter"].ToString();
    var category = Context.Request.Query["category"].ToString();
    var archived = Context.Request.Query["archived"].ToString();

    var isAll =
        (string.IsNullOrWhiteSpace(filter) ||
         string.Equals(filter, "all", StringComparison.OrdinalIgnoreCase)) &&
        string.IsNullOrWhiteSpace(category) &&
        !string.Equals(archived, "true", StringComparison.OrdinalIgnoreCase);

    var isUnread =
        string.Equals(filter, "unread", StringComparison.OrdinalIgnoreCase);

    var isRead =
        string.Equals(filter, "read", StringComparison.OrdinalIgnoreCase);

    var isReminder =
        string.Equals(category, "reminder", StringComparison.OrdinalIgnoreCase);

    var isProgress =
        string.Equals(category, "progress", StringComparison.OrdinalIgnoreCase);

    var isArchived =
        string.Equals(archived, "true", StringComparison.OrdinalIgnoreCase);
}

<form method="get"
      action="/notifications"
      class="notification-toolbar"
      role="search">

    <label class="visually-hidden"
           for="notification-search">
        Buscar notificações
    </label>

    <input id="notification-search"
           name="search"
           type="search"
           class="form-control"
           placeholder="Buscar notificações"
           value="@search"
           autocomplete="off" />

    <div class="filter-pills"
         aria-label="Filtrar notificações">

        <a href="/notifications"
           aria-current="@(isAll ? "page" : null)">
            Todas
        </a>

        <a href="/notifications?filter=unread"
           aria-current="@(isUnread ? "page" : null)">
            Não lidas
        </a>

        <a href="/notifications?filter=read"
           aria-current="@(isRead ? "page" : null)">
            Lidas
        </a>

        <a href="/notifications?category=reminder"
           aria-current="@(isReminder ? "page" : null)">
            Lembretes
        </a>

        <a href="/notifications?category=progress"
           aria-current="@(isProgress ? "page" : null)">
            Progresso
        </a>

        <a href="/notifications?archived=true"
           aria-current="@(isArchived ? "page" : null)">
            Arquivadas
        </a>
    </div>

    <button class="btn btn-success"
            type="submit">
        Buscar
    </button>
</form>