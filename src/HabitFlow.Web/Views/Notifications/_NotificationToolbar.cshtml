@{ var filter = Context.Request.Query["filter"].ToString(); }
<form method="get" action="/notifications" class="notification-toolbar" role="search"><label class="visually-hidden" for="notification-search">Buscar notificações</label><input id="notification-search" name="search" class="form-control" placeholder="Buscar notificações" value="@Context.Request.Query["search"].ToString()" /><div class="filter-pills" aria-label="Filtrar notificações"><a href="/notifications" aria-current="@(filter is "" or "all" ? "page":null)">Todas</a><a href="/notifications?filter=unread">Não lidas</a><a href="/notifications?filter=read">Lidas</a><a href="/notifications?category=reminder">Lembretes</a><a href="/notifications?category=progress">Progresso</a><a href="/notifications?archived=true">Arquivadas</a></div><button class="btn btn-success">Buscar</button></form>
