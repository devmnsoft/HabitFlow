@model HabitFlow.Domain.Notification
@inject HabitFlow.Application.NotificationActionUrlValidator UrlValidator
<article class="notification-card @(!Model.IsRead?"is-unread":"")"><span class="notification-category-icon" aria-hidden="true">@(Model.Type.Contains("reminder",StringComparison.OrdinalIgnoreCase)?"⏰":Model.Type.Contains("goal",StringComparison.OrdinalIgnoreCase)?"◎":"✓")</span><div class="notification-content"><div class="notification-title"><h3>@Model.Title</h3>@if(!Model.IsRead){<span>Nova</span>}</div><p>@Model.Message</p><time datetime="@Model.CreatedAt.ToString("O")">@Model.CreatedAt.ToString("dd/MM, HH:mm")</time>@if(UrlValidator.IsSafe(Model.ActionUrl)&&!string.IsNullOrEmpty(Model.ActionUrl)){<a href="@Model.ActionUrl">Ver detalhes →</a>}</div><div class="notification-actions"><form method="post" action="/notifications/@Model.Id/@(Model.IsRead?"unread":"read")">@Html.AntiForgeryToken()<button aria-label="Marcar @(Model.IsRead?"como não lida":"como lida")">@(Model.IsRead?"○":"✓")</button></form><form method="post" action="/notifications/@Model.Id/archive">@Html.AntiForgeryToken()<button aria-label="Arquivar notificação">⋯</button></form></div></article>
