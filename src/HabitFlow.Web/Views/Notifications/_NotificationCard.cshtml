@model HabitFlow.Domain.Notification
@inject HabitFlow.Application.NotificationActionUrlValidator UrlValidator
@{ var archived = Context.Request.Query["archived"] == "true"; var type = Model.Type.ToLowerInvariant(); var icon = type.Contains("reminder") ? "⏰" : type.Contains("goal") ? "◎" : type.Contains("plan") ? "◆" : type.Contains("privacy") ? "◈" : type.Contains("system") ? "●" : "✓"; }
<article class="notification-card @(!Model.IsRead?"is-unread":"")" data-notification-type="@type"><span class="notification-category-icon" aria-hidden="true">@icon</span><div class="notification-content"><div class="notification-title"><h3>@Model.Title</h3>@if(!Model.IsRead){<span>Nova</span>}</div><p>@Model.Message</p><time datetime="@Model.CreatedAt.ToString("O")" data-relative-time>@Model.CreatedAt.ToString("dd/MM, HH:mm")</time>@if(UrlValidator.IsSafe(Model.ActionUrl)&&!string.IsNullOrEmpty(Model.ActionUrl)){<a href="@Model.ActionUrl">Ver detalhes →</a>}</div><div class="notification-actions"><form method="post" action="/notifications/@Model.Id/@(Model.IsRead?"unread":"read")">@Html.AntiForgeryToken()<button aria-label="Marcar @(Model.IsRead?"como não lida":"como lida")">@(Model.IsRead?"○":"✓")</button></form><form method="post" action="/notifications/@Model.Id/@(archived?"restore":"archive")">@Html.AntiForgeryToken()<button aria-label="@(archived?"Restaurar":"Arquivar") notificação">@(archived?"↩":"⌄")</button></form></div></article>
