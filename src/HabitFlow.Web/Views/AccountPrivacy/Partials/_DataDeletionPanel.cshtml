@model HabitFlow.Web.Models.AccountPrivacyViewModel
<section class="privacy-card privacy-card--warning"><div class="privacy-card__heading"><div><span>Decisões críticas</span><h2>Exclusão ou anonimização</h2></div></div><p><strong>Cancelar sua assinatura não exclui seus dados automaticamente.</strong> Solicitações são analisadas com segurança; dados podem ser mantidos por obrigação legal ou defesa de direitos.</p><div class="privacy-actions"><button class="btn btn-outline-danger" type="button" data-feedback-confirm data-form="privacy-delete" @(Model.Deletion.HasPendingDeletion ? "disabled" : null)>Solicitar exclusão</button><button class="btn btn-outline-secondary" type="button" data-feedback-confirm data-form="privacy-anonymize" @(Model.Deletion.HasPendingAnonymization ? "disabled" : null)>Solicitar anonimização</button></div><form id="privacy-delete" method="post" action="/account/privacy/delete-request" hidden>@Html.AntiForgeryToken()</form><form id="privacy-anonymize" method="post" action="/account/privacy/anonymization-request" hidden>@Html.AntiForgeryToken()</form></section>
