@model HabitFlow.Web.Models.AccountPrivacyViewModel
<section class="privacy-card"><div class="privacy-card__heading"><div><span>Auditoria</span><h2>Atividade recente de privacidade</h2></div></div>@if(Model.Activity.Count == 0){<p>Nenhuma solicitação registrada. As novas atividades aparecerão aqui.</p>}else{<ol class="privacy-timeline">@foreach(var item in Model.Activity){<li><span></span><div><strong>@item.Title</strong><small>@item.Detail</small><time datetime="@item.OccurredAt.ToString("O")">@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div></li>}</ol>}</section>
