@model HabitFlow.Web.Models.AccountPrivacyViewModel
<section class="privacy-card"><div class="privacy-card__heading"><div><span>Preferências</span><h2>Consentimentos atuais</h2></div><a href="/privacy">Ler política pública</a></div><p>O tratamento essencial mantém a conta segura e não pode ser desativado aqui.</p><div class="privacy-consents">@foreach(var consent in Model.Consents){<form method="post" action="/account/privacy/consents" class="privacy-consent"><input type="hidden" name="key" value="@consent.Key"/><input type="hidden" name="granted" value="@(!consent.Granted)"/>@Html.AntiForgeryToken()<div><strong>@consent.Title</strong><small>@consent.Description</small></div><button class="btn @(consent.Granted ? "btn-outline-success" : "btn-outline-secondary")" type="submit" disabled="@(consent.Key == "essential")">@(consent.Granted ? "Ativo" : "Ativar")</button></form>}</div><p class="privacy-legal-links"><a href="/terms">Termos de Uso</a><span aria-hidden="true">·</span><a href="/privacy">Política de Privacidade</a></p></section>
