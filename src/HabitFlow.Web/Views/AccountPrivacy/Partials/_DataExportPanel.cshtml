@model HabitFlow.Web.Models.AccountPrivacyViewModel
<section class="privacy-card"><div class="privacy-card__heading"><div><span>Portabilidade</span><h2>Exportar meus dados</h2></div></div><p>Registre um pedido para receber uma cópia dos dados associados à sua conta. A equipe validará sua identidade antes de preparar o arquivo.</p><form method="post" action="/account/privacy/export-request">@Html.AntiForgeryToken()<button class="btn btn-success" type="submit" disabled="@Model.Export.HasPendingRequest">@(Model.Export.HasPendingRequest ? "Solicitação em análise" : "Solicitar exportação")</button></form></section>
