@model HabitFlow.Web.Models.AccountPrivacyViewModel
<section class="privacy-card"><div class="privacy-card__heading"><div><span>Portabilidade</span><h2>Baixar meus dados</h2></div></div><p>Baixe agora uma cópia JSON com perfil, hábitos, metas, rotinas, conclusões, preferências, notificações, conquistas e consentimentos. Senhas, tokens e dados de pagamento nunca são incluídos.</p><div class="privacy-actions"><form method="post" action="/account/privacy/export/json">@Html.AntiForgeryToken()<button class="btn btn-success" type="submit">Baixar JSON</button></form><form method="post" action="/account/privacy/export-request">@Html.AntiForgeryToken()<button class="btn btn-outline-success" type="submit" disabled="@Model.Export.HasPendingRequest">@(Model.Export.HasPendingRequest ? "CSV em análise" : "Solicitar CSV")</button></form></div></section>
