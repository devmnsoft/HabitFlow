@model HabitFlow.Domain.GamificationSnapshot
@{ViewData["Title"]="Progresso pessoal";var level=Model.TotalCompletions switch{>=100=>"Constante",>=30=>"Em evolução",>=7=>"Criando ritmo",_=>"Começando"};}
@section Styles{<link rel="stylesheet" href="~/css/gamification.css" asp-append-version="true"/>}
<header class="hf-page-header gamification-hero"><div><p class="hf-eyebrow">Sua jornada, no seu ritmo</p><h1>Progresso pessoal</h1><p>Pequenos passos viram uma rotina possível. Hoje conta. Amanhã continua.</p></div><a class="btn btn-outline-primary" href="/progress/calendar">Abrir calendário</a></header>
<section class="gamification-stats" aria-label="Resumo pessoal"><article class="hf-card"><small>Nível de consistência</small><strong>@level</strong><span>@Model.TotalCompletions conclusões reais</span></article><article class="hf-card"><small>Sequência atual</small><strong>@Model.CurrentStreak dias</strong><span>Sem comparação com outras pessoas</span></article><article class="hf-card"><small>Melhor sequência</small><strong>@Model.BestStreak dias</strong><span>Sua própria referência</span></article></section>
<section class="gamification-section"><div class="section-heading"><div><p class="hf-eyebrow">Esta semana</p><h2>Metas semanais</h2></div><a href="/weekly-goals">Criar ou ajustar</a></div>
@if(Model.WeeklyGoals.Count==0){<div class="hf-card empty-kind"><strong>Escolha um ritmo possível</strong><p>Uma meta curta ajuda a enxergar avanço sem pressão.</p><a class="btn btn-primary" href="/weekly-goals">Criar meta semanal</a></div>}else{@foreach(var goal in Model.WeeklyGoals.Take(2)){var percent=Math.Min(100,goal.CurrentCompletions*100/goal.TargetCompletions);<article class="hf-card goal-card"><div><strong>@goal.Name</strong><span>@goal.CurrentCompletions de @goal.TargetCompletions passos</span></div><div class="calm-progress" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"><i style="width:@percent%"></i></div><small>@(goal.Status=="Completed"?"Meta alcançada. Boa sequência esta semana.":$"{percent}% da meta")</small></article>}}</section>
<section class="gamification-section"><div class="section-heading"><div><p class="hf-eyebrow">Vitórias reais</p><h2>Conquistas</h2></div><a href="/achievements">Ver todas</a></div><div class="badge-grid">@foreach(var badge in Model.Achievements.Take(4)){<article class="hf-card badge-card"><span class="badge-icon" aria-hidden="true">✦</span><div><strong>@badge.Name</strong><p>@badge.Description</p><small>@badge.UnlockedAt.ToLocalTime().ToString("dd/MM/yyyy") · @badge.Rarity</small></div></article>}@if(Model.Achievements.Count==0){<div class="hf-card empty-kind"><strong>Sua primeira conquista está perto</strong><p>Conclua um passo para registrar o começo da jornada.</p></div>}</div></section>
<aside class="hf-card mission-card"><span aria-hidden="true">◎</span><div><small>Missão opcional</small><strong>Revise como foi sua semana</strong><p>Leva poucos minutos e ajuda a escolher o próximo passo.</p></div><a class="btn btn-outline-primary" href="/weekly-review">Revisar semana</a></aside>
