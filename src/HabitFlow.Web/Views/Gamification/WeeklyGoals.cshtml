@model HabitFlow.Web.Controllers.WeeklyGoalsPage
@{ViewData["Title"]="Metas semanais";}
@section Styles{<link rel="stylesheet" href="~/css/gamification.css" asp-append-version="true"/>}
<header class="hf-page-header"><div><p class="hf-eyebrow">Um passo de cada vez</p><h1>Metas semanais</h1><p>Defina um ritmo possível. Conclusões repetidas nunca contam duas vezes.</p></div><a href="/progress" class="btn btn-outline-primary">Ver progresso</a></header>
<div class="goal-layout"><section class="hf-card"><h2 class="h4">Nova meta</h2>@if(Model.Habits.Count==0){<p>Crie um hábito antes de montar sua meta semanal.</p><a href="/habits/create" class="btn btn-primary">Criar hábito</a>}else{<form method="post" action="/weekly-goals"><div asp-validation-summary="All"></div><label class="form-label" for="name">Nome da meta</label><input class="form-control" id="name" name="name" maxlength="120" required placeholder="Ex.: Cuidar de mim esta semana"/><label class="form-label mt-3" for="targetCompletions">Conclusões na semana</label><input class="form-control" id="targetCompletions" name="targetCompletions" type="number" min="1" max="100" value="5" required/><fieldset class="mt-3"><legend class="h6">Hábitos incluídos</legend>@foreach(var habit in Model.Habits){<label class="habit-choice"><input type="checkbox" name="habitIds" value="@habit.Id"/> <span>@habit.Name</span></label>}</fieldset><button class="btn btn-primary mt-3">Criar meta</button></form>}</section><section><h2 class="h4">Suas metas</h2>@if(Model.Goals.Count==0){<div class="hf-card empty-kind"><strong>Comece com uma meta leve</strong><p>Você pode ajustar o ritmo quando precisar.</p></div>}@foreach(var goal in Model.Goals){var percent=Math.Min(100,goal.CurrentCompletions*100/goal.TargetCompletions);<article class="hf-card goal-card"><div><strong>@goal.Name</strong><span>@goal.WeekStart.ToString("dd/MM")–@goal.WeekEnd.ToString("dd/MM")</span></div><div class="calm-progress"><i style="width:@percent%"></i></div><p>@goal.CurrentCompletions de @goal.TargetCompletions · @(goal.Status=="Completed"?"Meta alcançada":"Em andamento")</p></article>}</section></div>
