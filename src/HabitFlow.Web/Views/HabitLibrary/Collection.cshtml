@model HabitFlow.Application.HabitTemplateCollectionDetails
@{ ViewData["Title"] = Model.Collection.Name; }
<main class="container py-4"><a asp-action="Collections">← Coleções</a><h1 class="mt-3">@Model.Collection.Name</h1><p>@Model.Collection.Description</p>
<ul class="list-group mb-4">@foreach(var item in Model.Items){<li class="list-group-item d-flex justify-content-between"><span><strong>@item.Template.Name</strong><br/><small>@item.Template.Description</small></span>@if(item.IsRequired){<span class="badge text-bg-primary align-self-start">Obrigatório</span>}</li>}</ul>
<a class="btn btn-primary" asp-action="CustomizeCollection" asp-route-slug="@Model.Collection.Slug">Personalizar coleção</a></main>
