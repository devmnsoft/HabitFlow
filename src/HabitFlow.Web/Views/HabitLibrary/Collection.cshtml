@model HabitFlow.Application.HabitTemplateCollectionDetails
@{ViewData["Title"]=Model.Collection.Name;}
<link rel="stylesheet" href="~/css/habit-library.css" asp-append-version="true" />
<main class="container py-4"><a class="hf-back" asp-action="Collections">← Todas as coleções</a><header class="hf-hero mt-3"><span class="hf-icon" aria-hidden="true">@(Model.Collection.IconCode ?? "✦")</span><h1>@Model.Collection.Name</h1><p>@Model.Collection.Description</p><div class="d-flex flex-wrap gap-2"><span class="hf-tag">@(Model.Collection.EstimatedTimeMinutes ?? Model.Items.Sum(x=>x.Template.EstimatedTimeMinutes ?? 0)) min</span><span class="hf-tag">@Model.Collection.Difficulty</span><span class="hf-tag">@Model.Items.Count hábitos</span></div></header>
<div class="row g-4 mt-1"><section class="col-lg-8" aria-labelledby="routine-title"><h2 id="routine-title" class="h4">Sua rotina, passo a passo</h2><ol class="hf-habit-list">@foreach(var item in Model.Items){<partial name="_CollectionHabitItem" model="item"/>}</ol></section><aside class="col-lg-4"><div class="hf-summary sticky-lg-top"><h2 class="h5">Pronto para começar?</h2><p>Revise horários, frequência e os itens opcionais antes de ativar.</p><p class="small">Plano mínimo: <strong>@Model.Collection.MinimumPlanCode</strong></p><a class="btn btn-primary w-100" asp-action="CustomizeCollection" asp-route-slug="@Model.Collection.Slug">Personalizar esta rotina</a></div></aside></div></main>
