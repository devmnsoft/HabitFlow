@model IReadOnlyList<HabitFlow.Domain.HabitTemplateCollection>
@{ ViewData["Title"] = "Coleções"; }
<link rel="stylesheet" href="~/css/habit-library.css" asp-append-version="true" />
<main class="container py-4" aria-labelledby="collections-title">
 <h1 id="collections-title">Coleções de hábitos</h1><p class="text-body-secondary">Rotinas completas para começar com segurança.</p>
 @if (Model.Count == 0) { <div class="alert alert-light">Nenhuma coleção publicada agora.</div> }
 <div class="row g-3">@foreach(var item in Model){<div class="col-12 col-md-6"><article class="card h-100"><div class="card-body"><h2 class="h5">@item.Name</h2><p>@item.Description</p><a class="btn btn-outline-primary" asp-action="Collection" asp-route-slug="@item.Slug">Ver coleção</a></div></article></div>}</div>
</main>
