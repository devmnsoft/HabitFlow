@model IReadOnlyList<HabitFlow.Domain.HabitObjective>
@{ ViewData["Title"] = "Biblioteca de hábitos"; string iconFor(string name) => name.ToLowerInvariant() switch { var n when n.Contains("sa") => "heart", var n when n.Contains("est") => "book", var n when n.Contains("prod") => "target", var n when n.Contains("bem") => "wellness", var n when n.Contains("org") => "organization", _ => "habit" }; }
<section class="hf-section hf-guided-card"><p class="hf-section-kicker">Escolha seu objetivo e comece</p><h1>Biblioteca de hábitos</h1><p class="lead text-muted">A biblioteca de hábitos ajuda você a começar rápido. Escolha uma categoria e adicione hábitos prontos à sua rotina.</p></section>
@await Html.PartialAsync("~/Views/Shared/Partials/_QuickHelpCard.cshtml", null, new ViewDataDictionary(ViewData){{"Text","A biblioteca de hábitos ajuda você a começar rápido. Escolha uma categoria e adicione hábitos prontos à sua rotina."}})
<section class="row g-3" aria-label="Objetivos disponíveis">@foreach (var objective in Model) { var icon=iconFor(objective.Name); <div class="col-md-6 col-xl-4"><article class="hf-objective-card h-100">@await Html.PartialAsync("~/Views/Shared/Partials/Icons/_Icon.cshtml", null, new ViewDataDictionary(ViewData){{"Name",icon},{"Class","hf-icon-lg"}})<h2 class="h4">@objective.Name</h2><p>@objective.Description</p><p><span class="hf-chip">Tempo curto</span> <span class="hf-chip">Fácil de iniciar</span></p><a class="btn btn-success" href="/habit-library/objective/@objective.Slug">Ver hábitos prontos</a></article></div>}</section>

@if ((bool?)ViewData["UsingFallback"] == true) { <section class="hf-empty-state mt-4"><h2>Não foi possível carregar os objetivos</h2><p>Tente novamente em instantes. Enquanto isso, você pode explorar hábitos sugeridos acima.</p><div class="d-flex justify-content-center gap-2 flex-wrap"><a class="btn btn-success" href="/habit-library">Tentar novamente</a><a class="btn btn-outline-success" href="/demo">Ver demonstração</a><a class="btn btn-outline-secondary" href="/help">Ir para ajuda</a></div></section> }
