@model IReadOnlyList<HabitFlow.Domain.HabitObjective>
@{ ViewData["Title"] = "Biblioteca de hábitos"; }
<section class="hf-section hf-guided-card"><p class="hf-section-kicker">Sua rotina pode começar pequena</p><h1>Por onde você quer começar?</h1><p class="lead text-muted">Escolha um objetivo e encontre pequenas ações que podem fazer parte da sua rotina.</p></section>
@await Html.PartialAsync("~/Views/Shared/Partials/_QuickHelpCard.cshtml", null, new ViewDataDictionary(ViewData){{"Text","A biblioteca de hábitos ajuda você a começar rápido. Escolha uma categoria e adicione hábitos prontos à sua rotina."}})
@if ((bool?)ViewData["UsingFallback"] == true) { <div class="alert alert-info">Estamos usando sugestões básicas enquanto a biblioteca completa é preparada.</div> }
<section class="row g-3" aria-label="Objetivos disponíveis">@foreach (var objective in Model) { <div class="col-md-6 col-xl-4"><article class="hf-objective-card h-100">@await Html.PartialAsync("~/Views/Shared/Partials/Icons/_Icon.cshtml", null, new ViewDataDictionary(ViewData){{"Name",objective.Icon ?? "habit"},{"Class","hf-icon-lg"}})<h2 class="h4">@objective.Name</h2><p>@objective.Description</p><p><span class="hf-chip">Tempo curto</span> <span class="hf-chip">Fácil de iniciar</span></p><a class="btn btn-success" href="/habit-library/objective/@objective.Slug">Ver hábitos prontos</a></article></div>}</section>

@if ((bool?)ViewData["UsingFallback"] == true) { <section class="hf-empty-state mt-4"><h2>Não foi possível carregar os objetivos</h2><p>Tente novamente em instantes. Enquanto isso, você pode explorar hábitos sugeridos acima.</p><div class="d-flex justify-content-center gap-2 flex-wrap"><a class="btn btn-success" href="/habit-library">Tentar novamente</a><a class="btn btn-outline-success" href="/demo">Ver demonstração</a><a class="btn btn-outline-secondary" href="/help">Ir para ajuda</a></div></section> }
