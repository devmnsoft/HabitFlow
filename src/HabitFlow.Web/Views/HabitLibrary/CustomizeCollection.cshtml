@model HabitFlow.Web.Models.CollectionCustomizationViewModel
@{ViewData["Title"]="Personalizar rotina";}
<link rel="stylesheet" href="~/css/habit-library.css" asp-append-version="true" />
<main class="container py-4"><a class="hf-back" asp-action="Collection" asp-route-slug="@Model.Details!.Collection.Slug">← Voltar aos detalhes</a><header class="hf-hero mt-3"><h1>Deixe a rotina com a sua cara</h1><p>Escolha os itens opcionais e ajuste como cada hábito entra no seu dia.</p></header>
<form method="post" asp-action="ActivateCollection" asp-route-slug="@Model.Details.Collection.Slug" data-collection-form data-plan-remaining="@Model.PlanUsage.Remaining"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="visually-hidden" aria-live="polite" data-form-status></div><input type="hidden" asp-for="CollectionId"/><input type="hidden" asp-for="IdempotencyKey"/>
<div class="row g-4"><div class="col-lg-8">@for(var i=0;i<Model.Items.Count;i++){<partial name="_CollectionCustomizationEditor" model="(Model.Items[i],Model.Details.Items.Single(x=>x.TemplateId==Model.Items[i].TemplateId),i)"/>}
<section class="hf-editor"><h2 class="h5">Objetivo</h2><label class="form-label" asp-for="ExistingGoalId">Vincular a um objetivo existente</label><select class="form-select" asp-for="ExistingGoalId"><option value="">Sem objetivo</option>@foreach(var goal in Model.Goals){<option value="@goal.Id">@goal.Title</option>}</select><div class="form-check mt-3"><input class="form-check-input" asp-for="CreateGoal"/><label class="form-check-label" asp-for="CreateGoal">Criar um novo objetivo</label></div><label class="form-label mt-2" asp-for="GoalTitle">Nome do novo objetivo</label><input class="form-control" asp-for="GoalTitle"/></section></div>
<aside class="col-lg-4"><div class="sticky-lg-top hf-sidebar"><partial name="_PlanUsageSummary" model="Model.PlanUsage"/><partial name="_ActivationSummary" model="Model"/><button class="btn btn-primary btn-lg w-100" type="submit" data-submit>Ativar minha rotina</button></div></aside></div></form></main><script src="~/js/habit-collection.js" asp-append-version="true"></script>
