@model HabitFlow.Web.Models.CustomizeHabitTemplateViewModel
@using HabitFlow.Domain
@{ ViewData["Title"] = $"Personalizar {Model.TemplateName}"; }
<link rel="stylesheet" href="~/css/habit-library.css" asp-append-version="true" />
<main class="container py-4 hf-library-detail"><a class="btn btn-link px-0" href="/habit-library/template/@Model.TemplateId">← Voltar aos detalhes</a><div class="row g-4">
<aside class="col-lg-4" aria-label="Resumo do template"><h1 class="h3">@Model.TemplateName</h1><p>@Model.TemplateDescription</p>@if (!string.IsNullOrWhiteSpace(Model.Benefit)){<p><strong>Benefício:</strong> @Model.Benefit</p>}@if (!string.IsNullOrWhiteSpace(Model.FirstAction)){<p><strong>Primeira ação:</strong> @Model.FirstAction</p>}<dl><dt>Duração</dt><dd>@(Model.EstimatedTimeMinutes?.ToString() ?? "Flexível") min</dd><dt>Dificuldade</dt><dd>@Model.Difficulty</dd><dt>Plano necessário</dt><dd>@(Model.MinimumPlanCode == PlanCodes.Free ? "Disponível no plano atual" : "Biblioteca completa")</dd></dl>@if(Model.PlanUsage is not null){<p class="small">Uso do plano: @Model.PlanUsage.ActiveHabits hábito(s) ativo(s)@if(Model.PlanUsage.Limit is >= 0){<text> de @Model.PlanUsage.Limit</text>}.</p>}</aside>
<section class="col-lg-8"><h2 class="h4">Personalize seu hábito</h2><form method="post" data-customize-form novalidate>@Html.AntiForgeryToken()<input asp-for="TemplateId" type="hidden"/><input asp-for="IdempotencyKey" type="hidden"/><input asp-for="ReturnUrl" type="hidden"/><input asp-for="IsOnboarding" type="hidden"/><input asp-for="CollectionId" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div>
<div class="mb-3"><label asp-for="Name" class="form-label">Nome</label><input asp-for="Name" class="form-control" maxlength="120" required/><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="FrequencyType" class="form-label">Frequência</label><select asp-for="FrequencyType" class="form-select" data-frequency><option value="Daily">Todos os dias</option><option value="Weekdays">Dias úteis</option><option value="Weekends">Fins de semana</option><option value="CustomWeekly">Dias personalizados</option></select></div><div class="col-md-6 mb-3"><label asp-for="TargetPerWeek" class="form-label">Meta semanal</label><input asp-for="TargetPerWeek" class="form-control" type="number" min="1" max="7"/></div></div>
<fieldset class="mb-3" data-custom-days><legend class="h6">Dias da semana</legend><div class="d-flex flex-wrap gap-2">@foreach(var item in new[]{("0","Dom"),("1","Seg"),("2","Ter"),("3","Qua"),("4","Qui"),("5","Sex"),("6","Sáb")}){<label class="btn btn-outline-primary"><input class="form-check-input" type="checkbox" name="SelectedDays" value="@item.Item1" checked="@(Model.SelectedDays.Contains(int.Parse(item.Item1)))"/> @item.Item2</label>}</div></fieldset>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="PreferredTime" class="form-label">Horário preferido</label><input asp-for="PreferredTime" class="form-control" type="time"/><div class="form-text">Este horário organiza sua rotina; notificações não são criadas nesta versão.</div></div><div class="col-md-6 mb-3"><label asp-for="StartDate" class="form-label">Data de início</label><input asp-for="StartDate" class="form-control" type="date"/></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Color" class="form-label">Cor</label><select asp-for="Color" class="form-select">@foreach(var color in Model.AllowedColors){<option value="@color">@color</option>}</select></div><div class="col-md-6 mb-3"><label asp-for="Category" class="form-label">Categoria</label><input asp-for="Category" class="form-control" maxlength="80"/></div></div><div class="mb-3"><label asp-for="Notes" class="form-label">Notas (opcional)</label><textarea asp-for="Notes" class="form-control" maxlength="1000" rows="3"></textarea></div>
<fieldset class="border rounded p-3 mb-3"><legend class="h6 float-none w-auto px-2">Objetivo</legend><label asp-for="ExistingGoalId" class="form-label">Vincular objetivo existente</label><select asp-for="ExistingGoalId" class="form-select mb-3"><option value="">Nenhum</option>@foreach(var goal in Model.AvailableGoals){<option value="@goal.Id">@goal.Title</option>}</select><div class="form-check mb-2"><input asp-for="CreateGoal" class="form-check-input" data-create-goal/><label asp-for="CreateGoal" class="form-check-label">Criar um novo objetivo</label></div><div data-goal-fields><label asp-for="GoalTitle" class="form-label">Título</label><input asp-for="GoalTitle" class="form-control mb-2" maxlength="140"/><div class="row"><div class="col"><select asp-for="GoalTargetType" class="form-select"><option value="Count">Quantidade</option><option value="Frequency">Frequência</option><option value="Percentage">Percentual</option><option value="Streak">Sequência</option></select></div><div class="col"><input asp-for="GoalTargetValue" class="form-control" type="number" min="1" max="1000000" placeholder="Valor"/></div></div></div></fieldset>
<div class="form-check mb-3"><input asp-for="AllowVariation" class="form-check-input"/><label asp-for="AllowVariation" class="form-check-label">Criar uma variação, mesmo se eu já tiver este template</label></div><div class="alert alert-light"><strong>Revisão:</strong> a frequência, os dias, a meta e o horário acima serão preservados no novo hábito.</div><button class="btn btn-success" type="submit" data-submit disabled="@Model.PlanLimitReached"><span>Adicionar ao meu dia</span><span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-submit-spinner></span></button><p role="status" aria-live="polite" data-submit-status></p></form></section></div></main>
<script src="~/js/habit-template-customize.js" asp-append-version="true" defer></script>
