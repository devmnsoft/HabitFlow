@model HabitFlow.Domain.UserInvite?
@{
    ViewData["Title"] = "Aceitar convite";
}
<h1>Aceitar convite</h1>
@if (Model is null) { <div class="alert alert-warning">Este convite é inválido ou expirou.</div> }
else if (User.Identity?.IsAuthenticated != true) {
    <p>Você recebeu um convite para participar de uma conta HabitFlow. Entre com o e-mail convidado para continuar.</p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/login?returnUrl=%2Finvite%2F@ViewBag.Token">Entrar para aceitar</a>
        <a class="btn btn-outline-primary" href="/invite/@ViewBag.Token/register">Criar acesso para este convite</a>
    </div>
}
else {
    <p>Você foi convidado para participar deste cliente como <strong>@Model.Role</strong>.</p>
    <form method="post" action="/invite/@ViewBag.Token/accept">
        @Html.AntiForgeryToken()
        <button class="btn btn-success" type="submit">Aceitar convite</button>
    </form>
}
