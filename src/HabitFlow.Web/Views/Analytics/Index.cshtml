@model HabitFlow.Application.AnalyticsDashboard
@using HabitFlow.Domain
@{ViewData["Title"]="Minha evolução"; var peak=Math.Max(1,Model.Daily.Count == 0 ? 0 : Model.Daily.Max(x=>x.Completions));}
@section Styles{<link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true"/>}
<header class="hf-page-header"><div><p class="hf-eyebrow">Dados reais, no seu ritmo</p><h1>Minha evolução</h1><p>Entenda padrões sem cobrança. Todos os indicadores usam apenas seus registros no HabitFlow.</p></div><a class="btn btn-outline-primary" href="/reports">Relatórios e exportações</a></header>
<form method="get" class="hf-card analytics-filters" aria-label="Filtros da evolução">
 <label>Início<input class="form-control" type="date" name="start" value="@Model.Filter.Period.Start.ToString("yyyy-MM-dd")" max="@Model.Filter.Period.End.ToString("yyyy-MM-dd")" required/></label>
 <label>Fim<input class="form-control" type="date" name="end" value="@Model.Filter.Period.End.ToString("yyyy-MM-dd")" min="@Model.Filter.Period.Start.ToString("yyyy-MM-dd")" required/></label>
 <label>Hábito<select class="form-select" name="habit"><option value="">Todos</option>@foreach(var h in Model.FilterHabits){<option value="@h.Id" selected="@(Model.Filter.HabitId==h.Id)">@h.Name</option>}</select></label>
 <label>Categoria<select class="form-select" name="category"><option value="">Todas</option>@foreach(var c in Model.FilterCategories){<option selected="@(Model.Filter.Category==c)">@c</option>}</select></label>
 <label>Status<select class="form-select" name="status"><option value="">Todos</option>@foreach(var s in new[]{"Ativo","Pausado","Arquivado"}){<option selected="@(Model.Filter.Status==s)">@s</option>}</select></label>
 <label>Lembrete<select class="form-select" name="reminder"><option value="">Todos</option><option value="true" selected="@(Model.Filter.HasReminder==true)">Com lembrete</option><option value="false" selected="@(Model.Filter.HasReminder==false)">Sem lembrete</option></select></label>
 <button class="btn btn-primary" type="submit">Aplicar filtros</button><a class="btn btn-link" href="/analytics">Limpar</a>
</form>
<section class="analytics-metrics" aria-label="Indicadores principais">
@foreach(var item in new[]{("Hábitos ativos",Model.ActiveHabits.ToString()),("Pausados",Model.PausedHabits.ToString()),("Arquivados",Model.ArchivedHabits.ToString()),("Taxa diária",$"{Model.CompletionRateDaily:N1}%"),("Taxa semanal",$"{Model.CompletionRateWeekly:N1}%"),("Taxa mensal",$"{Model.CompletionRateMonthly:N1}%"),("Consistência 7 dias",$"{Model.Consistency7:N1}%"),("Consistência 28 dias",$"{Model.Consistency28:N1}%"),("Consistência 90 dias",$"{Model.Consistency90:N1}%"),("Sequência atual",$"{Model.CurrentStreak} dias"),("Melhor sequência",$"{Model.BestStreak} dias"),("Atrasos reais",Model.MissedCount.ToString()),("Lembretes ativos",Model.ActiveReminders.ToString()),("Lembretes atrasados",Model.LateReminders.ToString())}){<article class="hf-metric-card"><span>@item.Item1</span><strong>@item.Item2</strong></article>}
</section>
@if(Model.Habits.Count==0){<section class="hf-card text-center"><h2>Ainda não há dados para estes filtros</h2><p>Amplie o período ou escolha “Todos”. Seus registros futuros aparecerão aqui automaticamente.</p><a class="btn btn-outline-primary" href="/analytics">Limpar filtros</a></section>}
else{
<div class="analytics-grid"><section class="hf-card"><h2>Evolução diária</h2><div class="daily-chart" role="img" aria-label="Gráfico de conclusões por dia">@foreach(var d in Model.Daily){<span class="bar" style="--value:@(d.Completions*100/peak)%" title="@d.Date.ToString("dd/MM"): @d.Completions"><i></i><small>@d.Date.ToString("dd/MM")</small></span>}</div></section>
<section class="hf-card"><h2>Progresso por categoria</h2>@if(Model.Categories.Count==0){<p>Sem categorias com ocorrências no período.</p>}else{@foreach(var c in Model.Categories){<div class="category-row"><span>@c.Name <small>@c.Completions de @c.Scheduled</small></span><strong>@c.CompletionRate.ToString("N1")%</strong></div>}}</section></div><section class="hf-card"><h2>Melhores dias e horários</h2><p><strong>Horário mais frequente:</strong> @(Model.BestTimeOfDay ?? "Ainda não há registros suficientes.")</p><div class="weekday-chart" aria-label="Taxa de conclusão por dia da semana">@foreach(var d in Model.WeekDays){<div><span>@d.Day</span><progress max="100" value="@d.CompletionRate">@d.CompletionRate%</progress><strong>@d.CompletionRate.ToString("N1")%</strong></div>}</div></section>
<section class="hf-card"><h2>Ranking de hábitos</h2><div class="table-responsive"><table class="table"><thead><tr><th>Hábito</th><th>Status</th><th>Planejados</th><th>Conclusões</th><th>Atrasos</th><th>Consistência</th><th>Sequência</th><th>Lembrete</th></tr></thead><tbody>@foreach(var h in Model.Habits){<tr><th>@h.Name<small class="d-block text-muted">@(h.Category??"Sem categoria")</small></th><td>@h.Status</td><td>@h.Scheduled</td><td>@h.Completions</td><td>@h.MissedCount</td><td>@h.Consistency.ToString("N1")%</td><td>@h.CurrentStreak dias</td><td>@(h.HasReminder?"Ativo":"Não configurado")</td></tr>}</tbody></table></div></section>}
<section class="hf-card"><h2>Alertas úteis</h2>@if(Model.Insights.Count==0){<p>Seu período não gerou alertas. Continue registrando no seu ritmo.</p>}else{<div class="insight-list">@foreach(var i in Model.Insights){<article><strong>@i.Title</strong><p>@i.Description</p><small>@i.CalculatedReason</small><a href="@i.ActionRoute">@i.SuggestedAction</a></article>}</div>}</section>
