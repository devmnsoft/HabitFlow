@model HabitFlow.Web.Controllers.AdminEnvironmentViewModel
@{ ViewData["Title"] = "Diagnóstico operacional"; }
@section Styles { <link rel="stylesheet" href="~/css/admin-environment.css" asp-append-version="true" /> }
<section class="hf-diagnostics">
  <header>
    <span class="text-uppercase text-success fw-bold">Operações</span>
    <h1>Diagnóstico operacional</h1>
    <p>Visão segura do ambiente, sem credenciais, dados pessoais ou stack traces.</p>
  </header>
  <div class="hf-diagnostic-grid" aria-label="Resumo do sistema">
    <article><small>Banco de dados</small><strong class="@(Model.DatabaseStatus == "Healthy" ? "text-success" : "text-danger")">@Model.DatabaseStatus</strong></article>
    <article><small>Versão</small><strong>@Model.Version</strong></article>
    <article><small>Ambiente</small><strong>@Model.Environment</strong></article>
    <article><small>Hospedagem</small><strong>@Model.HostingMode</strong></article>
    <article><small>Servidor (UTC)</small><strong>@Model.ServerTimeUtc.ToString("yyyy-MM-dd HH:mm:ss")</strong></article>
    <article><small>WhatsApp</small><strong>@(Model.WhatsAppEnabled ? "Habilitado" : "Desabilitado")</strong></article>
  </div>
  <section class="hf-diagnostic-events">
    <h2>Implantações recentes</h2>
    @if (Model.RecentDeploymentEvents.Count == 0) { <p>Nenhum evento disponível ou banco temporariamente indisponível.</p> }
    else { <pre aria-label="Eventos recentes">@System.Text.Json.JsonSerializer.Serialize(Model.RecentDeploymentEvents, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre> }
  </section>
</section>
