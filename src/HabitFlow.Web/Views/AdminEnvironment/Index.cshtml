@model HabitFlow.Web.Controllers.AdminEnvironmentViewModel
@{ ViewData["Title"] = "Sistema > Ambiente"; }
<section class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3"><h1>Sistema &gt; Ambiente</h1><span class="badge bg-success">@Model.Version</span></div>
  <div class="row g-3">
    <div class="col-md-4"><div class="card"><div class="card-body"><small>Modo de execução</small><h4>@Model.HostingMode</h4></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><small>Ambiente</small><h4>@Model.Environment</h4></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><small>Status DB</small><h4>@Model.DatabaseStatus</h4></div></div></div>
  </div>
  <div class="card mt-3"><div class="card-body"><h2>Produção / Diagnóstico</h2><dl class="row"><dt class="col-sm-3">Connection string</dt><dd class="col-sm-9"><code>@Model.MaskedConnectionString</code></dd><dt class="col-sm-3">Telegram</dt><dd class="col-sm-9">@(Model.TelegramEnabled ? "Ativo" : "Inativo")</dd><dt class="col-sm-3">WhatsApp</dt><dd class="col-sm-9">@(Model.WhatsAppEnabled ? "Ativo" : "Inativo")</dd><dt class="col-sm-3">Publicação</dt><dd class="col-sm-9">@Model.PublishPath</dd></dl><a href="/docs/DEPLOY_WINDOWS_SEM_DOCKER.md">Docs de deploy</a></div></div>
  <div class="card mt-3"><div class="card-body"><h2>Últimos backups/deploys registrados</h2><p class="text-muted">Eventos são lidos de habitflow.deployment_events quando a migration 014 foi aplicada.</p><pre>@System.Text.Json.JsonSerializer.Serialize(Model.RecentDeploymentEvents)</pre></div></div>
</section>
