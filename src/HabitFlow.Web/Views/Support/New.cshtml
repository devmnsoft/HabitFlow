@using HabitFlow.Application
@{ViewData["Title"]="Novo chamado";var contact=(SupportContact)ViewBag.Contact;}
<section class="form-premium"><span class="assist-kicker">Suporte seguro</span><h1>Abrir chamado</h1><p>Descreva o problema sem incluir senha, token, cookie ou dados de pagamento.</p><form method="post" action="/support/tickets/new">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label>Categoria<select name="category" required><option value="Usage">Dúvida de uso</option><option value="Technical">Problema técnico</option><option value="Subscription">Assinatura</option><option value="Report">Relatório</option><option value="Notifications">Notificações</option><option value="Suggestion">Sugestão</option><option value="Other">Outro</option></select></label><label>Assunto<input name="subject" maxlength="160" required></label><label>Descrição<textarea name="description" maxlength="4000" rows="7" required></textarea></label><input type="hidden" name="currentRoute" id="ticket-route"><input type="hidden" name="viewport" id="ticket-viewport"><div class="safe-context">🔒 Anexaremos somente rota, navegador, viewport, versão, correlation ID, data e plano. Nunca senha, cookie, token ou stack trace.</div><button class="btn btn-primary">Criar chamado</button></form></section><partial name="~/Views/Shared/Partials/_SupportContact.cshtml" model="contact" />@section Styles{<link rel="stylesheet" href="~/css/assistance-v6169.css" asp-append-version="true">}@section Scripts{<script>document.getElementById('ticket-route').value=location.pathname;document.getElementById('ticket-viewport').value=`${innerWidth}x${innerHeight}`;</script>}
