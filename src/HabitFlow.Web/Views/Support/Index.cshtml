@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Suporte"; }
<header class="hf-page-header"><div><p class="hf-eyebrow">Ajuda humana</p><h1>Suporte HabitFlow</h1><p>Abra tickets, acompanhe status e fale com a MNSOFT sobre conta, LGPD ou operação.</p></div></header>
<div class="row g-3"><div class="col-lg-5">@await Html.PartialAsync("~/Views/Shared/Partials/_SupportContactCard.cshtml")</div><div class="col-lg-7"><div class="hf-card"><h2>Abrir ticket</h2><form method="post" action="/support/create">@Html.AntiForgeryToken()<div class="mb-3"><label class="form-label" for="title">Assunto</label><input id="title" name="title" required maxlength="160" class="form-control"></div><div class="mb-3"><label class="form-label" for="description">Descrição</label><textarea id="description" name="description" required rows="5" class="form-control"></textarea></div><button class="btn btn-success">Enviar ticket</button></form></div></div><div class="col-12"><div class="hf-card"><h2>Meus tickets</h2><p class="text-muted mb-0">Tickets abertos e atualizações aparecerão aqui com status claro: aberto, em análise ou resolvido.</p></div></div></div>

<section class="hf-section hf-premium-card">
  <h2>Sobre o HabitFlow</h2>
  <p>O HabitFlow ajuda pessoas a transformarem pequenas ações diárias em rotina. Ele mostra o que fazer hoje, registra seu progresso e ajuda você a manter consistência.</p>
  @await Html.PartialAsync("~/Views/Shared/Partials/_MNSOFTSignature.cshtml")
</section>
