@model HabitFlow.Web.Models.SupportIndexViewModel
@{ViewData["Title"]="Central de suporte";}
<main class="support-hub">
<header class="support-hero"><div><span>ATENDIMENTO MNSOFT</span><h1>Central de suporte</h1><p>Abra, acompanhe e responda chamados em um ambiente seguro. Você nunca precisa informar um ID técnico.</p></div>@if(Model.IsAuthenticated){<a class="btn btn-primary" href="/support/tickets/new">Abrir chamado</a>}else{<a class="btn btn-primary" href="/login?returnUrl=%2Fsupport%2Ftickets%2Fnew">Entrar para abrir chamado</a>}</header>
<section class="support-metrics" aria-label="Prazos de referência"><article><b>8h úteis</b><span>Crítica</span></article><article><b>24h úteis</b><span>Alta</span></article><article><b>48h úteis</b><span>Média</span></article><article><b>72h úteis</b><span>Baixa</span></article></section>
@if(Model.IsAuthenticated){<section><div class="support-section-title"><div><span>ACOMPANHAMENTO</span><h2>Meus chamados</h2></div><a href="/support/tickets/new">Novo chamado</a></div><div class="ticket-list">@foreach(var t in Model.Tickets){var late=t.SlaDueAt<DateTime.UtcNow&&t.Status!="Closed"&&t.Status!="Resolved"; <a class="ticket-card @(t.Priority=="Critical"?"critical":"")" href="/support/tickets/@t.Id"><div><small>@t.Protocol · @t.Category</small><h3>@t.Subject</h3><p>Atualizado @t.UpdatedAt.ToString("dd/MM/yyyy HH:mm") · SLA @t.SlaDueAt.ToString("dd/MM HH:mm")</p></div><div><span class="ticket-status @t.Status.ToLowerInvariant()">@t.Status</span>@if(late){<span class="sla-late">SLA vencido</span>}</div></a>}@if(Model.Tickets.Count==0){<div class="assist-empty"><div class="empty-orbit">✓</div><h2>Tudo tranquilo por aqui</h2><p>Você ainda não abriu chamados. Quando precisar, conte com a equipe MNSOFT.</p><a class="btn btn-primary" href="/support/tickets/new">Criar primeiro chamado</a></div>}</div></section>}else{<section class="assist-empty"><h2>Atendimento protegido</h2><p>Entre para que seus chamados fiquem vinculados à sua conta e empresa.</p><a class="btn btn-outline-primary" href="/help">Consultar ajuda</a></section>}
<section class="support-faq"><div class="support-section-title"><div><span>RESPOSTAS RÁPIDAS</span><h2>Base de ajuda</h2></div></div><div class="faq-grid">@foreach(var faq in new[]{("Como criar hábito","Acesse Hábitos, escolha Novo hábito e defina uma rotina possível."),("Como configurar lembrete","Abra o hábito, edite e escolha o horário do lembrete."),("Como ver meu progresso","O painel e a área Progresso mostram sua evolução por período."),("Como trocar plano","Acesse Meu plano para comparar opções e iniciar a mudança."),("Como cancelar assinatura","Em Meu plano, abra Assinatura. Se precisar, crie um chamado de cobrança."),("Como falar com suporte","Entre na conta e abra um chamado; a conversa fica registrada aqui."),("Como gerenciar usuários","Administradores do cliente encontram a equipe em Administração."),("Como resolver acesso bloqueado","Use a recuperação de senha ou abra um chamado de Acesso.")}){<details><summary>@faq.Item1</summary><p>@faq.Item2</p></details>}</div></section>
<partial name="~/Views/Shared/Partials/_SupportContact.cshtml" model="Model.Contact" />
<footer class="support-company">MNSOFT · CNPJ 18.160.057/0001-13 · <a href="mailto:comercial@mnsoft.com.br">comercial@mnsoft.com.br</a></footer></main>
@section Styles {<link rel="stylesheet" href="~/css/support-v6193.css" asp-append-version="true" />}
