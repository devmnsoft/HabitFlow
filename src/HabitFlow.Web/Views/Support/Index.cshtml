@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Suporte"; }
<header class="hf-page-header"><div><p class="hf-eyebrow">Ajuda humana</p><h1>Suporte HabitFlow</h1><p>Estamos aqui para ajudar você a usar o HabitFlow com tranquilidade.</p></div>@await Html.PartialAsync("~/Views/Shared/Partials/Illustrations/_SupportIllustration.cshtml")</header>
@await Html.PartialAsync("~/Views/Shared/Partials/_QuickHelpCard.cshtml", null, new ViewDataDictionary(ViewData){{"Text","Abra um ticket quando precisar de ajuda."}})
<div class="row g-3"><div class="col-lg-5"><div class="hf-card mb-3"><h2>Central de ajuda</h2><p>Resolva dúvidas comuns em poucos minutos.</p><a class="btn btn-outline-success" href="/help">Abrir Central de Ajuda</a></div>@await Html.PartialAsync("~/Views/Shared/Partials/_SupportContactCard.cshtml")</div><div class="col-lg-7"><div class="hf-card"><h2>Abrir ticket</h2><form method="post" action="/support/create">@Html.AntiForgeryToken()<div class="mb-3"><label class="form-label" for="title">Assunto</label><input id="title" name="title" required maxlength="160" class="form-control"></div><div class="mb-3"><label class="form-label" for="description">Descrição</label><textarea id="description" name="description" required rows="5" class="form-control"></textarea></div><button class="btn btn-success">Enviar ticket</button></form></div></div><div class="col-12"><div class="hf-card"><h2>Status dos tickets</h2><p class="text-muted mb-0">Tickets abertos e atualizações aparecerão aqui com status claro: aberto, em análise ou resolvido.</p></div></div></div><section class="hf-section hf-premium-card"><h2>Confiança MNSOFT</h2><p>Conte com a MNSOFT para suporte comercial, operação, conta e solicitações LGPD. E-mail comercial: contato@mnsoft.com.br</p>@await Html.PartialAsync("~/Views/Shared/Partials/_MNSOFTSignature.cshtml")</section>
