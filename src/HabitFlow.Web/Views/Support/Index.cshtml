@model HabitFlow.Web.Models.SupportIndexViewModel
@{ViewData["Title"]="Central de suporte";}
<div class="assist-heading"><div><span class="assist-kicker">Suporte</span><h1>Central de suporte</h1><p>Encontre ajuda e acompanhe suas conversas com nossa equipe.</p></div>@if(Model.IsAuthenticated){<a class="btn btn-primary" href="/support/tickets/new">Novo chamado</a>}else{<a class="btn btn-primary" href="/login?returnUrl=%2Fsupport%2Ftickets%2Fnew">Entrar para abrir chamado</a>}</div>
@if(Model.IsAuthenticated){<section aria-labelledby="tickets-title"><h2 id="tickets-title" class="visually-hidden">Meus chamados</h2><div class="ticket-list">@foreach(var t in Model.Tickets){<a class="ticket-card" href="/support/tickets/@t.Id"><div><small>@t.Protocol · @t.Category</small><h2>@t.Subject</h2><p>Atualizado em @t.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p></div><span class="ticket-status @t.Status.ToLowerInvariant()">@t.Status</span></a>}@if(Model.Tickets.Count==0){<div class="assist-empty"><h2>Nenhum chamado</h2><p>Quando precisar, nossa equipe está por aqui.</p></div>}</div></section>}else{<section class="assist-empty" aria-labelledby="public-support-title"><h2 id="public-support-title">Como podemos ajudar?</h2><p>Consulte respostas rápidas na Central de Ajuda ou entre na sua conta para abrir e acompanhar um chamado seguro.</p><div class="d-flex gap-2 justify-content-center flex-wrap"><a class="btn btn-outline-primary" href="/help">Consultar Central de Ajuda</a><a class="btn btn-primary" href="/login?returnUrl=%2Fsupport">Ver meus chamados</a></div></section>}
<partial name="~/Views/Shared/Partials/_SupportContact.cshtml" model="Model.Contact" />

@section Styles {
    <link rel="stylesheet" href="~/css/assistance-v6169.css" asp-append-version="true" />
}
