@model HabitFlow.Web.Models.TicketDetailViewModel
@{ViewData["Title"]=Model.Ticket.Subject;}
<a href="/support/tickets">← Voltar aos chamados</a><section class="ticket-detail"><header><div><small>@Model.Ticket.Protocol · @Model.Ticket.Category</small><h1>@Model.Ticket.Subject</h1></div><span class="ticket-status @Model.Ticket.Status.ToLowerInvariant()">@Model.Ticket.Status</span></header><div class="ticket-message user"><strong>Você</strong><p>@Model.Ticket.Description</p><time>@Model.Ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time></div>@foreach(var m in Model.Messages){<div class="ticket-message @(m.IsStaff?"staff":"user")"><strong>@(m.IsStaff?"Equipe HabitFlow":"Você")</strong><p>@m.Message</p><time>@m.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time></div>}@if(Model.Ticket.Status!="Closed"){<form method="post" action="/support/tickets/@Model.Ticket.Id/reply">@Html.AntiForgeryToken()<label>Responder<textarea name="message" maxlength="2000" required></textarea></label><button class="btn btn-primary">Enviar resposta</button></form><form method="post" action="/support/tickets/@Model.Ticket.Id/close">@Html.AntiForgeryToken()<button class="btn btn-outline-danger">Encerrar chamado</button></form>}</section>@section Styles{<link rel="stylesheet" href="~/css/assistance-v6169.css" asp-append-version="true">}
